<%- include('partials/header') %>

<%
    // Current month settings
    const activeMonthNum = locals.activeMonthNum !== undefined ? locals.activeMonthNum : (new Date().getMonth() + 1);
    const activeYear = locals.activeYear !== undefined ? locals.activeYear : new Date().getFullYear();
    const monthsList = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const activeMonthName = monthsList[activeMonthNum - 1];

    // Compute simple view statistics
    let totalExpected = 0;
    let totalCollected = 0;
    let totalMonthlyRecovered = 0;
    let totalArrearsRecovered = 0;
    let totalPreviousOutstanding = 0;
    let totalAmountDue = 0;
    let paidCount = 0;
    let defaulterCount = 0;

    const tenantStartMonth = (locals.tenant && locals.tenant.fee_start_month && Number(locals.tenant.fee_start_month) >= 1) ? Number(locals.tenant.fee_start_month) : 1;

    students.forEach(s => {
        const expectedFee = (parseFloat(s.default_monthly_fee || 0) - parseFloat(s.custom_monthly_fee || 0));
        
        // Calculate dynamic previous arrears / advance from earlier months in the billing period
        let dynamicPrevArrears = 0;
        let dynamicAdvance = 0;
        for (let m = tenantStartMonth; m < activeMonthNum; m++) {
            const paidForM = (paymentMap[s.id] && paymentMap[s.id][m]) ? parseFloat(paymentMap[s.id][m].amount_paid || 0) : 0;
            if (paidForM < expectedFee) {
                dynamicPrevArrears += (expectedFee - paidForM);
            } else if (paidForM > expectedFee) {
                dynamicAdvance += (paidForM - expectedFee);
            }
        }
        const prevArrears = Math.max(0, dynamicPrevArrears - dynamicAdvance);
        
        totalExpected += expectedFee;
        totalPreviousOutstanding += prevArrears;
        
        const payObj = paymentMap[s.id] && paymentMap[s.id][activeMonthNum];
        const paidAmount = (payObj && payObj.amount_paid > 0) ? parseFloat(payObj.amount_paid) : 0;
        
        const curMonthRecovered = Math.min(paidAmount, expectedFee);
        const arrRecovered = Math.max(0, paidAmount - expectedFee);
        
        totalCollected += paidAmount;
        totalMonthlyRecovered += curMonthRecovered;
        totalArrearsRecovered += arrRecovered;
        
        const remainingCurMonth = Math.max(0, expectedFee - paidAmount);
        const remainingArrears = Math.max(0, prevArrears - arrRecovered);
        const netStudentDue = remainingCurMonth + remainingArrears;
        totalAmountDue += netStudentDue;
        
        const isFullWaiver = expectedFee <= 0 && parseFloat(s.default_monthly_fee || 0) > 0;
        if (paidAmount >= expectedFee || isFullWaiver) {
            paidCount++;
        } else {
            defaulterCount++;
        }
    });

    // Grouping for Class Summary
    const classGroups = {};
    classes.forEach(c => {
        classGroups[c.id] = {
            id: c.id,
            name: c.name,
            totalStudents: 0,
            paidCount: 0,
            totalExpected: 0,
            totalCollected: 0,
            totalMonthlyRecovered: 0,
            totalArrearsRecovered: 0,
            totalPreviousOutstanding: 0,
            totalAmountDue: 0,
            students: []
        };
    });
    // Unassigned group
    classGroups['unassigned'] = {
        id: 'unassigned',
        name: 'Unassigned',
        totalStudents: 0,
        paidCount: 0,
        totalExpected: 0,
        totalCollected: 0,
        totalMonthlyRecovered: 0,
        totalArrearsRecovered: 0,
        totalPreviousOutstanding: 0,
        totalAmountDue: 0,
        students: []
    };

    students.forEach(s => {
        const cId = s.class_id || 'unassigned';
        if (!classGroups[cId]) {
            classGroups[cId] = {
                id: cId,
                name: s.class_name || 'Unknown',
                totalStudents: 0,
                paidCount: 0,
                totalExpected: 0,
                totalCollected: 0,
                totalMonthlyRecovered: 0,
                totalArrearsRecovered: 0,
                totalPreviousOutstanding: 0,
                totalAmountDue: 0,
                students: []
            };
        }
        
        const expectedFee = (parseFloat(s.default_monthly_fee || 0) - parseFloat(s.custom_monthly_fee || 0));
        
        let dynamicPrevArrears = 0;
        let dynamicAdvance = 0;
        for (let m = tenantStartMonth; m < activeMonthNum; m++) {
            const paidForM = (paymentMap[s.id] && paymentMap[s.id][m]) ? parseFloat(paymentMap[s.id][m].amount_paid || 0) : 0;
            if (paidForM < expectedFee) {
                dynamicPrevArrears += (expectedFee - paidForM);
            } else if (paidForM > expectedFee) {
                dynamicAdvance += (paidForM - expectedFee);
            }
        }
        const prevArrears = Math.max(0, dynamicPrevArrears - dynamicAdvance);
        
        const payObj = paymentMap[s.id] && paymentMap[s.id][activeMonthNum];
        const paidAmount = (payObj && payObj.amount_paid > 0) ? parseFloat(payObj.amount_paid) : 0;
        const madePayment = paidAmount > 0;
        
        const curMonthRecovered = Math.min(paidAmount, expectedFee);
        const arrRecovered = Math.max(0, paidAmount - expectedFee);
        
        const remainingCurMonth = Math.max(0, expectedFee - paidAmount);
        const remainingArrears = Math.max(0, prevArrears - arrRecovered);
        const netStudentDue = remainingCurMonth + remainingArrears;
        
        const isFullWaiver = expectedFee <= 0 && parseFloat(s.default_monthly_fee || 0) > 0;
        const isPaid = (paidAmount >= expectedFee) || isFullWaiver;
        
        classGroups[cId].totalStudents++;
        classGroups[cId].totalExpected += expectedFee;
        classGroups[cId].totalCollected += paidAmount;
        classGroups[cId].totalMonthlyRecovered += curMonthRecovered;
        classGroups[cId].totalArrearsRecovered += arrRecovered;
        classGroups[cId].totalPreviousOutstanding += prevArrears;
        classGroups[cId].totalAmountDue += netStudentDue;

        if (isPaid) {
            classGroups[cId].paidCount++;
        }
        
        classGroups[cId].students.push({
            ...s,
            isPaid,
            isFullWaiver,
            madePayment,
            payObj,
            paidAmount,
            expectedFee,
            prevArrears,
            curMonthRecovered,
            arrRecovered,
            remainingCurMonth,
            remainingArrears,
            netStudentDue
        });
    });

    // Sort students within each group: unpaid first, then paid
    Object.values(classGroups).forEach(group => {
        group.students.sort((a, b) => {
            if (a.isPaid === b.isPaid) return 0;
            return a.isPaid ? 1 : -1; // Unpaid (-1) comes before Paid (1)
        });
    });
    
    // Find Nursery class ID if exists
    let nurseryClassId = null;
    const nurseryClass = classes.find(c => c.name.toLowerCase().includes('nursery'));
    if (nurseryClass) {
        nurseryClassId = nurseryClass.id.toString();
    }
%>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title" style="margin: 0;"><i class="bi bi-cash-coin"></i> Fee Ledger & Management</h1>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <button type="button" class="btn-primary" onclick="openClassChallanModal('<%= locals.classId || (classes[0] ? classes[0].id : '') %>')" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem;">
            <i class="bi bi-printer-fill"></i> Print Class Challans (PDF)
        </button>
    </div>
</div>

<form action="/fees/ledger" method="GET" class="filter-bar">
    <div class="form-group">
        <label for="classId">Filter by Class</label>
        <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
            <option value="">All Classes</option>
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= (locals.classId && locals.classId == c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="month">Month</label>
        <select name="month" id="month" class="form-control" onchange="this.form.submit()">
            <% monthsList.forEach((mName, idx) => { %>
                <option value="<%= idx + 1 %>" <%= activeMonthNum === (idx + 1) ? 'selected' : '' %>><%= mName %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="year">Year</label>
        <select name="year" id="year" class="form-control" onchange="this.form.submit()">
            <% const currY = new Date().getFullYear(); for(let y = 2024; y <= currY; y++) { %>
                <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
            <% } %>
        </select>
    </div>
    <div class="form-group" style="flex: 2;">
        <label for="search">Search</label>
        <div style="display: flex; gap: 0.5rem;">
            <input type="text" name="search" id="search" class="form-control" placeholder="Name/RegNo..." value="<%= locals.search || '' %>">
            <button type="submit" class="btn-primary" style="white-space: nowrap;"><i class="bi bi-search"></i> Search</button>
            <a href="/fees/ledger" class="btn-secondary" style="display: inline-flex; align-items: center; white-space: nowrap;">Reset</a>
        </div>
    </div>
    <input type="hidden" name="view" id="filter-view-input" value="class">
</form>

<!-- Quick Statistics Grid (Always visible) -->
<div class="kpi-grid" style="margin-bottom: 1.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem;">
    <!-- Tile 1: Current Month Tuition Fee Collection -->
    <div class="card kpi-card" style="padding: 1rem 1.1rem; border-left: 4px solid #3b82f6;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <span class="kpi-label" style="font-weight: 700; color: #1e293b;"><i class="bi bi-calendar-check" style="color: #3b82f6;"></i> Current Month Fee</span>
            <span style="background: #eff6ff; color: #2563eb; font-weight: 700; font-size: 0.75rem; padding: 2px 7px; border-radius: 9999px;">
                <%= totalExpected > 0 ? Math.min(100, Math.round((totalMonthlyRecovered / totalExpected) * 100)) : 0 %>%
            </span>
        </div>
        <span class="kpi-value" style="font-size: 1.35rem; font-weight: 800; color: #1e293b;">
            PKR <%= totalMonthlyRecovered.toLocaleString() %> <span style="font-size: 0.9rem; font-weight: 600; color: #64748b;">/ <%= totalExpected.toLocaleString() %></span>
        </span>
        <div style="width: 100%; background: #e2e8f0; height: 6px; border-radius: 9999px; margin-top: 0.4rem; margin-bottom: 0.3rem; overflow: hidden;">
            <div style="width: <%= totalExpected > 0 ? Math.min(100, Math.round((totalMonthlyRecovered / totalExpected) * 100)) : 0 %>%; background: #3b82f6; height: 100%;"></div>
        </div>
        <span class="kpi-subtitle" style="font-size: 0.78rem; color: #64748b;">Tuition fee recovered for <%= activeMonthName %></span>
    </div>

    <!-- Tile 2: Previous Arrears Recovered -->
    <div class="card kpi-card" style="padding: 1rem 1.1rem; border-left: 4px solid #10b981;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <span class="kpi-label" style="font-weight: 700; color: #1e293b;"><i class="bi bi-arrow-repeat" style="color: #10b981;"></i> Arrears Recovered</span>
            <% if (totalPreviousOutstanding > 0) { %>
                <span style="background: #ecfdf5; color: #059669; font-weight: 700; font-size: 0.75rem; padding: 2px 7px; border-radius: 9999px;">
                    <%= Math.round((totalArrearsRecovered / totalPreviousOutstanding) * 100) %>% rec.
                </span>
            <% } %>
        </div>
        <span class="kpi-value" style="font-size: 1.35rem; font-weight: 800; color: #10b981;">
            PKR <%= totalArrearsRecovered.toLocaleString() %>
        </span>
        <span class="kpi-subtitle" style="font-size: 0.78rem; color: #64748b; margin-top: 0.4rem; display: block;">
            Out of PKR <%= totalPreviousOutstanding.toLocaleString() %> previous balance
        </span>
    </div>

    <!-- Tile 3: Total Amount Due on Students -->
    <div class="card kpi-card" style="padding: 1rem 1.1rem; border-left: 4px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <span class="kpi-label" style="font-weight: 700; color: #1e293b;"><i class="bi bi-exclamation-circle" style="color: #f59e0b;"></i> Total Amount Due</span>
        </div>
        <span class="kpi-value" style="font-size: 1.35rem; font-weight: 800; color: #d97706;">
            PKR <%= totalAmountDue.toLocaleString() %>
        </span>
        <span class="kpi-subtitle" style="font-size: 0.78rem; color: #64748b; margin-top: 0.4rem; display: block;">
            Unpaid fee (<%= defaulterCount %> defaulters) + remaining arrears
        </span>
    </div>

    <!-- Tile 4: Total Cash Collected -->
    <div class="card kpi-card" style="padding: 1rem 1.1rem; border-left: 4px solid #8b5cf6;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <span class="kpi-label" style="font-weight: 700; color: #1e293b;"><i class="bi bi-cash-stack" style="color: #8b5cf6;"></i> Total Inflow</span>
        </div>
        <span class="kpi-value" style="font-size: 1.35rem; font-weight: 800; color: #7c3aed;">
            PKR <%= totalCollected.toLocaleString() %>
        </span>
        <span class="kpi-subtitle" style="font-size: 0.78rem; color: #64748b; margin-top: 0.4rem; display: block;">
            Fee PKR <%= totalMonthlyRecovered.toLocaleString() %> + Arrears PKR <%= totalArrearsRecovered.toLocaleString() %>
        </span>
    </div>

    <!-- Tile 5: Paid Students -->
    <div class="card kpi-card" style="padding: 1rem 1.1rem; border-left: 4px solid #16a34a; cursor: pointer;" onclick="filterByStatus('paid')">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <span class="kpi-label" style="font-weight: 700; color: #1e293b;"><i class="bi bi-people" style="color: #16a34a;"></i> Paid Students</span>
        </div>
        <span class="kpi-value" style="font-size: 1.35rem; font-weight: 800; color: #16a34a;"><%= paidCount %> / <%= students.length %></span>
        <span class="kpi-subtitle" style="font-size: 0.78rem; color: #64748b; margin-top: 0.4rem; display: block;">
            <%= defaulterCount %> awaiting payment
        </span>
    </div>
</div>

<!-- View Toggles (Tabs) -->
<div class="nav-tabs" style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; flex-wrap: wrap;">
    <button class="nav-tab active" id="tab-class-btn" onclick="switchTab('class')"><i class="bi bi-diagram-3-fill"></i> Monthly Class Summary (<%= activeMonthName %>)</button>
    <button class="nav-tab" id="tab-recent-btn" onclick="switchTab('recent')"><i class="bi bi-clock-history"></i> Monthly Fee Recent Activity</button>
    <button class="nav-tab" id="tab-matrix-btn" onclick="switchTab('matrix')"><i class="bi bi-grid-3x3-gap-fill"></i> Full Year Matrix</button>
    <button class="nav-tab" id="tab-cashflow-btn" onclick="switchTab('cashflow')"><i class="bi bi-cash-coin"></i> Cash Inflow (<%= activeMonthName %>)</button>
</div>

<!-- Tab: Recent Activity Pane -->
<div id="pane-recent" style="display: none;">
    <div style="display: flex; flex-direction: column; gap: 2rem;">
        <!-- Top: Recent Collections -->
        <div>
            <h3 style="margin-bottom: 1rem; color: var(--ink);"><i class="bi bi-clock-history"></i> Recent Fee Collections</h3>
            <div style="margin-bottom: 1rem; color: var(--muted); font-weight: 500;">
                Showing the last 10 fee payments collected.
            </div>
    <div class="table-container">
        <table class="simple-ledger-table">
            <thead>
                <tr>
                    <th style="text-align: left;">Date</th>
                    <th style="text-align: left;">Reg No</th>
                    <th style="text-align: left;">Student Name</th>
                    <th style="text-align: left;">Class</th>
                    <th style="text-align: left;">Month</th>
                    <th style="text-align: right;">Amount Paid</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (locals.recentPayments && recentPayments.length > 0) { %>
                    <% recentPayments.forEach(rp => { %>
                        <tr class="student-row status-row-paid">
                            <td style="font-weight: 500; text-align: left;"><%= new Date(rp.payment_date).toLocaleDateString('en-GB') %></td>
                            <td style="font-weight: 600; text-align: left;"><%= rp.reg_no %></td>
                            <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= rp.student_id %>" style="color: var(--primary-color); text-decoration: underline;"><%= rp.student_name %></a></td>
                            <td style="text-align: left;"><%= rp.class_name || 'Unassigned' %></td>
                            <td style="text-align: left;"><%= monthsList[rp.month - 1] %> <%= rp.year %></td>
                            <td style="text-align: right; font-weight: 600; color: #16a34a;">PKR <%= parseFloat(rp.amount_paid).toLocaleString() %></td>
                            <td style="text-align: center;">
                                <a href="/fees/receipt/<%= rp.id %>" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: #64748b; padding: 2rem;">No recent payments found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <% if (locals.recentPayments && recentPayments.length === 10) { %>
            <div style="text-align: center; margin-top: 1rem; margin-bottom: 0.5rem;">
                <button id="btn-load-more-recent" class="btn-secondary" onclick="loadMoreRecent()" style="width: 100%; max-width: 300px; padding: 0.5rem;"><i class="bi bi-arrow-down-circle"></i> Load 10 More</button>
            </div>
        <% } %>
    </div>
</div>
        
        <!-- Bottom: Top Defaulters -->
        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 style="color: var(--ink); margin: 0;"><i class="bi bi-exclamation-triangle-fill" style="color: #dc2626;"></i> Year-to-Date Top Defaulters</h3>
            </div>
            <div style="margin-bottom: 1rem; color: var(--muted); font-weight: 500;">
                Students with the highest accrued unpaid balances for <%= activeYear %> across all classes.
            </div>
            <div class="table-container">
                <table class="simple-ledger-table" id="defaulters-table">
                    <thead>
                        <tr>
                            <th style="text-align: left;">Reg No</th>
                            <th style="text-align: left;">Student Name</th>
                            <th style="text-align: left;">Class</th>
                            <th style="text-align: right;">Total Due</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.topDefaulters && topDefaulters.length > 0) { %>
                            <% topDefaulters.forEach(s => { %>
                                <tr class="student-row status-row-unpaid">
                                    <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                                    <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= s.id %>" style="color: var(--primary-color); text-decoration: underline;"><%= s.name %></a></td>
                                    <td style="text-align: left;"><%= s.class_name %></td>
                                    <td style="text-align: right; font-weight: 600; color: #dc2626;">PKR <%= s.due.toLocaleString() %></td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn-primary nav-btn" style="padding: 0.3rem 0.5rem; font-size: 0.8rem;" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, '', <%= s.expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-credit-card-fill"></i> Collect</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; color: #16a34a; padding: 2rem;"><i class="bi bi-check-circle-fill"></i> No defaulters found!</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
                <% if (locals.topDefaulters && topDefaulters.length === 10) { %>
                    <div style="text-align: center; margin-top: 1rem; margin-bottom: 0.5rem;">
                        <button id="btn-load-more-defaulters" class="btn-secondary" onclick="loadMoreDefaulters()" style="width: 100%; max-width: 300px; padding: 0.5rem;"><i class="bi bi-arrow-down-circle"></i> Load 10 More</button>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Tab: Cash Inflow Pane -->
<div id="pane-cashflow" style="display: none;">
    <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="color: var(--ink); margin: 0;"><i class="bi bi-cash-coin" style="color: #16a34a;"></i> Cash Inflow Transactions (<%= activeMonthName %>)</h3>
            <% 
                let totalCashflow = 0;
                if (locals.cashflowTransactions) {
                    locals.cashflowTransactions.forEach(t => totalCashflow += parseFloat(t.amount_paid));
                }
            %>
            <div style="background-color: #dcfce7; color: #16a34a; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 700; font-size: 1.1rem;">
                Total: PKR <%= totalCashflow.toLocaleString() %>
            </div>
        </div>
        <div style="margin-bottom: 1rem; color: var(--muted); font-weight: 500;">
            All payments physically collected in <%= activeMonthName %> <%= activeYear %>, including arrears, advances, and custom fees.
        </div>
        <div class="table-container">
            <table class="simple-ledger-table">
                <thead>
                    <tr>
                        <th style="text-align: left;">Date</th>
                        <th style="text-align: left;">Reg No</th>
                        <th style="text-align: left;">Student Name</th>
                        <th style="text-align: left;">Class</th>
                        <th style="text-align: left;">Fee Type</th>
                        <th style="text-align: right;">Amount Paid</th>
                        <th style="text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (locals.cashflowTransactions && cashflowTransactions.length > 0) { %>
                        <% cashflowTransactions.forEach(t => { %>
                            <tr class="student-row status-row-paid">
                                <td style="font-weight: 500; text-align: left;"><%= new Date(t.payment_date).toLocaleDateString('en-GB') %></td>
                                <td style="font-weight: 600; text-align: left;"><%= t.reg_no %></td>
                                <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= t.student_id %>" style="color: var(--primary-color); text-decoration: underline;"><%= t.student_name %></a></td>
                                <td style="text-align: left;"><%= t.class_name || 'Unassigned' %></td>
                                <td style="text-align: left;">
                                    <% if (t.month === 0) { %>
                                        <span style="color: #0284c7; font-weight: 500;">Admission Fee</span>
                                    <% } else if (t.month >= 13) { %>
                                        <span style="color: #059669; font-weight: 500;"><%= t.additional_fee_description || 'Other Fee' %></span>
                                    <% } else { %>
                                        <span style="font-weight: 500;">Monthly Fee (<%= monthsList[t.month - 1] %> <%= t.year %>)</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right; font-weight: 600; color: #16a34a;">PKR <%= parseFloat(t.amount_paid).toLocaleString() %></td>
                                <td style="text-align: center;">
                                    <a href="/fees/receipt/<%= t.id %>" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; color: #64748b; padding: 2rem;">No cash inflow transactions for <%= activeMonthName %>.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tab: Class Summary Pane -->
<div id="pane-class">
    <!-- Filters Collapsible Panel -->
    <details class="filter-panel" <%= (classId || search || locals.activeMonthNum || locals.activeYear) ? 'open' : '' %>>
        <summary>
            <span><i class="bi bi-funnel-fill"></i> Filter & Search Fees</span>
            <i class="bi bi-chevron-down toggle-icon"></i>
        </summary>
        <form action="/fees/ledger" method="GET" class="filter-content">
            <input type="hidden" name="view" id="filter-view-input-class" value="class">
            <div class="form-group">
                <label for="classId">Class</label>
                <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
                    <option value="">-- All Classes --</option>
                    <% classes.forEach(c => { %>
                        <option value="<%= c.id %>" <%= classId == c.id ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="form-group">
                <label for="month">Month</label>
                <select name="month" id="month" class="form-control" onchange="this.form.submit()">
                    <% monthsList.forEach((mName, idx) => { %>
                        <option value="<%= idx + 1 %>" <%= activeMonthNum == (idx + 1) ? 'selected' : '' %>><%= mName %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="form-group">
                <label for="year">Year</label>
                <select name="year" id="year" class="form-control" onchange="this.form.submit()">
                    <% 
                        const currentY = new Date().getFullYear();
                        const yearsList = [];
                        for(let y = 2024; y <= currentY; y++) yearsList.push(y);
                        yearsList.forEach(y => { 
                    %>
                        <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="form-group">
                <label for="search">Search</label>
                <input type="text" name="search" id="search" class="form-control" value="<%= search || '' %>" placeholder="Search by name or Reg No...">
            </div>
            
            <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
                <button type="submit" class="btn-secondary" style="height: 38px;">Search</button>
                <a href="/fees/ledger" class="btn-secondary" style="height: 38px; display: inline-flex; align-items: center;">Reset</a>
            </div>
        </form>
    </details>
    <div style="margin-bottom: 1rem; color: var(--muted); font-weight: 500;">
        Students grouped by class. Defaulters (unpaid) are shown first.
    </div>

    <% Object.values(classGroups).forEach((group, index) => { %>
        <% if (group.id !== 'unassigned' && group.totalStudents > 0) { %>
            <% 
                // Determine if expanded
                let isExpanded = false;
                if (classId && classId == group.id) {
                    isExpanded = true;
                } else if (!classId) {
                    if (nurseryClassId && group.id == nurseryClassId) {
                        isExpanded = true;
                    } else if (!nurseryClassId && index === 0) {
                        isExpanded = true;
                    }
                }
            %>
            <details class="card" style="margin-bottom: 1rem;" <%= isExpanded ? 'open' : '' %>>
                <summary style="padding: 1rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background-color: #f8fafc; border-bottom: 1px solid var(--border);">
                    <div>
                        <strong style="font-size: 1.1rem;"><%= group.name %></strong>
                        <span style="margin-left: 1rem; font-size: 0.9rem; color: var(--muted);">
                            <i class="bi bi-people-fill"></i> <%= group.totalStudents %> Students
                        </span>
                    </div>
                    <div style="display: flex; gap: 1rem; align-items: center; font-size: 0.9rem; flex-wrap: wrap;">
                        <button type="button" class="btn-secondary nav-btn" onclick="event.stopPropagation(); openClassChallanModal('<%= group.id %>')" title="Print Fee Challans for <%= group.name %>" style="padding: 0.25rem 0.6rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem;">
                            <i class="bi bi-printer-fill"></i> Print Challans
                        </button>
                        <span style="<%= group.paidCount === group.totalStudents ? 'color: #16a34a;' : (group.paidCount === 0 ? 'color: #dc2626;' : 'color: #eab308;') %> font-weight: 600;">
                            Paid: <%= group.paidCount %> / <%= group.totalStudents %>
                        </span>
                        <span style="color: #2563eb; font-weight: 600;">
                            Fee: PKR <%= group.totalMonthlyRecovered.toLocaleString() %> / <%= group.totalExpected.toLocaleString() %>
                        </span>
                        <% if (group.totalArrearsRecovered > 0) { %>
                        <span style="color: #10b981; font-weight: 600;">
                            Arrears Rec.: PKR <%= group.totalArrearsRecovered.toLocaleString() %>
                        </span>
                        <% } %>
                        <span style="font-weight: 700; color: #1e293b;">
                            Total Inflow: PKR <%= group.totalCollected.toLocaleString() %>
                        </span>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </div>
                </summary>
                <div style="padding: 0;">
                    <table class="simple-ledger-table" style="margin: 0; border: none; box-shadow: none;">
                        <thead>
                            <tr>
                                <th style="text-align: left; padding-left: 1rem;">Reg No</th>
                                <th style="text-align: left;">Student Name</th>
                                <th style="text-align: right;">Monthly Fee</th>
                                <th style="text-align: right;">Amount Paid</th>
                                <th style="text-align: right;">Outstanding Dues</th>
                                <th>Status</th>
                                <th style="padding-right: 1rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% group.students.forEach(s => { %>
                                <tr class="student-row <%= s.isPaid ? 'status-row-paid' : 'status-row-unpaid' %>">
                                    <td style="font-weight: 600; text-align: left; padding-left: 1rem;"><%= s.reg_no %></td>
                                    <td style="text-align: left; font-weight: 500;">
                                        <a href="/students/view/<%= s.id %>" style="color: var(--primary-color); text-decoration: underline; cursor: pointer;"><%= s.name %></a>
                                        <% if (s.prevArrears > 0) { %>
                                            <div style="font-size: 0.75rem; color: #dc2626; font-weight: 600;"><i class="bi bi-clock-history"></i> Arrears: PKR <%= s.prevArrears.toLocaleString() %></div>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right; font-weight: 600;">PKR <%= s.expectedFee.toLocaleString() %></td>
                                    <td style="text-align: right; font-weight: 600; color: #16a34a;">
                                        <% if (s.madePayment) { %>
                                            PKR <%= s.paidAmount.toLocaleString() %>
                                            <% if (s.arrRecovered > 0) { %>
                                                <div style="font-size: 0.72rem; color: #059669; font-weight: 500;">
                                                    (Fee <%= s.curMonthRecovered.toLocaleString() %> + Arr <%= s.arrRecovered.toLocaleString() %>)
                                                </div>
                                            <% } %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td style="text-align: right; font-weight: 700; color: <%= s.netStudentDue > 0 ? '#dc2626' : '#16a34a' %>;">
                                        <% if (s.netStudentDue > 0) { %>
                                            PKR <%= s.netStudentDue.toLocaleString() %>
                                            <% if (s.remainingArrears > 0 && s.remainingCurMonth > 0) { %>
                                                <div style="font-size: 0.72rem; color: #991b1b; font-weight: 500;">
                                                    (Fee <%= s.remainingCurMonth.toLocaleString() %> + Arr <%= s.remainingArrears.toLocaleString() %>)
                                                </div>
                                            <% } %>
                                        <% } else { %>
                                            <span style="color: #16a34a; font-weight: 600;">Rs. 0</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (s.isFullWaiver && !s.madePayment) { %>
                                            <span class="status-cell status-paid" style="background-color: #f3f4f6; color: #4b5563;"><i class="bi bi-gift-fill"></i> FULL WAIVER</span>
                                        <% } else if (s.isPaid) { %>
                                            <span class="status-cell status-paid"><i class="bi bi-check-circle-fill"></i> PAID</span>
                                        <% } else { %>
                                            <span class="status-cell status-unpaid"><i class="bi bi-exclamation-triangle-fill"></i> DEFAULTER</span>
                                        <% } %>
                                    </td>
                                    <td style="padding-right: 1rem;">
                                        <div style="display: flex; gap: 0.4rem; justify-content: center;">
                                            <% if (s.madePayment) { %>
                                                <a href="/fees/receipt/<%= s.payObj.id %>" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                                                <button type="button" class="btn-secondary nav-btn" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, <%= s.payObj.amount_paid %>, <%= s.expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-pencil-fill"></i> Edit</button>
                                            <% } else if (s.isFullWaiver) { %>
                                                <button type="button" class="btn-secondary nav-btn" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, '', <%= s.expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-plus-circle"></i> Add Fee</button>
                                            <% } else { %>
                                                <button type="button" class="btn-primary nav-btn" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, '', <%= s.expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-credit-card-fill"></i> Collect</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </details>
        <% } %>
    <% }) %>
    <% if (Object.values(classGroups).every(group => group.id === 'unassigned' || group.totalStudents === 0)) { %>
        <div style="text-align: center; color: #64748b; padding: 3rem; background: #fff; border-radius: 8px; border: 1px solid var(--border);">
            <i class="bi bi-inbox" style="font-size: 2.5rem; color: var(--border); margin-bottom: 1rem; display: block;"></i>
            <h4>No Records Found</h4>
            <p>No students match your current filter and search criteria.</p>
        </div>
    <% } %>
</div>

<!-- Tab 1: Simple View Pane -->
<div id="pane-simple" style="display: none;">
    <!-- Quick Statistics Grid -->
    <div class="kpi-grid" style="margin-bottom: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <div class="card kpi-card" style="padding: 1rem; cursor: pointer;" onclick="filterByStatus('all')" title="Click to show all students">
            <span class="kpi-label">Month Collection Progress</span>
            <span class="kpi-value" style="font-size: 1.4rem;">PKR <%= totalCollected.toLocaleString() %> / <%= totalExpected.toLocaleString() %></span>
            <span class="kpi-subtitle">Progress Rate: <%= totalExpected > 0 ? Math.round((totalCollected / totalExpected) * 100) : 0 %>%</span>
        </div>
        <div class="card kpi-card" style="padding: 1rem; cursor: pointer;" onclick="filterByStatus('paid')" title="Click to show paid students only">
            <span class="kpi-label">Paid Students</span>
            <span class="kpi-value" style="font-size: 1.4rem; color: #16a34a;"><%= paidCount %> / <%= students.length %></span>
            <span class="kpi-subtitle">Received this month</span>
        </div>
        <div class="card kpi-card" style="padding: 1rem; cursor: pointer;" onclick="filterByStatus('unpaid')" title="Click to show defaulters only">
            <span class="kpi-label">Defaulters</span>
            <span class="kpi-value" style="font-size: 1.4rem; color: #dc2626;"><%= defaulterCount %></span>
            <span class="kpi-subtitle">Awaiting payment</span>
        </div>
    </div>

    <!-- Quick filter checkbox -->
    <div style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <input type="checkbox" id="show-defaulters-checkbox" onchange="toggleDefaultersOnly(this.checked)" style="width: 18px; height: 18px; cursor: pointer;">
            <label for="show-defaulters-checkbox" style="font-size: 0.9rem; font-weight: 600; cursor: pointer; color: var(--ink);">Show Defaulters Only</label>
        </div>
        <div style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">
            Showing <%= students.length %> students
        </div>
    </div>

    <!-- Simple Table -->
    <div class="table-container">
        <table class="simple-ledger-table">
            <thead>
                <tr>
                    <th style="text-align: left;">Reg No</th>
                    <th style="text-align: left;">Student Name</th>
                    <th style="text-align: left;">Class</th>
                    <th style="text-align: right;">Monthly Fee</th>
                    <th style="text-align: right;">Amount Paid</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (students.length > 0) { %>
                    <% students.forEach(s => { %>
                        <% 
                            const expectedFee = (parseFloat(s.default_monthly_fee || 0) - parseFloat(s.custom_monthly_fee || 0));
                            const payObj = paymentMap[s.id] && paymentMap[s.id][activeMonthNum];
                            const isPaid = payObj && payObj.amount_paid > 0;
                        %>
                        <tr class="student-row <%= isPaid ? 'status-row-paid' : 'status-row-unpaid' %>">
                            <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                            <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= s.id %>" style="color: var(--primary-color, #4f46e5); text-decoration: underline; cursor: pointer;"><%= s.name %></a></td>
                            <td style="text-align: left;"><%= s.class_name || 'Unassigned' %></td>
                            <td style="text-align: right; font-weight: 600;">PKR <%= expectedFee.toLocaleString() %></td>
                            <td style="text-align: right; font-weight: 600; color: #16a34a;">
                                <%= isPaid ? 'PKR ' + payObj.amount_paid.toLocaleString() : '-' %>
                            </td>
                            <td>
                                <% if (isPaid) { %>
                                    <span class="status-cell status-paid"><i class="bi bi-check-circle-fill"></i> PAID</span>
                                <% } else { %>
                                    <span class="status-cell status-unpaid"><i class="bi bi-exclamation-triangle-fill"></i> DEFAULTER</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.4rem; justify-content: center;">
                                    <% if (isPaid) { %>
                                        <a href="/fees/receipt/<%= payObj.id %>" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                                        <button type="button" class="btn-secondary nav-btn" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, <%= payObj.amount_paid %>, <%= expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-pencil-fill"></i> Edit</button>
                                    <% } else { %>
                                        <button type="button" class="btn-primary nav-btn" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= activeMonthNum %>, '', <%= expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)"><i class="bi bi-credit-card-fill"></i> Collect</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: #64748b; padding: 2rem;">No students found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Tab 2: Full Year Matrix Pane -->
<div id="pane-matrix" style="display: none;">
    <div class="table-container">
        <table class="simple-ledger-table matrix-table">
            <thead>
                <tr>
                    <th style="text-align: left;">Reg No</th>
                    <th style="text-align: left; min-width: 150px;">Student Name</th>
                    <th style="text-align: left;">Due Fee</th>
                    <th>Jan</th>
                    <th>Feb</th>
                    <th>Mar</th>
                    <th>Apr</th>
                    <th>May</th>
                    <th>Jun</th>
                    <th>Jul</th>
                    <th>Aug</th>
                    <th>Sep</th>
                    <th>Oct</th>
                    <th>Nov</th>
                    <th>Dec</th>
                </tr>
            </thead>
            <tbody>
                <% if (students.length > 0) { %>
                    <% students.forEach(s => { %>
                        <% 
                            const expectedFee = (parseFloat(s.default_monthly_fee || 0) - parseFloat(s.custom_monthly_fee || 0));
                            const studentPayments = paymentMap[s.id] || {};
                        %>
                        <tr>
                            <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                            <td style="text-align: left;"><a href="/students/view/<%= s.id %>" style="color: var(--primary-color, #4f46e5); text-decoration: underline; cursor: pointer;"><%= s.name %></a></td>
                            <td style="text-align: left; font-weight: 600; color: <%= s.has_concession ? '#b91c1c' : '#1e293b' %>">
                                <%= expectedFee.toLocaleString() %>
                            </td>
                            
                            <% for (let m = 1; m <= 12; m++) { %>
                                <% 
                                    const payObj = studentPayments[m];
                                    const amtPaid = payObj ? payObj.amount_paid : undefined;
                                %>
                                <% if (expectedFee <= 0 && parseFloat(s.default_monthly_fee || 0) > 0) { %>
                                    <td class="status-cell status-paid" style="background-color: #f3f4f6; color: #4b5563; font-weight: 600;">
                                        Waiver
                                    </td>
                                <% } else if (amtPaid !== undefined && amtPaid > 0) { %>
                                    <td class="status-cell status-paid cell-amount" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= m %>, <%= amtPaid %>, <%= expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)">
                                        <%= amtPaid %>
                                    </td>
                                  <% } else { %>
                                    <td class="status-cell status-unpaid" onclick="openPaymentModal('<%= s.id %>', '<%= s.name.replace(/'/g, "\\'") %>', <%= m %>, '', <%= expectedFee %>, <%= s.default_monthly_fee || 0 %>, <%= s.custom_monthly_fee || 0 %>)">
                                        -
                                    </td>
                                  <% } %>
                            <% } %>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="15" style="text-align: center; color: #64748b;">No students found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>



<!-- Monthly Payment Modal -->
<div id="paymentModal" class="card" style="display: none; max-width: 400px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 1rem;" id="modalTitle">Record Monthly Payment</h3>
    <form action="/fees/pay" method="POST">
        <input type="hidden" id="modalStudentId" name="student_id">
        
        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label for="modalMonth">For Month</label>
                <select id="modalMonth" name="month" class="form-control" onchange="updateModalFine()">
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                </select>
            </div>
            <div class="form-group">
                <label for="modalYear">For Year</label>
                <select id="modalYear" name="year" class="form-control" onchange="updateModalFine()">
                    <% 
                        const modalCurrY = new Date().getFullYear();
                        for(let y = 2024; y <= modalCurrY; y++) { 
                    %>
                        <option value="<%= y %>"><%= y %></option>
                    <% } %>
                </select>
            </div>
        </div>

        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 0.75rem; border-radius: 0.375rem; margin-bottom: 1.25rem; font-size: 0.85rem; line-height: 1.5;">
            <div style="display: flex; justify-content: space-between;">
                <span>Total Class Fee:</span>
                <strong id="modalClassFeeDisplay">PKR 0</strong>
            </div>
            <div style="display: flex; justify-content: space-between; color: #b91c1c;">
                <span>Concession Support:</span>
                <strong id="modalConcessionDisplay">PKR 0</strong>
            </div>
            <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 0.5rem 0;">
            <div style="display: flex; justify-content: space-between; font-size: 0.95rem;">
                <span>Monthly Fee to Collect:</span>
                <strong id="modalExpectedFeeDisplay" style="color: var(--primary-color);">PKR 0</strong>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="modalAmount">Amount Paid (PKR)</label>
            <input type="number" step="0.01" id="modalAmount" name="amount" class="form-control" required>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 500; color: #0369a1;" onclick="toggleAdditionalFeePanel()">
                <i class="bi bi-plus-circle" id="addFeeToggleIcon"></i> Include Additional Fee (Exam, Fine, etc.)
            </label>
        </div>
        
        <div id="additionalFeePanel" style="display: none; background-color: #f0fdf4; border: 1px solid #bbf7d0; padding: 1rem; border-radius: 0.375rem; margin-bottom: 1.25rem;">
            <div class="form-group" style="margin-bottom: 0.75rem;">
                <label>Additional Fee Type</label>
                <select name="additional_fee_type" id="modalAddFeeType" class="form-control" onchange="toggleAddFeeDesc()">
                    <option value="">-- Select --</option>
                    <optgroup label="Active Campaigns">
                        <% if (locals.activeCampaigns && locals.activeCampaigns.length > 0) { %>
                            <% locals.activeCampaigns.forEach(c => { %>
                                <option value="campaign_<%= c.id %>" data-amount="<%= c.default_amount %>" data-title="<%= c.title %>"><%= c.title %></option>
                            <% }) %>
                        <% } else { %>
                            <option disabled>No active campaigns</option>
                        <% } %>
                    </optgroup>
                    <optgroup label="Standard Fees">
                        <option value="Fine">Fine (Manual)</option>
                        <option value="Custom">Custom / Other</option>
                    </optgroup>
                </select>
            </div>
            <div class="form-group" id="modalAddFeeDescGroup" style="display: none; margin-bottom: 0.75rem;">
                <label>Description</label>
                <input type="text" name="additional_fee_description" id="modalAddFeeDesc" class="form-control" placeholder="Specify detail">
                <input type="hidden" name="campaign_id" id="modalCampaignId">
            </div>
            <div class="form-group">
                <label>Additional Amount (PKR)</label>
                <input type="number" step="0.01" name="additional_fee" id="modalAddFeeAmount" class="form-control" value="0">
            </div>
        </div>
        
        <div class="form-group" style="margin-bottom: 0.75rem;">
            <label for="modalFine">Late Fee Fine (PKR)</label>
            <input type="number" step="0.01" id="modalFine" name="fine_amount" class="form-control" value="0">
        </div>
        
        <div class="form-checkbox" style="margin-bottom: 1.25rem; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 0.5rem;">
            <input type="checkbox" id="modalFineWaived" name="fine_waived" value="1" onchange="toggleWaive(this.checked)" style="width: 18px; height: 18px; cursor: pointer; margin: 0;">
            <label for="modalFineWaived" style="margin-bottom: 0; cursor: pointer; font-weight: 500;">Waive Late Fee Fine</label>
        </div>
        
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn-primary">Save Monthly Fee</button>
        </div>
    </form>
</div>

<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeModal();"></div>

<script>
    const clientClassGroups = <%- JSON.stringify(classGroups) %>;
    const clientActiveMonthNum = <%= activeMonthNum %>;

    let recentOffset = 10;
    let defaultersOffset = 10;

    async function loadMoreRecent() {
        const btn = document.getElementById('btn-load-more-recent');
        if(!btn) return;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Loading...';
        btn.disabled = true;

        try {
            const res = await fetch(`/fees/api/recent?offset=${recentOffset}`);
            const json = await res.json();
            if (json.success) {
                const tbody = document.querySelector('#pane-recent .table-container table tbody');
                let html = '';
                json.data.forEach(rp => {
                    const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
                    const dateStr = new Date(rp.payment_date).toLocaleDateString('en-GB');
                    html += `
                        <tr class="student-row status-row-paid">
                            <td style="font-weight: 500; text-align: left;">${dateStr}</td>
                            <td style="font-weight: 600; text-align: left;">${rp.reg_no}</td>
                            <td style="text-align: left; font-weight: 500;"><a href="/students/view/${rp.student_id}" style="color: var(--primary-color); text-decoration: underline;">${rp.student_name}</a></td>
                            <td style="text-align: left;">${rp.class_name || 'Unassigned'}</td>
                            <td style="text-align: left;">${months[rp.month - 1]} ${rp.year}</td>
                            <td style="text-align: right; font-weight: 600; color: #16a34a;">PKR ${parseFloat(rp.amount_paid).toLocaleString()}</td>
                            <td style="text-align: center;">
                                <a href="/fees/receipt/${rp.id}" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                            </td>
                        </tr>
                    `;
                });
                tbody.insertAdjacentHTML('beforeend', html);
                recentOffset += json.data.length;

                if (json.data.length < 10) {
                    btn.parentElement.style.display = 'none';
                }
            }
        } catch (e) {
            console.error(e);
            alert('Failed to load more recent payments.');
        } finally {
            btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Load 10 More';
            btn.disabled = false;
        }
    }

    async function loadMoreDefaulters() {
        const btn = document.getElementById('btn-load-more-defaulters');
        if(!btn) return;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Loading...';
        btn.disabled = true;

        try {
            const activeYear = <%= activeYear %>;
            const res = await fetch(`/fees/api/defaulters?offset=${defaultersOffset}&year=${activeYear}`);
            const json = await res.json();
            if (json.success) {
                const tbody = document.querySelector('#defaulters-table tbody');
                let html = '';
                json.data.forEach(s => {
                    const safeName = s.name.replace(/'/g, "\\'");
                    html += `
                        <tr class="student-row status-row-unpaid">
                            <td style="font-weight: 600; text-align: left;">${s.reg_no}</td>
                            <td style="text-align: left; font-weight: 500;"><a href="/students/view/${s.id}" style="color: var(--primary-color); text-decoration: underline;">${s.name}</a></td>
                            <td style="text-align: left;">${s.class_name}</td>
                            <td style="text-align: right; font-weight: 600; color: #dc2626;">PKR ${s.due.toLocaleString()}</td>
                            <td style="text-align: center;">
                                <button type="button" class="btn-primary nav-btn" style="padding: 0.3rem 0.5rem; font-size: 0.8rem;" onclick="openPaymentModal('${s.id}', '${safeName}', <%= activeMonthNum %>, '', ${s.expectedFee}, ${s.default_monthly_fee || 0}, ${s.custom_monthly_fee || 0})"><i class="bi bi-credit-card-fill"></i> Collect</button>
                            </td>
                        </tr>
                    `;
                });
                tbody.insertAdjacentHTML('beforeend', html);
                defaultersOffset += json.data.length;

                if (json.data.length < 10) {
                    btn.parentElement.style.display = 'none';
                }
            }
        } catch (e) {
            console.error(e);
            alert('Failed to load more defaulters.');
        } finally {
            btn.innerHTML = '<i class="bi bi-arrow-down-circle"></i> Load 10 More';
            btn.disabled = false;
        }
    }

    const clientPaymentMap = <%- JSON.stringify(paymentMap || {}) %>;

    function toggleAdditionalFeePanel() {
        const panel = document.getElementById('additionalFeePanel');
        const icon = document.getElementById('addFeeToggleIcon');
        if (panel.style.display === 'none') {
            panel.style.display = 'block';
            icon.classList.remove('bi-plus-circle');
            icon.classList.add('bi-dash-circle');
        } else {
            panel.style.display = 'none';
            icon.classList.remove('bi-dash-circle');
            icon.classList.add('bi-plus-circle');
            // reset fields
            document.getElementById('modalAddFeeType').value = '';
            document.getElementById('modalAddFeeDesc').value = '';
            document.getElementById('modalAddFeeAmount').value = '0';
            document.getElementById('modalCampaignId').value = '';
            toggleAddFeeDesc();
        }
    }

    function toggleAddFeeDesc() {
        const typeSelect = document.getElementById('modalAddFeeType');
        const type = typeSelect.value;
        const descGroup = document.getElementById('modalAddFeeDescGroup');
        const descInput = document.getElementById('modalAddFeeDesc');
        const campaignIdInput = document.getElementById('modalCampaignId');
        
        campaignIdInput.value = ''; // Reset
        
        if (type.startsWith('campaign_')) {
            const selectedOption = typeSelect.options[typeSelect.selectedIndex];
            campaignIdInput.value = type.split('_')[1];
            descInput.value = selectedOption.getAttribute('data-title');
            descInput.required = false;
            descGroup.style.display = 'none';
            document.getElementById('modalAddFeeAmount').value = selectedOption.getAttribute('data-amount');
        } else if (type === 'Custom' || type === 'Fine') {
            descGroup.style.display = 'block';
            descInput.required = true;
            descInput.value = '';
        } else if (type) {
            descGroup.style.display = 'none';
            descInput.required = false;
            descInput.value = type;
        } else {
            descGroup.style.display = 'none';
            descInput.required = false;
            descInput.value = '';
        }
    }

    function openPaymentModal(studentId, studentName, month, currentAmount, expectedFee, classFee, concession) {
        const currentYear = new Date().getFullYear();
        document.getElementById('modalStudentId').value = studentId;
        document.getElementById('modalMonth').value = month;
        document.getElementById('modalAmount').value = currentAmount || expectedFee;
        document.getElementById('modalTitle').innerText = 'Pay Monthly Fee: ' + studentName;
        
        document.getElementById('modalClassFeeDisplay').innerText = 'PKR ' + parseFloat(classFee || 0).toLocaleString();
        document.getElementById('modalConcessionDisplay').innerText = 'PKR ' + parseFloat(concession || 0).toLocaleString();
        document.getElementById('modalExpectedFeeDisplay').innerText = 'PKR ' + parseFloat(expectedFee || 0).toLocaleString();

        const selectedYear = document.getElementById('year') ? parseInt(document.getElementById('year').value) : currentYear;
        document.getElementById('modalYear').value = selectedYear;

        // Reset additional fee panel
        document.getElementById('additionalFeePanel').style.display = 'none';
        document.getElementById('addFeeToggleIcon').classList.add('bi-plus-circle');
        document.getElementById('addFeeToggleIcon').classList.remove('bi-dash-circle');
        document.getElementById('modalAddFeeType').value = '';
        document.getElementById('modalAddFeeAmount').value = '0';
        document.getElementById('modalCampaignId').value = '';
        toggleAddFeeDesc();

        const monthSelect = document.getElementById('modalMonth');
        const studentPayments = clientPaymentMap[studentId] || {};
        
        const allMonths = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        
        monthSelect.innerHTML = ''; // Clear existing
        let addedCurrent = false;

        allMonths.forEach((name, i) => {
            const m = i + 1;
            const isPaid = studentPayments[m] && studentPayments[m].amount_paid > 0;
            const isBeingEdited = (isPaid && currentAmount !== '' && m == month);
            
            // Hide if this month is already paid, UNLESS we are editing that specific month's payment
            if (isPaid && !isBeingEdited) {
                // skip adding
            } else {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = name;
                monthSelect.appendChild(opt);
                if (m == month) addedCurrent = true;
            }
        });

        // Ensure the selected month is valid
        if (addedCurrent) {
            monthSelect.value = month;
        } else if (monthSelect.options.length > 0) {
            monthSelect.value = monthSelect.options[0].value;
        }

        document.getElementById('modalFineWaived').checked = false;
        document.getElementById('modalFine').readOnly = false;
        
        updateModalFine();
        
        document.getElementById('paymentModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }
    
    function updateModalFine() {
        if (document.getElementById('modalFineWaived').checked) return;
        
        const fineStartDays = parseInt('<%= tenant.fine_start_days || 10 %>');
        const fineAmountPerDay = parseFloat('<%= tenant.fine_amount_per_day || 20 %>');

        const month = parseInt(document.getElementById('modalMonth').value);
        const selectedYear = parseInt(document.getElementById('modalYear').value);
        const today = new Date();
        const currentDay = today.getDate();
        let calculatedFine = 0;
        const currentMonth = today.getMonth() + 1;
        const currentYear = today.getFullYear();

        if (selectedYear < currentYear || (selectedYear === currentYear && month < currentMonth)) {
            const dueDate = new Date(selectedYear, month - 1, fineStartDays);
            const diffTime = Math.max(0, today - dueDate);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            calculatedFine = diffDays * fineAmountPerDay;
        } else if (selectedYear === currentYear && month == currentMonth && currentDay > fineStartDays) {
            calculatedFine = (currentDay - fineStartDays) * fineAmountPerDay;
        }

        document.getElementById('modalFine').value = calculatedFine;
    }

    
    function toggleWaive(checked) {
        const fineInput = document.getElementById('modalFine');
        if (checked) {
            fineInput.value = 0;
            fineInput.readOnly = true;
        } else {
            fineInput.readOnly = false;
            updateModalFine();
        }
    }
    function closeModal() {
        document.getElementById('paymentModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }

    // Tabs switching logic
    function switchTab(tabType) {
        const recentBtn = document.getElementById('tab-recent-btn');
        const classBtn = document.getElementById('tab-class-btn');
        const simpleBtn = document.getElementById('tab-simple-btn');
        const matrixBtn = document.getElementById('tab-matrix-btn');
        const cashflowBtn = document.getElementById('tab-cashflow-btn');
        
        const recentPane = document.getElementById('pane-recent');
        const classPane = document.getElementById('pane-class');
        const simplePane = document.getElementById('pane-simple');
        const matrixPane = document.getElementById('pane-matrix');
        const cashflowPane = document.getElementById('pane-cashflow');
        
        const filterViewInput = document.getElementById('filter-view-input');

        // Reset all
        [recentBtn, classBtn, simpleBtn, matrixBtn, cashflowBtn].forEach(b => { if(b) b.classList.remove('active'); });
        [recentPane, classPane, simplePane, matrixPane, cashflowPane].forEach(p => { if(p) p.style.display = 'none'; });

        if (tabType === 'recent' && recentBtn) {
            recentBtn.classList.add('active');
            if (recentPane) recentPane.style.display = 'block';
        } else if (tabType === 'class' && classBtn) {
            classBtn.classList.add('active');
            if (classPane) classPane.style.display = 'block';
        } else if (tabType === 'matrix' && matrixBtn) {
            matrixBtn.classList.add('active');
            if (matrixPane) matrixPane.style.display = 'block';
        } else if (tabType === 'cashflow' && cashflowBtn) {
            cashflowBtn.classList.add('active');
            if (cashflowPane) cashflowPane.style.display = 'block';
        } else {
            if (classBtn) classBtn.classList.add('active');
            if (classPane) classPane.style.display = 'block';
            tabType = 'class';
        }
        
        if (filterViewInput) filterViewInput.value = tabType;
        localStorage.setItem('fees_ledger_view', tabType);
    }

    // Quick filter check for defaulters
    function toggleDefaultersOnly(showDefaultersOnly) {
        const rows = document.querySelectorAll('#pane-class .student-row');
        rows.forEach(row => {
            if (showDefaultersOnly) {
                if (row.classList.contains('status-row-paid')) {
                    row.style.display = 'none';
                } else {
                    row.style.display = '';
                }
            } else {
                row.style.display = '';
            }
        });
    }

    // Filter table by paid/unpaid status
    function filterByStatus(status) {
        // Automatically switch to Class Summary tab if KPI is clicked
        switchTab('class');
        
        const checkbox = document.getElementById('show-defaulters-checkbox');
        const rows = document.querySelectorAll('#pane-class .student-row');
        
        if (status === 'all') {
            if (checkbox) checkbox.checked = false;
            rows.forEach(row => row.style.display = '');
            localStorage.setItem('fees_ledger_show_defaulters', 'false');
        } else if (status === 'paid') {
            if (checkbox) checkbox.checked = false;
            rows.forEach(row => {
                if (row.classList.contains('status-row-paid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            localStorage.setItem('fees_ledger_show_defaulters', 'false');
        } else if (status === 'unpaid') {
            if (checkbox) checkbox.checked = true;
            rows.forEach(row => {
                if (row.classList.contains('status-row-unpaid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            localStorage.setItem('fees_ledger_show_defaulters', 'true');
        }
    }

    // Restore tab preference and checkbox state on load
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const urlView = urlParams.get('view');
        let savedView = urlView || localStorage.getItem('fees_ledger_view') || 'class';
        
        switchTab(savedView);

        const showDefaultersOnly = localStorage.getItem('fees_ledger_show_defaulters') === 'true';
        const checkbox = document.getElementById('show-defaulters-checkbox');
        if (checkbox) {
            checkbox.checked = showDefaultersOnly;
            toggleDefaultersOnly(showDefaultersOnly);
        }
    });

    // Open & Close Class Challan Modal
    function openClassChallanModal(classId) {
        if (classId && document.getElementById('challanClassId')) {
            document.getElementById('challanClassId').value = classId;
        }
        
        // Reset form & progress state
        const form = document.getElementById('classChallanForm');
        const progressBox = document.getElementById('challanProgressContainer');
        const errorBox = document.getElementById('challanErrorContainer');
        const submitBtn = document.getElementById('challanSubmitBtn');
        
        if (form) form.style.display = 'block';
        if (progressBox) progressBox.style.display = 'none';
        if (errorBox) errorBox.style.display = 'none';
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-file-earmark-pdf-fill"></i> Download PDF';
        }
        
        // Auto calculate default dates if empty
        const now = new Date();
        const issueInput = document.getElementById('challanIssueDate');
        const dueInput = document.getElementById('challanDueDate');
        
        if (issueInput && !issueInput.value) {
            issueInput.value = now.toISOString().split('T')[0];
        }
        if (dueInput && !dueInput.value) {
            const dueDay = <%= tenant.fine_start_days || 10 %>;
            const dueObj = new Date(now.getFullYear(), now.getMonth(), dueDay);
            dueInput.value = dueObj.toISOString().split('T')[0];
        }
        
        const modal = document.getElementById('classChallanModal');
        const backdrop = document.getElementById('challanModalBackdrop');
        if (modal && backdrop) {
            modal.style.display = 'block';
            backdrop.style.display = 'block';
        }
    }

    function closeClassChallanModal() {
        const modal = document.getElementById('classChallanModal');
        const backdrop = document.getElementById('challanModalBackdrop');
        if (modal && backdrop) {
            modal.style.display = 'none';
            backdrop.style.display = 'none';
        }
    }

    // Handle AJAX PDF Generation with Progress Bar
    async function handleGenerateChallanPdf(event) {
        event.preventDefault();
        
        const form = document.getElementById('classChallanForm');
        const progressBox = document.getElementById('challanProgressContainer');
        const errorBox = document.getElementById('challanErrorContainer');
        const submitBtn = document.getElementById('challanSubmitBtn');
        const progressBar = document.getElementById('challanProgressBar');
        const progressStatus = document.getElementById('challanProgressStatus');
        
        const formData = new FormData(form);
        const params = new URLSearchParams(formData).toString();
        const url = `/fees/challans/print?${params}`;
        
        form.style.display = 'none';
        progressBox.style.display = 'block';
        if (errorBox) errorBox.style.display = 'none';
        
        // Stage timer simulation for smooth UX
        let progress = 15;
        progressBar.style.width = '15%';
        progressStatus.textContent = '1/3 - Loading student records & computing fees...';
        
        const timer1 = setTimeout(() => {
            progress = 45;
            progressBar.style.width = '45%';
            progressStatus.textContent = '2/3 - Generating 3-per-page Challan layout...';
        }, 1200);
        
        const timer2 = setTimeout(() => {
            progress = 75;
            progressBar.style.width = '75%';
            progressStatus.textContent = '3/3 - Rendering high-resolution PDF with Playwright Chromium...';
        }, 3000);
        
        const timer3 = setTimeout(() => {
            progress = 90;
            progressBar.style.width = '90%';
            progressStatus.textContent = 'Finalizing document download...';
        }, 6500);
        
        try {
            const response = await fetch(url);
            clearTimeout(timer1);
            clearTimeout(timer2);
            clearTimeout(timer3);
            
            if (!response.ok) {
                const errText = await response.text();
                throw new Error(errText || 'Failed to generate PDF');
            }
            
            progressBar.style.width = '100%';
            progressBar.style.backgroundColor = '#16a34a';
            progressStatus.innerHTML = '<span style="color: #16a34a; font-weight: 700;"><i class="bi bi-check-circle-fill"></i> Done! PDF generated successfully. Downloading...</span>';
            
            const blob = await response.blob();
            
            // Extract filename if provided
            let filename = 'Fee-Challans.pdf';
            const disposition = response.headers.get('Content-Disposition');
            if (disposition && disposition.indexOf('filename=') !== -1) {
                const matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                if (matches != null && matches[1]) {
                    filename = matches[1].replace(/['"]/g, '');
                }
            }
            
            const downloadUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = downloadUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(downloadUrl);
            a.remove();
            
            setTimeout(() => {
                closeClassChallanModal();
            }, 1800);
            
        } catch (err) {
            clearTimeout(timer1);
            clearTimeout(timer2);
            clearTimeout(timer3);
            
            progressBox.style.display = 'none';
            form.style.display = 'block';
            if (errorBox) {
                errorBox.style.display = 'block';
                errorBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${err.message || 'Error generating PDF. Please try again.'}`;
            }
        }
    }
</script>

<!-- Backdrop -->
<div id="challanModalBackdrop" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.6); z-index: 999; backdrop-filter: blur(2px);" onclick="closeClassChallanModal()"></div>

<!-- Class Fee Challan Print Modal -->
<div id="classChallanModal" class="card" style="display: none; max-width: 480px; width: 90%; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1); border-radius: 12px; padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
        <h3 style="margin: 0; display: flex; align-items: center; gap: 0.5rem; font-size: 1.2rem; color: var(--ink);">
            <i class="bi bi-printer-fill" style="color: var(--primary-color);"></i> Print Class Fee Challans
        </h3>
        <button type="button" onclick="closeClassChallanModal()" style="background: none; border: none; font-size: 1.3rem; color: #94a3b8; cursor: pointer; padding: 0.2rem 0.5rem;">&times;</button>
    </div>

    <!-- Error Alert Container -->
    <div id="challanErrorContainer" style="display: none; background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem;"></div>

    <!-- Progress / Loading Container -->
    <div id="challanProgressContainer" style="display: none; text-align: center; padding: 1.5rem 0.5rem;">
        <div style="margin-bottom: 1rem;">
            <div class="spinner-border text-primary" style="display: inline-block; width: 3rem; height: 3rem; border: 4px solid rgba(59, 130, 246, 0.2); border-radius: 50%; border-top-color: var(--primary-color); animation: spin 0.8s linear infinite;" role="status"></div>
        </div>
        <h4 style="margin: 0 0 0.5rem 0; color: var(--ink); font-size: 1.1rem;">Generating Class PDF Challans</h4>
        <p id="challanProgressStatus" style="font-size: 0.85rem; color: #64748b; margin-bottom: 1.25rem; min-height: 1.2rem;">
            Initializing document compilation...
        </p>
        
        <!-- Progress Bar -->
        <div style="background-color: #e2e8f0; border-radius: 9999px; height: 8px; width: 100%; overflow: hidden; position: relative;">
            <div id="challanProgressBar" style="width: 15%; height: 100%; background-color: var(--primary-color); border-radius: 9999px; transition: width 0.4s ease, background-color 0.3s ease;"></div>
        </div>
        <p style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.75rem;">This may take a few seconds as we format 3 student challans per page.</p>
    </div>

    <!-- Form Container -->
    <form id="classChallanForm" onsubmit="handleGenerateChallanPdf(event)">
        <div class="form-group" style="margin-bottom: 1rem;">
            <label for="challanClassId" style="font-weight: 600;">Select Class</label>
            <select name="classId" id="challanClassId" class="form-control" required>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>" <%= (locals.classId && locals.classId == c.id) ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
            </select>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label for="challanMonth" style="font-weight: 600;">Fee Month</label>
                <select name="month" id="challanMonth" class="form-control" required>
                    <% monthsList.forEach((mName, idx) => { %>
                        <option value="<%= idx + 1 %>" <%= activeMonthNum === (idx + 1) ? 'selected' : '' %>><%= mName %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label for="challanYear" style="font-weight: 600;">Fee Year</label>
                <select name="year" id="challanYear" class="form-control" required>
                    <% const mY = new Date().getFullYear(); for(let y = 2024; y <= mY + 1; y++) { %>
                        <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </div>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label for="challanIssueDate" style="font-weight: 600;">Issue Date</label>
                <input type="date" name="issueDate" id="challanIssueDate" class="form-control" required>
            </div>
            <div class="form-group">
                <label for="challanDueDate" style="font-weight: 600;">Due Date</label>
                <input type="date" name="dueDate" id="challanDueDate" class="form-control" required>
            </div>
        </div>

        <div style="background: #fdfaf6; border: 1px solid #f3e8d8; border-radius: 8px; padding: 0.65rem 0.9rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <span style="font-size: 0.75rem; font-weight: 700; color: #9a6818; text-transform: uppercase; letter-spacing: 0.5px;">Late Fee Policy (From Settings)</span>
                <div style="font-size: 0.9rem; font-weight: 800; color: #1e293b; margin-top: 2px;">
                    <% if (tenant.default_late_fee_type === 'per_day') { %>
                        Rs. <%= (tenant.fine_amount_per_day || 20).toLocaleString() %> / day after due date
                    <% } else { %>
                        Fixed Rs. <%= (tenant.fixed_late_fee_amount || 250).toLocaleString() %> after due date
                    <% } %>
                </div>
            </div>
            <a href="/settings/general" target="_blank" style="font-size: 0.75rem; color: #64748b; text-decoration: underline;">Change in Settings</a>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="challanArrearsStartMonth" style="font-weight: 600;">Calculate Previous Dues (Arrears) Starting From</label>
            <% 
                const defaultStartMonth = (tenant && tenant.fee_start_month && Number(tenant.fee_start_month) >= 1) ? Number(tenant.fee_start_month) : 8;
                const isOverdueOn = (tenant && tenant.include_overdue_in_challans !== 0); 
            %>
            <select name="arrearsStartMonth" id="challanArrearsStartMonth" class="form-control">
                <option value="0" <%= !isOverdueOn ? 'selected' : '' %>>None (Current Month Only - No Previous Dues)</option>
                <% monthsList.forEach((mName, idx) => { %>
                    <option value="<%= idx + 1 %>" <%= (isOverdueOn && defaultStartMonth === (idx + 1)) ? 'selected' : '' %>><%= mName %> <%= idx + 1 === defaultStartMonth ? '(System Billing Start)' : '' %></option>
                <% }) %>
            </select>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Select start month for checking unpaid dues. Ignores earlier months when school wasn't active on system.</p>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: #475569;">
            <i class="bi bi-info-circle-fill" style="color: var(--primary-color);"></i> Generates a multi-page PDF with <strong>3 student slips per A4 page</strong> to minimize printing costs.
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
            <button type="button" class="btn-secondary" onclick="closeClassChallanModal()">Cancel</button>
            <button type="submit" id="challanSubmitBtn" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                <i class="bi bi-file-earmark-pdf-fill"></i> Download PDF
            </button>
        </div>
    </form>
</div>

<style>
@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>

<%- include('partials/footer') %>
