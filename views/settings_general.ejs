<%- include('partials/header') %>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 class="page-title"><i class="bi bi-gear-fill"></i> General Settings</h1>
        <p style="color: #64748b; margin-top: 0.25rem;">Manage school theme and logo</p>
    </div>
</div>

<div class="filter-bar" style="margin-bottom: 1.5rem;">
    <a href="/settings/general" class="nav-tab active">General</a>
    <a href="/settings/merge" class="nav-tab">Merge Duplicates</a>
</div>

<% if (req.query.success) { %>
<div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
    <i class="bi bi-check-circle-fill"></i> Settings updated successfully!
</div>
<% } %>

<div class="card" style="max-width: 800px; margin: 0 auto;">
    <p style="color: var(--text-muted); margin-bottom: 2rem;">Update your school's global settings, theme, and logo.</p>
    <form action="/settings/general" method="POST" enctype="multipart/form-data" onsubmit="return handleLogoCompress(event)">
        
        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">School Logo</h3>
        </div>
        
        <div class="form-group" style="margin-bottom: 2rem;">
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Current Logo</label>
            <% if (currentTenant.logo_url) { %>
                <img src="<%= currentTenant.logo_url %>" alt="Current Logo" style="max-height: 100px; max-width: 200px; width: auto; object-fit: contain; border-radius: 8px; border: 1px solid #e2e8f0; padding: 0.5rem; background: #fff;">
            <% } else { %>
                <div style="width: 100px; height: 100px; background: #f1f5f9; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                    <i class="bi bi-image" style="font-size: 2rem;"></i>
                </div>
            <% } %>
            
            <label style="display: block; font-weight: 600; margin-top: 1rem; margin-bottom: 0.5rem;">Upload New Logo (Optional)</label>
            <input type="file" name="logo" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp">
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Recommended size: 200x200 pixels. Max size: 2MB.</p>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">Theme Colors</h3>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="form-group">
                <label for="primary_color" style="font-weight: 600;">Primary Color</label>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <input type="color" id="primary_color" name="primary_color" value="<%= currentTenant.primary_color || '#3b82f6' %>" style="width: 50px; height: 38px; padding: 0; cursor: pointer; border: 1px solid var(--border); border-radius: 4px;">
                    <span style="font-family: monospace; color: #64748b;"><%= currentTenant.primary_color || '#3b82f6' %></span>
                </div>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Used for main buttons, links, and active states.</p>
            </div>
            <div class="form-group">
                <label for="secondary_color" style="font-weight: 600;">Secondary Color</label>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <input type="color" id="secondary_color" name="secondary_color" value="<%= currentTenant.secondary_color || '#1d4ed8' %>" style="width: 50px; height: 38px; padding: 0; cursor: pointer; border: 1px solid var(--border); border-radius: 4px;">
                    <span style="font-family: monospace; color: #64748b;"><%= currentTenant.secondary_color || '#1d4ed8' %></span>
                </div>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Used for hover states and secondary elements.</p>
            </div>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">Student Module Settings</h3>
        </div>

        <div class="form-group" style="margin-bottom: 2rem;">
            <label style="display: flex; align-items: center; gap: 0.75rem; font-weight: 600; cursor: pointer;">
                <input type="checkbox" name="default_hifz_fee_waiver" value="1" <%= currentTenant.default_hifz_fee_waiver ? 'checked' : '' %> style="width: 18px; height: 18px;">
                Default Hifz Students to Full Fee Waiver
            </label>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem; margin-left: 1.75rem;">If enabled, selecting a Hifz class for a new student will automatically assign them a 100% fee concession.</p>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">Hifz Settings (Quran Structure)</h3>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="form-group">
                <label for="hifz_pages_per_para" style="font-weight: 600;">Pages per Para</label>
                <input type="number" id="hifz_pages_per_para" name="hifz_pages_per_para" class="form-control" value="<%= currentTenant.hifz_pages_per_para || 20 %>" min="1" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Usually 18 or 20.</p>
            </div>
            <div class="form-group">
                <label for="hifz_lines_per_page" style="font-weight: 600;">Lines per Page</label>
                <input type="number" id="hifz_lines_per_page" name="hifz_lines_per_page" class="form-control" value="<%= currentTenant.hifz_lines_per_page || 15 %>" min="1" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Usually 15 or 16.</p>
            </div>
            <div class="form-group">
                <label for="hifz_total_pages" style="font-weight: 600;">Total Pages in Quran</label>
                <input type="number" id="hifz_total_pages" name="hifz_total_pages" class="form-control" value="<%= currentTenant.hifz_total_pages || 600 %>" min="1" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Usually around 600.</p>
            </div>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">Fee Challan Payment Channels & Accounts</h3>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group">
                <label for="easypaisa_number" style="font-weight: 600;">Easypaisa Account Number</label>
                <input type="text" id="easypaisa_number" name="easypaisa_number" class="form-control" value="<%= currentTenant.easypaisa_number || currentTenant.fee_account_number || '' %>" placeholder="e.g. 0342-0980325">
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Used for Easypaisa payments on fee challans.</p>
            </div>
            <div class="form-group">
                <label for="jazzcash_number" style="font-weight: 600;">JazzCash Account Number</label>
                <input type="text" id="jazzcash_number" name="jazzcash_number" class="form-control" value="<%= currentTenant.jazzcash_number || currentTenant.fee_account_number || '' %>" placeholder="e.g. 0300-1234567">
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Used for JazzCash payments on fee challans.</p>
            </div>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="form-group">
                <label for="fee_account_title" style="font-weight: 600;">Account Title / Owner Name (Optional)</label>
                <input type="text" id="fee_account_title" name="fee_account_title" class="form-control" value="<%= currentTenant.fee_account_title || '' %>" placeholder="e.g. School Principal / Admin">
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Displayed alongside the account number.</p>
            </div>
            <div class="form-group">
                <label for="fee_account_number" style="font-weight: 600;">Primary Fallback Account Number</label>
                <input type="text" id="fee_account_number" name="fee_account_number" class="form-control" value="<%= currentTenant.fee_account_number || '' %>" placeholder="e.g. 0342-0980325">
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Fallback if specific channel number is not set.</p>
            </div>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">Late Fee Configuration</h3>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group">
                <label for="default_late_fee_type" style="font-weight: 600;">Late Fee Type</label>
                <select id="default_late_fee_type" name="default_late_fee_type" class="form-control">
                    <option value="fixed" <%= (currentTenant.default_late_fee_type === 'fixed' || !currentTenant.default_late_fee_type) ? 'selected' : '' %>>Fixed One-Time Late Fee (e.g. Rs. 250 / 400)</option>
                    <option value="per_day" <%= currentTenant.default_late_fee_type === 'per_day' ? 'selected' : '' %>>Daily Fine per Day Late (e.g. Rs. 20/day)</option>
                </select>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Used as default on fee challans and late payments.</p>
            </div>
            <div class="form-group">
                <label for="fixed_late_fee_amount" style="font-weight: 600;">Default Fixed Late Fee (PKR)</label>
                <input type="number" id="fixed_late_fee_amount" name="fixed_late_fee_amount" class="form-control" value="<%= currentTenant.fixed_late_fee_amount || 250 %>" min="0" step="1" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Default amount printed on challans.</p>
            </div>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="form-group">
                <label for="fine_start_days" style="font-weight: 600;">Fine Start Day (Due Date of Month)</label>
                <input type="number" id="fine_start_days" name="fine_start_days" class="form-control" value="<%= currentTenant.fine_start_days || 10 %>" min="1" max="28" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">e.g., 10 means payments after the 10th are late.</p>
            </div>
            <div class="form-group">
                <label for="fine_amount_per_day" style="font-weight: 600;">Fine Amount Per Day (PKR)</label>
                <input type="number" id="fine_amount_per_day" name="fine_amount_per_day" class="form-control" value="<%= currentTenant.fine_amount_per_day || 20 %>" min="0" step="0.01" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Daily rate applied for per-day fine mode.</p>
            </div>
        </div>

        <div class="section-header" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <h3 style="margin: 0;">School Work Hours Settings</h3>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group">
                <label for="school_start_time" style="font-weight: 600;">School Start Time</label>
                <input type="time" id="school_start_time" name="school_start_time" class="form-control" value="<%= currentTenant.school_start_time || '08:00' %>" required>
            </div>
            <div class="form-group">
                <label for="school_end_time" style="font-weight: 600;">School End Time</label>
                <input type="time" id="school_end_time" name="school_end_time" class="form-control" value="<%= currentTenant.school_end_time || '14:00' %>" required>
            </div>
        </div>

        <div class="form-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div class="form-group">
                <label for="late_threshold_minutes" style="font-weight: 600;">Late Threshold Margin (Minutes)</label>
                <input type="number" id="late_threshold_minutes" name="late_threshold_minutes" class="form-control" value="<%= currentTenant.late_threshold_minutes || 15 %>" min="0" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Minutes after start time before marked late.</p>
            </div>
            <div class="form-group">
                <label for="late_days_deduction_trigger" style="font-weight: 600;">Late Marks triggering 1 Day Salary Deduction</label>
                <input type="number" id="late_days_deduction_trigger" name="late_days_deduction_trigger" class="form-control" value="<%= currentTenant.late_days_deduction_trigger || 4 %>" min="1" required>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Number of late days that trigger 1 day's salary deduction.</p>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; border-top: 1px solid var(--border); padding-top: 1.5rem;">
            <button type="submit" class="btn-primary" style="font-size: 1.1rem; padding: 0.75rem 2rem;">
                <i class="bi bi-save"></i> Save Settings
            </button>
        </div>
    </form>
</div>

<script>
    let isCompressing = false;
    function handleLogoCompress(event) {
        if (isCompressing) return true; // Already compressed, let it submit
        
        const fileInput = document.querySelector('input[name="logo"]');
        if (fileInput && fileInput.files && fileInput.files.length > 0) {
            event.preventDefault();
            const file = fileInput.files[0];
            
            const img = new Image();
            const reader = new FileReader();
            reader.onload = function(e) {
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 400; // Logo doesn't need to be huge
                    const MAX_HEIGHT = 400;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) {
                            height *= MAX_WIDTH / width;
                            width = MAX_WIDTH;
                        }
                    } else {
                        if (height > MAX_HEIGHT) {
                            width *= MAX_HEIGHT / height;
                            height = MAX_HEIGHT;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob(function(blob) {
                        const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                            type: 'image/jpeg',
                            lastModified: Date.now()
                        });
                        
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(newFile);
                        fileInput.files = dataTransfer.files;
                        
                        isCompressing = true;
                        event.target.submit();
                    }, 'image/jpeg', 0.85);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
            return false;
        }
        return true;
    }
</script>

<%- include('partials/footer') %>
