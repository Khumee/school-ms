<%- include('partials/header') %>

<% const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December']; %>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-person-vcard-fill"></i> <%= student.name %></h1>
    <div style="display: flex; gap: 0.5rem;">
        <a href="/students/print/<%= student.id %>" target="_blank" class="btn-secondary"><i class="bi bi-printer"></i> Print Profile</a>
        <a href="/students/edit/<%= student.id %>" class="btn-secondary"><i class="bi bi-pencil-square"></i> Edit</a>
        <a href="/students" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Directory</a>
    </div>
</div>

<div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 1.5rem;">
    <div class="card kpi-card">
        <span class="kpi-icon blue"><i class="bi bi-credit-card-2-front-fill"></i></span>
        <span class="kpi-label">Registration No.</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= student.reg_no %></span>
    </div>
    <div class="card kpi-card">
        <span class="kpi-icon purple"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="kpi-label">Class</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= student.class_name || 'Unassigned' %></span>
    </div>
    <div class="card kpi-card">
        <span class="kpi-icon amber"><i class="bi bi-tags-fill"></i></span>
        <span class="kpi-label">Monthly Fee (Net)</span>
        <span class="kpi-value" style="font-size: 1.4rem;">
            PKR <%= (parseFloat(student.default_monthly_fee || 0) - (student.has_concession ? parseFloat(student.custom_monthly_fee || 0) : 0)).toLocaleString() %>
        </span>
        <span class="kpi-subtitle">
            <%= student.has_concession ? 'Concessional Rate' : 'Standard Rate' %>
        </span>
    </div>
    <div class="card kpi-card">
        <span class="kpi-icon green"><i class="bi bi-cash-stack"></i></span>
        <span class="kpi-label">Total Fees Paid (2026)</span>
        <span class="kpi-value" style="font-size: 1.4rem;">PKR <%= totalPaid.toLocaleString() %></span>
    </div>
</div>


<div class="tabs-container" style="margin-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; display: flex; gap: 1rem;">
    <button class="tab-btn active" onclick="switchTab('overview')" id="tab-overview" style="padding: 0.5rem 1rem; border: none; background: transparent; cursor: pointer; border-bottom: 2px solid var(--primary-color); font-weight: 600; color: var(--primary-color);">Overview</button>
    <button class="tab-btn" onclick="switchTab('fees')" id="tab-fees" style="padding: 0.5rem 1rem; border: none; background: transparent; cursor: pointer; border-bottom: 2px solid transparent; font-weight: 500; color: #64748b;">Fee History</button>
    <button class="tab-btn" onclick="switchTab('documents')" id="tab-documents" style="padding: 0.5rem 1rem; border: none; background: transparent; cursor: pointer; border-bottom: 2px solid transparent; font-weight: 500; color: #64748b;">Documents & Photo</button>
    <button class="tab-btn" onclick="switchTab('attendance')" id="tab-attendance" style="padding: 0.5rem 1rem; border: none; background: transparent; cursor: pointer; border-bottom: 2px solid transparent; font-weight: 500; color: #64748b;">Attendance History</button>
</div>

<div id="content-overview" class="tab-content">
<div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-bottom: 2rem;">
    <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);"><i class="bi bi-person-lines-fill"></i> Admission & Demographic Details</h3>
        <table class="details-table" style="width: 100%; font-size: 0.875rem;">
            <tr><td style="font-weight: 600; padding: 6px 0; width: 45%;">Date of Admission</td><td style="padding: 6px 0;"><%= student.date_of_admission ? new Date(student.date_of_admission).toLocaleDateString() : '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Date of Birth</td><td style="padding: 6px 0;"><%= student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString() : '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Gender</td><td style="padding: 6px 0; text-transform: capitalize;"><%= student.gender || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Status</td><td style="padding: 6px 0; text-transform: capitalize;"><%= student.status %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Father's Name</td><td style="padding: 6px 0;"><%= student.father_name || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Father's Phone</td><td style="padding: 6px 0;"><%= student.father_phone || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Emergency Contact</td><td style="padding: 6px 0;"><%= student.emergency_contact || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Address</td><td style="padding: 6px 0;"><%= student.address || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Blood Group</td><td style="padding: 6px 0;"><%= student.blood_group || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Previous School</td><td style="padding: 6px 0;"><%= student.previous_school_info || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Family Members</td><td style="padding: 6px 0;"><%= student.family_members || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Siblings (Total)</td><td style="padding: 6px 0;"><%= student.siblings !== null ? student.siblings : '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Siblings (School Going)</td><td style="padding: 6px 0;"><%= student.school_going_siblings !== null ? student.school_going_siblings : '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Monthly Income</td><td style="padding: 6px 0;"><%= student.monthly_income || '-' %></td></tr>
        </table>
    </div>

    <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);"><i class="bi bi-tags-fill"></i> Fee Concession Details</h3>
        <table class="details-table" style="width: 100%; font-size: 0.875rem;">
            <tr><td style="font-weight: 600; padding: 6px 0; width: 45%;">Class Standard Fee</td><td style="padding: 6px 0;">PKR <%= (student.default_monthly_fee || 0).toLocaleString() %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Concession Amount</td><td style="padding: 6px 0;">PKR <%= student.has_concession ? parseFloat(student.custom_monthly_fee || 0).toLocaleString() : '0' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Net Monthly Fee</td><td style="padding: 6px 0;">PKR <%= (parseFloat(student.default_monthly_fee || 0) - (student.has_concession ? parseFloat(student.custom_monthly_fee || 0) : 0)).toLocaleString() %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Has Concession</td><td style="padding: 6px 0;"><%= student.has_concession ? 'Yes' : 'No' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Reason</td><td style="padding: 6px 0;"><%= student.concession_reason || '-' %></td></tr>
            <tr><td style="font-weight: 600; padding: 6px 0;">Notes</td><td style="padding: 6px 0;"><%= student.concession_notes || '-' %></td></tr>
        </table>
    </div>

    <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);"><i class="bi bi-cash-stack"></i> Admission Fee Details</h3>
        <table class="details-table" style="width: 100%; font-size: 0.875rem; margin-bottom: 1rem;">
            <tr>
                <td style="font-weight: 600; padding: 6px 0; width: 45%;">Admission Fee</td>
                <td style="padding: 6px 0; font-weight: 600;">PKR <%= (student.admission_fee || 0).toLocaleString() %></td>
            </tr>
            <tr>
                <td style="font-weight: 600; padding: 6px 0;">Status</td>
                <td style="padding: 6px 0;">
                    <% if (student.admission_fee_status === 'paid') { %>
                        <span class="status-cell status-paid" style="background-color: #f0fdf4; color: #16a34a; padding: 2px 8px; border-radius: 4px; font-weight: 600;"><i class="bi bi-check-circle-fill"></i> PAID</span>
                    <% } else if (student.admission_fee_status === 'waived') { %>
                        <span class="status-cell" style="background-color: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; font-weight: 600;"><i class="bi bi-slash-circle-fill"></i> WAIVED</span>
                    <% } else { %>
                        <span class="status-cell status-unpaid" style="background-color: #fef2f2; color: #dc2626; padding: 2px 8px; border-radius: 4px; font-weight: 600;"><i class="bi bi-exclamation-triangle-fill"></i> UNPAID</span>
                    <% } %>
                </td>
            </tr>
            <% if (student.admission_fee_status === 'paid' && student.admission_fee_payment_date) { %>
                <tr>
                    <td style="font-weight: 600; padding: 6px 0;">Payment Date</td>
                    <td style="padding: 6px 0;"><%= new Date(student.admission_fee_payment_date).toLocaleDateString() %></td>
                </tr>
            <% } %>
        </table>
        
        <% if (student.admission_fee_status !== 'paid') { %>
            <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                <form action="/students/update-admission-fee/<%= student.id %>" method="POST" style="margin: 0; display: inline-block; width: 100%;">
                    <input type="hidden" name="status" value="paid">
                    <button type="submit" class="btn-primary" style="width: 100%; font-size: 0.8rem; padding: 0.4rem 0.2rem;"><i class="bi bi-credit-card-fill"></i> Mark as Paid</button>
                </form>
                <% if (student.admission_fee_status !== 'waived') { %>
                    <form action="/students/update-admission-fee/<%= student.id %>" method="POST" style="margin: 0; display: inline-block; width: 100%;">
                        <input type="hidden" name="status" value="waived">
                        <button type="submit" class="btn-secondary" style="width: 100%; font-size: 0.8rem; padding: 0.4rem 0.2rem;"><i class="bi bi-slash-circle"></i> Waive Fee</button>
                    </form>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<% if (hifzEnrollment) { %>
<div class="card" style="margin-bottom: 2rem; border-left: 4px solid var(--primary-color);">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem; margin-bottom: 1rem;">
        <h3 style="margin: 0; color: var(--primary-color);"><i class="bi bi-book"></i> Hifz Memorization Status</h3>
        <a href="/hifz/student/<%= student.id %>" class="btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;"><i class="bi bi-eye"></i> View Hifz Profile</a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; font-size: 0.9rem;">
        <div>
            <span style="color: #64748b; font-size: 0.8rem; display: block; text-transform: uppercase;">Current Para</span>
            <strong style="font-size: 1.1rem; color: #1e3a8a;">Para <%= hifzEnrollment.current_para || 'None' %></strong>
        </div>
        <div>
            <span style="color: #64748b; font-size: 0.8rem; display: block; text-transform: uppercase;">Phase</span>
            <strong style="font-size: 1.1rem; text-transform: capitalize;"><%= hifzEnrollment.current_phase.replace(/_/g, ' ') %></strong>
        </div>
        <div>
            <span style="color: #64748b; font-size: 0.8rem; display: block; text-transform: uppercase;">Total Lines Memorized</span>
            <strong style="font-size: 1.1rem;"><%= hifzEnrollment.total_lines_memorized %> lines</strong>
        </div>
    </div>
</div>
<% } %>

<div class="section-header">
    <h2 class="section-title"><i class="bi bi-clock-history"></i> Fee Payment History</h2>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Month</th>
                <th>Year</th>
                <th style="text-align: right;">Amount Paid (PKR)</th>
                <th>Payment Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <% if (payments.length > 0) { %>
                <% payments.forEach(p => { %>
                    <tr>
                        <td style="font-weight: 600;">
                            <%= p.month === 0 ? 'Admission Fee' : monthNames[p.month - 1] %>
                        </td>
                        <td><%= p.year %></td>
                        <td style="text-align: right; font-weight: 600; color: #15803d;">PKR <%= parseFloat(p.amount_paid).toLocaleString() %></td>
                        <td><%= new Date(p.payment_date).toLocaleDateString() %></td>
                        <td>
                            <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                                <a href="/fees/receipt/<%= p.id %>" class="btn-secondary nav-btn" target="_blank" title="Print PDF Receipt"><i class="bi bi-printer-fill"></i> Receipt</a>
                                <button type="button" class="btn-secondary nav-btn" onclick="openPaymentModal('<%= student.id %>', '<%= student.name %>', <%= p.month %>, <%= p.year %>, <%= p.amount_paid %>, <%= p.fine_amount || 0 %>, <%= p.fine_waived || 0 %>, <%= p.additional_fee || 0 %>, '<%= p.additional_fee_description || '' %>', '<%= new Date(p.payment_date).toISOString().substring(0, 10) %>')"><i class="bi bi-pencil-fill"></i> Edit</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: #64748b;">No fee payments recorded yet.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>


</div>
<div id="content-documents" class="tab-content" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 class="section-title" style="margin: 0;"><i class="bi bi-folder2-open"></i> Student Documents</h2>
        <button class="btn-primary" onclick="document.getElementById('documentModal').style.display='block'; document.getElementById('modalOverlay').style.display='block';"><i class="bi bi-upload"></i> Upload Document</button>
    </div>
    
    <div class="card" style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);"><i class="bi bi-camera"></i> Student Photo</h3>
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="width: 120px; height: 120px; border-radius: 8px; overflow: hidden; border: 1px solid #cbd5e1; flex-shrink: 0;">
                <% if (student.photo_url) { %>
                    <img src="<%= student.photo_url %>" alt="Student Photo" style="width: 100%; height: 100%; object-fit: cover;">
                <% } else { %>
                    <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #f1f5f9; color: #94a3b8;">
                        <i class="bi bi-person-fill" style="font-size: 3rem;"></i>
                    </div>
                <% } %>
            </div>
            <div>
                <form action="/students/update-photo" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="student_id" value="<%= student.id %>">
                    
                    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <button type="button" class="btn-secondary" onclick="document.getElementById('photo_input').removeAttribute('capture'); document.getElementById('photo_input').click();" style="font-size: 0.85rem;"><i class="bi bi-folder2-open"></i> Upload File</button>
                        <button type="button" class="btn-secondary mobile-only" onclick="document.getElementById('photo_input').setAttribute('capture', 'user'); document.getElementById('photo_input').click();" style="font-size: 0.85rem;"><i class="bi bi-camera"></i> Take Photo</button>
                    </div>
                    
                    <input type="file" name="photo" id="photo_input" accept="image/*" style="display: none;" required onchange="document.getElementById('photo_submit_btn').style.display='inline-block'">
                    
                    <button type="submit" id="photo_submit_btn" class="btn-primary" style="display: none;"><i class="bi bi-arrow-up-circle"></i> Save Photo</button>
                </form>
            </div>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th style="width: 60px;">Preview</th>
                    <th>Document Type</th>
                    <th>Description</th>
                    <th>Date Uploaded</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof documents !== 'undefined' && documents.length > 0) { %>
                    <% documents.forEach(doc => { %>
                        <tr>
                            <td>
                                <% if (doc.file_path.match(/\.(jpeg|jpg|gif|png)$/i)) { %>
                                    <a href="<%= doc.file_path %>" target="_blank"><img src="<%= doc.file_path %>" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; border: 1px solid #e2e8f0;"></a>
                                <% } else { %>
                                    <div style="width: 40px; height: 40px; border-radius: 4px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 1.2rem;">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                <% } %>
                            </td>
                            <td style="font-weight: 600;"><%= doc.document_type %></td>
                            <td><%= doc.description || '-' %></td>
                            <td><%= new Date(doc.uploaded_at).toLocaleDateString() %></td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="<%= doc.file_path %>" target="_blank" class="btn-secondary nav-btn"><i class="bi bi-eye"></i> View</a>
                                    <form action="/students/delete-document" method="POST" style="margin:0;" onsubmit="return confirm('Delete this document?');">
                                        <input type="hidden" name="document_id" value="<%= doc.id %>">
                                        <input type="hidden" name="student_id" value="<%= student.id %>">
                                        <button type="submit" class="btn-secondary nav-btn" style="color: #dc2626; border-color: #fca5a5;"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align: center; color: #64748b;">No documents uploaded yet.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div id="content-attendance" class="tab-content" style="display: none;">
    <div class="card" style="margin-bottom: 2rem;">
        <h2 class="section-title" style="margin-bottom: 1rem;"><i class="bi bi-calendar-check"></i> Attendance History</h2>
        
        <div style="background-color: #f8fafc; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
            <div style="flex: 1; min-width: 200px;">
                <label style="font-size: 0.8rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 0.25rem;">Start Date</label>
                <input type="date" id="att-start-date" class="form-control">
            </div>
            <div style="flex: 1; min-width: 200px;">
                <label style="font-size: 0.8rem; color: #64748b; font-weight: 600; display: block; margin-bottom: 0.25rem;">End Date</label>
                <input type="date" id="att-end-date" class="form-control">
            </div>
            <div>
                <button class="btn-primary" onclick="fetchAttendance()" style="padding: 0.5rem 1rem;"><i class="bi bi-search"></i> Filter</button>
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
            <button class="btn-secondary nav-btn" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;" onclick="setAttendanceFilter('last_week')">Last Week</button>
            <button class="btn-secondary nav-btn" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;" onclick="setAttendanceFilter('last_month')">Last Month</button>
            <button class="btn-secondary nav-btn" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;" onclick="setAttendanceFilter('last_3_months')">Last 3 Months</button>
            <button class="btn-secondary nav-btn" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;" onclick="setAttendanceFilter('since_admission')">Since Admission</button>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Marked By</th>
                </tr>
            </thead>
            <tbody id="attendance-tbody">
                <tr><td colspan="3" style="text-align: center; color: #64748b;">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Document Upload Modal -->
<div id="documentModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 15%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-bottom: 1rem;">Upload Document</h3>
    <form action="/students/upload-document" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="student_id" value="<%= student.id %>">
        <input type="hidden" name="student_name" value="<%= student.name.replace(/\s+/g, '-') %>">
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="docType">Document Type</label>
            <select name="document_type" id="docType" class="form-control" required>
                <option value="B-Form">Student B-Form</option>
                <option value="Parent CNIC">Parent CNIC</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="docDesc">Description (Optional)</label>
            <input type="text" name="description" id="docDesc" class="form-control" placeholder="E.g., Father's ID Card Front">
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>File (Upload or Take Photo)</label>
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                <button type="button" class="btn-secondary" onclick="document.getElementById('docFile').removeAttribute('capture'); document.getElementById('docFile').click();" style="flex:1; font-size: 0.85rem;"><i class="bi bi-folder2-open"></i> Upload File</button>
                <button type="button" class="btn-secondary mobile-only" onclick="document.getElementById('docFile').setAttribute('capture', 'environment'); document.getElementById('docFile').click();" style="flex:1; font-size: 0.85rem;"><i class="bi bi-camera"></i> Take Photo</button>
            </div>
            <input type="file" name="document_file" id="docFile" style="display: none;" required onchange="document.getElementById('docSelectedText').innerText = this.files[0] ? this.files[0].name : 'No file selected'; previewThumbnail(this)">
            <div id="docSelectedText" style="font-size: 0.85rem; color: #64748b; text-align: center;">No file selected</div>
        </div>

        <div id="docPreviewContainer" style="display: none; margin-bottom: 1.25rem; text-align: center;">
            <img id="docPreviewImg" src="" alt="Preview" style="max-width: 100%; max-height: 200px; border-radius: 4px; border: 1px solid #cbd5e1;">
        </div>
        
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="document.getElementById('documentModal').style.display='none'; document.getElementById('modalOverlay').style.display='none';">Cancel</button>
            <button type="submit" class="btn-primary"><i class="bi bi-upload"></i> Upload</button>
        </div>
    </form>
</div>
\n<!-- Payment Modal -->
<div id="paymentModal" class="card" style="display: none; max-width: 400px; margin: 1rem auto; position: fixed; top: 20%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-bottom: 1rem;" id="modalTitle">Record Payment</h3>
    <form action="/fees/pay" method="POST">
        <input type="hidden" id="modalStudentId" name="student_id">
        <input type="hidden" id="modalMonth" name="month">
        <input type="hidden" id="modalYear" name="year">
        <input type="hidden" name="redirect_url" value="/students/view/<%= student.id %>">
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="modalAmount">Amount Paid (PKR)</label>
            <input type="number" step="0.01" id="modalAmount" name="amount" class="form-control" required>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="modalPaymentDate">Payment Date</label>
            <input type="date" id="modalPaymentDate" name="payment_date" class="form-control" required>
        </div>

        <div id="monthlyFeeExtraFields">
            <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
                <div class="form-group">
                    <label for="modalAdditionalFee">Additional Fee (PKR)</label>
                    <input type="number" step="0.01" id="modalAdditionalFee" name="additional_fee" class="form-control" value="0">
                </div>
                
                <div class="form-group">
                    <label for="modalAdditionalFeeDesc">Fee Description</label>
                    <input type="text" id="modalAdditionalFeeDesc" name="additional_fee_description" class="form-control" placeholder="e.g. Exam fee">
                </div>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="modalFine">Late Fee Fine (PKR)</label>
                <input type="number" step="0.01" id="modalFine" name="fine_amount" class="form-control" value="0">
            </div>
            
            <div class="form-checkbox" style="margin-bottom: 1.25rem; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 0.5rem;">
                <input type="checkbox" id="modalFineWaived" name="fine_waived" value="1" onchange="toggleWaive(this.checked)" style="width: 18px; height: 18px; cursor: pointer; margin: 0;">
                <label for="modalFineWaived" style="margin-bottom: 0; cursor: pointer; font-weight: 500;">Waive Late Fee Fine</label>
            </div>
        </div>
        
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>
<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeModal()"></div>

<script>
    function openPaymentModal(studentId, studentName, month, year, currentAmount, fineAmount, fineWaived, additionalFee, additionalFeeDesc, paymentDate) {
        const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        document.getElementById('modalStudentId').value = studentId;
        document.getElementById('modalMonth').value = month;
        document.getElementById('modalYear').value = year;
        document.getElementById('modalAmount').value = currentAmount || '';
        document.getElementById('modalPaymentDate').value = paymentDate || new Date().toISOString().substring(0, 10);
        
        if (month === 0) {
            document.getElementById('modalTitle').innerText = 'Edit Admission Fee: ' + studentName;
            document.getElementById('monthlyFeeExtraFields').style.display = 'none';
        } else {
            document.getElementById('modalTitle').innerText = 'Edit Fee: ' + studentName + ' (' + months[month - 1] + ' ' + year + ')';
            document.getElementById('monthlyFeeExtraFields').style.display = 'block';
            document.getElementById('modalAdditionalFee').value = additionalFee || 0;
            document.getElementById('modalAdditionalFeeDesc').value = additionalFeeDesc || '';
            document.getElementById('modalFine').value = fineAmount || 0;
            document.getElementById('modalFineWaived').checked = fineWaived === 1;
            toggleWaive(fineWaived === 1);
        }
        
        document.getElementById('paymentModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function toggleWaive(checked) {
        const fineInput = document.getElementById('modalFine');
        if (checked) {
            fineInput.value = 0;
            fineInput.readOnly = true;
        } else {
            fineInput.readOnly = false;
        }
    }

    function closeModal() {
        document.getElementById('paymentModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }
</script>
<script>
    const studentId = <%= student.id %>;
    const admissionDate = "<%= student.date_of_admission ? new Date(student.date_of_admission).toISOString().split('T')[0] : '' %>";
    
    function setAttendanceFilter(type) {
        const end = new Date();
        const start = new Date();
        
        if (type === 'last_week') {
            start.setDate(end.getDate() - 7);
        } else if (type === 'last_month') {
            start.setMonth(end.getMonth() - 1);
        } else if (type === 'last_3_months') {
            start.setMonth(end.getMonth() - 3);
        } else if (type === 'since_admission') {
            if (admissionDate) {
                document.getElementById('att-start-date').value = admissionDate;
                document.getElementById('att-end-date').value = end.toISOString().split('T')[0];
                fetchAttendance();
                return;
            } else {
                start.setFullYear(end.getFullYear() - 1); // fallback 1 year
            }
        }
        
        document.getElementById('att-start-date').value = start.toISOString().split('T')[0];
        document.getElementById('att-end-date').value = end.toISOString().split('T')[0];
        fetchAttendance();
    }

    function switchTab(tabId) {
        // Update tab buttons
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('active');
            btn.style.borderBottomColor = 'transparent';
            btn.style.fontWeight = '500';
            btn.style.color = '#64748b';
        });
        const activeBtn = document.getElementById('tab-' + tabId);
        if (activeBtn) {
            activeBtn.classList.add('active');
            activeBtn.style.borderBottomColor = 'var(--primary-color)';
            activeBtn.style.fontWeight = '600';
            activeBtn.style.color = 'var(--primary-color)';
        }

        // Update tab contents
        document.querySelectorAll('.tab-content').forEach(content => {
            content.style.display = 'none';
        });
        const activeContent = document.getElementById('content-' + tabId);
        if (activeContent) {
            activeContent.style.display = 'block';
        }
    }

    async function fetchAttendance() {
        const start = document.getElementById('att-start-date').value;
        const end = document.getElementById('att-end-date').value;
        const tbody = document.getElementById('attendance-tbody');
        
        tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: #64748b;">Loading...</td></tr>';
        
        try {
            const res = await fetch(`/students/api/attendance/${studentId}?startDate=${start}&endDate=${end}`);
            const json = await res.json();
            
            if (json.success) {
                if (json.data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: #64748b;">No attendance records found for this period.</td></tr>';
                    return;
                }
                
                let html = '';
                json.data.forEach(record => {
                    let statusHtml = '';
                    if (record.status === 'present') {
                        statusHtml = '<span style="color: #16a34a; font-weight: 600;"><i class="bi bi-check-circle-fill"></i> Present</span>';
                    } else if (record.status === 'absent') {
                        statusHtml = '<span style="color: #dc2626; font-weight: 600;"><i class="bi bi-x-circle-fill"></i> Absent</span>';
                    } else if (record.status === 'leave') {
                        statusHtml = '<span style="color: #ca8a04; font-weight: 600;"><i class="bi bi-dash-circle-fill"></i> Leave</span>';
                    } else {
                        statusHtml = `<span style="color: #2563eb; font-weight: 600;"><i class="bi bi-info-circle-fill"></i> ${record.status}</span>`;
                    }
                    
                    const dateStr = new Date(record.date).toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
                    
                    html += `<tr>
                        <td style="font-weight: 500;">${dateStr}</td>
                        <td>${statusHtml}</td>
                        <td style="color: #64748b; font-size: 0.9rem;">${record.marked_by_name || 'System'}</td>
                    </tr>`;
                });
                tbody.innerHTML = html;
            } else {
                tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: #dc2626;">Error: ${json.error}</td></tr>`;
            }
        } catch (err) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: #dc2626;">Network error while loading attendance.</td></tr>';
        }
    }

    // Initialize with Last Month
    window.addEventListener('DOMContentLoaded', () => {
        setAttendanceFilter('last_month');
    });
</script>
<%- include('partials/footer') %>
