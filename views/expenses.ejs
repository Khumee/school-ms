<%- include('partials/header') %>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-receipt"></i> Overhead Expenses Ledger</h1>
</div>

<div class="form-grid" style="grid-template-columns: 1fr 2fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Form to Add Expense -->
    <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);">Record Overhead Expense</h3>
        <form action="/expenses/add" method="POST">
            <div class="form-group" style="margin-bottom: 1rem;">
                <label for="item">Expense Item / Vendor Name *</label>
                <input type="text" id="item" name="item" class="form-control" required placeholder="e.g. Electric bill, Office stationery">
            </div>
            
            <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div class="form-group">
                    <label for="amount">Amount (PKR) *</label>
                    <input type="number" step="0.01" id="amount" name="amount" class="form-control" required placeholder="0.00">
                </div>
                
                <div class="form-group">
                    <label for="date">Date Paid</label>
                    <input type="date" id="date" name="date" class="form-control">
                </div>
            </div>
            
            <div class="form-group" style="margin-bottom: 1rem;">
                <label for="category">Category</label>
                <select name="category" id="category" class="form-control">
                    <option value="other">Other Expenses</option>
                    <option value="rent">Rent</option>
                    <option value="utility">Utility Bills</option>
                    <option value="office">Office Expenses</option>
                </select>
            </div>
            
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label for="description">Remarks / Description</label>
                <input type="text" id="description" name="description" class="form-control" placeholder="Add optional details">
            </div>
            
            <button type="submit" class="btn-primary" style="width: 100%;">Log Expense</button>
        </form>
    </div>
    
    <!-- Table list -->
    <div class="card">
        <% const totalExpenses = expenses.reduce((sum, e) => sum + parseFloat(e.amount), 0); %>
        <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; padding: 0.75rem 1rem; border-radius: 0.375rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 600; color: #166534; font-size: 0.95rem;"><i class="bi bi-calculator"></i> Total Expense for Selected Period:</span>
            <strong style="font-size: 1.3rem; color: #15803d;">PKR <%= totalExpenses.toLocaleString() %></strong>
        </div>

        <h3 style="margin-bottom: 1rem;">Logged Expenses List (2026)</h3>
        
        <!-- Filters -->
        <form action="/expenses" method="GET" style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
            <select name="category" class="form-control" style="width: 150px;" onchange="this.form.submit()">
                <option value="">-- All Categories --</option>
                <option value="rent" <%= category === 'rent' ? 'selected' : '' %>>Rent</option>
                <option value="utility" <%= category === 'utility' ? 'selected' : '' %>>Utilities</option>
                <option value="office" <%= category === 'office' ? 'selected' : '' %>>Office</option>
                <option value="other" <%= category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
            
            <select name="month" class="form-control" style="width: 150px;" onchange="this.form.submit()">
                <option value="">-- All Months --</option>
                <% const mNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; %>
                <% mNames.forEach((n, idx) => { %>
                    <option value="<%= idx + 1 %>" <%= month == (idx + 1) ? 'selected' : '' %>><%= n %></option>
                <% }) %>
            </select>
            
            <a href="/expenses" class="btn-secondary nav-btn" style="height: 38px; display: inline-flex; align-items: center;"><i class="bi bi-x-circle"></i> Reset</a>
        </form>
        
        <div class="table-container" style="border: none; max-height: 400px; overflow-y: auto;">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Item</th>
                        <th>Category</th>
                        <th style="text-align: right;">Amount (PKR)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (expenses.length > 0) { %>
                        <% expenses.forEach(e => { %>
                            <tr>
                                <td><%= new Date(e.date).toLocaleDateString() %></td>
                                <td style="font-weight: 500;"><%= e.item %></td>
                                <td><span class="status-cell status-paid"><%= e.category.toUpperCase() %></span></td>
                                <td style="text-align: right; font-weight: 600;"><%= e.amount.toLocaleString() %></td>
                                <td>
                                    <div style="display: flex; gap: 0.4rem;">
                                        <button type="button" class="btn-secondary nav-btn" onclick='openExpenseEditModal(<%- JSON.stringify({ id: e.id, date: new Date(e.date).toISOString().slice(0,10), item: e.item, amount: e.amount, category: e.category, description: e.description || "" }) %>)'><i class="bi bi-pencil-square"></i></button>
                                        <form action="/expenses/delete/<%= e.id %>" method="POST" onsubmit="confirmSubmit(event, 'Delete this expense record?')">
                                            <button type="submit" class="btn-danger nav-btn"><i class="bi bi-trash3-fill"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; color: #64748b;">No expenses recorded.</td>
                        </tr>
                    <% } %>
                </tbody>
                <% if (expenses.length > 0) { %>
                    <% const totalExpenses = expenses.reduce((sum, e) => sum + parseFloat(e.amount), 0); %>
                    <tfoot>
                        <tr style="background-color: #f8fafc; font-weight: 700; border-top: 2px solid #e2e8f0;">
                            <td colspan="3" style="text-align: right; padding: 12px 8px;">Total Expense for Selected Month:</td>
                            <td style="text-align: right; padding: 12px 8px; color: #b91c1c;">PKR <%= totalExpenses.toLocaleString() %></td>
                        </tr>
                    </tfoot>
                <% } %>
            </table>
        </div>
    </div>
</div>

<!-- Edit Expense Modal -->
<div id="editExpenseModal" class="card" style="display: none; max-width: 420px; margin: 1rem auto; position: fixed; top: 15%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
    <h3 style="margin-bottom: 1rem;">Edit Expense</h3>
    <form id="editExpenseForm" method="POST">
        <div class="form-group" style="margin-bottom: 1rem;">
            <label>Expense Item / Vendor Name *</label>
            <input type="text" id="editExpenseItem" name="item" class="form-control" required>
        </div>
        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label>Amount (PKR) *</label>
                <input type="number" step="0.01" id="editExpenseAmount" name="amount" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Date</label>
                <input type="date" id="editExpenseDate" name="date" class="form-control" required>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 1rem;">
            <label>Category</label>
            <select id="editExpenseCategory" name="category" class="form-control">
                <option value="other">Other Expenses</option>
                <option value="rent">Rent</option>
                <option value="utility">Utility Bills</option>
                <option value="office">Office Expenses</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 1.5rem;">
            <label>Remarks / Description</label>
            <input type="text" id="editExpenseDesc" name="description" class="form-control">
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeExpenseEditModal()">Cancel</button>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>
<div id="editExpenseOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeExpenseEditModal()"></div>

<script>
function openExpenseEditModal(e) {
    document.getElementById('editExpenseForm').action = '/expenses/edit/' + e.id;
    document.getElementById('editExpenseItem').value = e.item;
    document.getElementById('editExpenseAmount').value = e.amount;
    document.getElementById('editExpenseDate').value = e.date;
    document.getElementById('editExpenseCategory').value = e.category;
    document.getElementById('editExpenseDesc').value = e.description;
    
    document.getElementById('editExpenseModal').style.display = 'block';
    document.getElementById('editExpenseOverlay').style.display = 'block';
}
function closeExpenseEditModal() {
    document.getElementById('editExpenseModal').style.display = 'none';
    document.getElementById('editExpenseOverlay').style.display = 'none';
}
</script>

<%- include('partials/footer') %>
