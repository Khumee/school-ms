<%- include('partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title" style="margin: 0;"><i class="bi bi-receipt-cutoff"></i> Other Fees Management</h1>
    <div style="display: flex; gap: 0.75rem;">
        <button type="button" class="btn-primary" onclick="openOtherFeeModal()" style="display: flex; align-items: center; gap: 0.5rem; background: linear-gradient(135deg, #0284c7, #0369a1); border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; cursor: pointer;">
            <i class="bi bi-plus-square-fill" style="font-size: 1.1rem;"></i> Collect Other Fees
        </button>
    </div>
</div>

<div class="nav-tabs" style="margin-bottom: 1rem;">
    <a href="/fees/other?view=activity&year=<%= activeYear %>" class="nav-tab <%= activeView === 'activity' ? 'active' : '' %>"><i class="bi bi-clock-history"></i> Recent Activity</a>
    <a href="/fees/other?view=campaigns&year=<%= activeYear %>" class="nav-tab <%= activeView === 'campaigns' ? 'active' : '' %>"><i class="bi bi-bullseye"></i> Fee Campaigns (Exams, Events)</a>
</div>

<% if (activeView === 'activity') { %>

<form action="/fees/other" method="GET" class="filter-bar">
    <div class="form-group">
        <label for="classId">Filter by Class</label>
        <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
            <option value="">All Classes</option>
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= (locals.classId && locals.classId == c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="year">Year</label>
        <select name="year" id="year" class="form-control" onchange="this.form.submit()">
            <% const currY = new Date().getFullYear(); for(let y = 2024; y <= currY; y++) { %>
                <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
            <% } %>
        </select>
    </div>
    <div class="form-group" style="flex: 2;">
        <label for="search">Search</label>
        <div style="display: flex; gap: 0.5rem;">
            <input type="text" name="search" id="search" class="form-control" placeholder="Name/RegNo..." value="<%= locals.search || '' %>">
            <button type="submit" class="btn-primary" style="white-space: nowrap;"><i class="bi bi-search"></i> Search</button>
            <a href="/fees/other" class="btn-secondary" style="display: inline-flex; align-items: center; white-space: nowrap;">Reset</a>
        </div>
    </div>
</form>

<div style="margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <div style="display: flex; gap: 1.5rem; align-items: center;">
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="all" checked onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> All Students
        </label>
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="paid" onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> Paid Other Fees
        </label>
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="unpaid" onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> No Other Fees
        </label>
    </div>
    <div style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">
        Showing <%= students.length %> students
    </div>
</div>

<div class="table-container">
    <table class="simple-ledger-table" id="other-fees-grid-table">
        <thead>
            <tr>
                <th style="text-align: left;">Reg No</th>
                <th style="text-align: left;">Student Name</th>
                <th style="text-align: left;">Class</th>
                <th style="text-align: left;">Other Fees</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (students.length > 0) { %>
                <% students.forEach(s => { 
                    const sOtherPayments = locals.otherPayments ? otherPayments.filter(op => op.student_id === s.id) : [];
                    const hasOther = sOtherPayments.length > 0;
                %>
                    <tr class="other-student-row <%= hasOther ? 'other-status-paid' : 'other-status-unpaid' %>">
                        <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                        <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= s.id %>" style="color: var(--primary-color, #4f46e5); text-decoration: underline; cursor: pointer;"><%= s.name %></a></td>
                        <td style="text-align: left;"><%= s.class_name || 'Unassigned' %></td>
                        <td style="text-align: left;">
                            <% if (hasOther) { %>
                                <button type="button" class="btn-secondary" onclick="openDetailsModal('<%= s.id %>')" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;"><i class="bi bi-list-ul"></i> View Details (<%= sOtherPayments.length %>)</button>
                            <% } else { %>
                                <span style="color: #94a3b8; font-size: 0.85rem;">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (hasOther) { %>
                                <span class="status-cell status-paid"><i class="bi bi-check-circle-fill"></i> PAID</span>
                            <% } else { %>
                                <span class="status-cell status-unpaid" style="background-color: #f1f5f9; color: #64748b;"><i class="bi bi-dash-circle"></i> NONE</span>
                            <% } %>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.4rem; justify-content: center;">
                                <button type="button" class="btn-primary nav-btn" onclick="openOtherFeeModalForStudent('<%= s.id %>')" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;"><i class="bi bi-plus-circle-fill"></i> Collect</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">No students found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Other Fee Payment Modal -->
<div id="otherFeeModal" class="card" style="display: none; max-width: 440px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 0.5rem; color: #0284c7;"><i class="bi bi-receipt-cutoff"></i> Collect Other Fees</h3>
    <p style="margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--muted);">Record non-monthly fees like Exam, Paper, Event, or Sports fees.</p>
    <form action="/fees/pay-other" method="POST">
        <input type="hidden" name="redirect_url" value="/fees/other">
        <div class="form-group" style="margin-bottom: 0.75rem;">
            <label for="otherModalClassFilter">Filter by Class</label>
            <select id="otherModalClassFilter" class="form-control" onchange="filterOtherModalStudents()">
                <option value="">All Classes</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalStudentSearch">Search & Select Student</label>
            <input type="text" id="otherModalStudentSearch" class="form-control" placeholder="Type name or Reg No to search..." onkeyup="filterOtherModalStudents()" style="margin-bottom: 0.5rem;">
            <select id="otherModalStudentId" name="student_id" class="form-control" required style="font-weight: 500;">
                <option value="">-- Choose Student --</option>
                <% students.forEach(s => { %>
                    <option value="<%= s.id %>" data-class-id="<%= s.class_id %>" data-search="<%= s.reg_no.toLowerCase() %> <%= s.name.toLowerCase() %>"><%= s.reg_no %> - <%= s.name %> (<%= s.class_name || 'No Class' %>)</option>
                <% }) %>
            </select>
        </div>

        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label for="otherModalFeeType">Fee Type</label>
                <select id="otherModalFeeType" name="fee_type" class="form-control" onchange="toggleOtherFeeDesc()">
                    <option value="Exam Fee">Exam Fee</option>
                    <option value="Paper Fund">Paper Fund</option>
                    <option value="Sports Fee">Sports Fee</option>
                    <option value="Event Fee">Event Fee</option>
                    <option value="Admission Fee">Admission Fee</option>
                    <option value="Custom">Custom / Other...</option>
                </select>
            </div>
            <div class="form-group" id="otherModalDescGroup" style="display: none;">
                <label for="otherModalDesc">Custom Description</label>
                <input type="text" id="otherModalDesc" name="additional_fee_description" class="form-control" placeholder="e.g. Fine, ID Card">
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalAmount">Amount (PKR)</label>
            <input type="number" step="0.01" id="otherModalAmount" name="amount" class="form-control" required>
        </div>

        <input type="hidden" name="month" value="13">
        <input type="hidden" name="year" value="<%= activeYear %>">

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalPaymentDate">Payment Date</label>
            <input type="date" id="otherModalPaymentDate" name="payment_date" class="form-control" value="<%= new Date().toISOString().substring(0, 10) %>">
        </div>
        
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeOtherFeeModal()">Cancel</button>
            <button type="submit" class="btn-primary" style="background: linear-gradient(135deg, #0284c7, #0369a1); border: none;">Save Other Fee</button>
        </div>
    </form>
</div>
<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeOtherFeeModal(); closeDetailsModal(); closeEditOtherFeeModal(); closeCampaignModal();"></div>

<!-- Details Modal -->
<div id="detailsModal" class="card" style="display: none; max-width: 500px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0; color: #0284c7;"><i class="bi bi-card-list"></i> Other Fees Details</h3>
        <button type="button" onclick="closeDetailsModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>
    <div id="detailsModalContent">
        <!-- Content injected via JS -->
    </div>
</div>

<!-- Edit Other Fee Modal -->
<div id="editOtherFeeModal" class="card" style="display: none; max-width: 440px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1001; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 0.5rem; color: #0284c7;"><i class="bi bi-pencil-square"></i> Edit Fee</h3>
    <form id="editOtherFeeForm" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Amount (PKR)</label>
            <input type="number" step="0.01" id="editModalAmount" name="amount" class="form-control" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Description</label>
            <input type="text" id="editModalDesc" name="additional_fee_description" class="form-control" required>
            <input type="hidden" name="fee_type" value="Custom">
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Payment Date</label>
            <input type="date" id="editModalPaymentDate" name="payment_date" class="form-control" required>
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeEditOtherFeeModal()">Cancel</button>
            <button type="submit" class="btn-primary">Update Fee</button>
        </div>
    </form>
</div>
<% } else if (activeView === 'campaigns') { %>

<% if (!locals.activeCampaign) { %>
<!-- Campaigns List -->
<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h2 style="margin: 0;"><i class="bi bi-bullseye"></i> Manage Fee Campaigns</h2>
    <button class="btn-primary" onclick="openCampaignModal()"><i class="bi bi-plus-circle"></i> Create Campaign</button>
</div>

<div class="table-container">
    <table class="simple-ledger-table">
        <thead>
            <tr>
                <th style="text-align: left;">Campaign Title</th>
                <th style="text-align: left;">Fee Type</th>
                <th>Default Amount</th>
                <th>Applicable To</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (campaigns && campaigns.length > 0) { %>
                <% campaigns.forEach(c => { %>
                    <tr style="<%= c.is_active ? '' : 'opacity: 0.6;' %>">
                        <td style="font-weight: 600; text-align: left;">
                            <%= c.title %>
                            <% if (!c.is_active) { %>
                                <span style="font-size: 0.75rem; background: #cbd5e1; color: #334155; padding: 2px 6px; border-radius: 4px; margin-left: 0.5rem;">Closed</span>
                            <% } %>
                        </td>
                        <td style="text-align: left;"><span style="background: #e0f2fe; color: #0369a1; padding: 2px 6px; border-radius: 4px; font-size: 0.85rem;"><%= c.fee_type %></span></td>
                        <td>PKR <%= parseFloat(c.default_amount).toLocaleString() %></td>
                        <td>
                            <% if (c.applicable_to_all) { %>
                                <span class="status-cell status-paid">All Students</span>
                            <% } else if (c.applicable_to_class_all) { %>
                                <span class="status-cell" style="background: #fef08a; color: #854d0e;">Class ID: <%= c.class_id %> (All)</span>
                            <% } else { %>
                                <span class="status-cell" style="background: #e2e8f0; color: #475569;">Specific Students</span>
                            <% } %>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <a href="/fees/other?view=campaigns&campaign_id=<%= c.id %>" class="btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.85rem; display: inline-block; text-decoration: none;"><i class="bi bi-eye"></i> Track Payments</a>
                                <button type="button" class="btn-secondary" onclick="openEditCampaignModal('<%= c.id %>', '<%= c.title.replace(/'/g, "\\'") %>', '<%= c.fee_type %>', <%= c.default_amount %>)" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form action="/fees/campaigns/<%= c.id %>/toggle" method="POST" style="margin: 0;">
                                    <button type="submit" class="btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;">
                                        <% if (c.is_active) { %>
                                            <i class="bi bi-lock-fill"></i> Close
                                        <% } else { %>
                                            <i class="bi bi-unlock-fill"></i> Re-open
                                        <% } %>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">No campaigns found for <%= activeYear %>.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<% } else { %>
<!-- Campaign Tracker -->
<div class="section-header" style="margin-bottom: 1.5rem;">
    <a href="/fees/other?view=campaigns&year=<%= activeYear %>" style="text-decoration: none; color: var(--primary-color); margin-bottom: 0.5rem; display: inline-block;"><i class="bi bi-arrow-left"></i> Back to Campaigns</a>
    <h2 style="margin: 0;"><i class="bi bi-bullseye"></i> Tracking: <%= activeCampaign.title %></h2>
    <p style="color: var(--muted); margin: 0.5rem 0 0;">Default Amount: PKR <%= parseFloat(activeCampaign.default_amount).toLocaleString() %></p>
</div>

<div class="table-container">
    <table class="simple-ledger-table">
        <thead>
            <tr>
                <th style="text-align: left;">Reg No</th>
                <th style="text-align: left;">Student Name</th>
                <th style="text-align: left;">Class</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (students.length > 0) { %>
                <% students.forEach(s => { 
                    const sCampaignPayments = otherPayments.filter(op => op.student_id === s.id && op.campaign_id === activeCampaign.id);
                    const hasPaid = sCampaignPayments.length > 0;
                %>
                    <tr class="tracker-row <%= hasPaid ? 'tracker-status-paid' : 'tracker-status-unpaid' %>" data-class="<%= s.class_name || 'Unassigned' %>" data-search="<%= s.reg_no.toLowerCase() %> <%= s.name.toLowerCase() %>">
                        <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                        <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= s.id %>"><%= s.name %></a></td>
                        <td style="text-align: left;"><%= s.class_name || 'Unassigned' %></td>
                        <td>
                            <% if (hasPaid) { %>
                                <span class="status-cell status-paid"><i class="bi bi-check-circle-fill"></i> PAID</span>
                            <% } else { %>
                                <span class="status-cell status-unpaid" style="background-color: #fee2e2; color: #991b1b;"><i class="bi bi-x-circle-fill"></i> UNPAID</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (hasPaid) { %>
                                <form action="/fees/campaigns/<%= activeCampaign.id %>/unpay/<%= s.id %>" method="POST" style="margin: 0; display: inline-block;">
                                    <button type="submit" class="btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.85rem; color: #991b1b; border-color: #fca5a5; background: #fef2f2;"><i class="bi bi-arrow-counterclockwise"></i> Unpay</button>
                                </form>
                            <% } else { %>
                                <form action="/fees/campaigns/<%= activeCampaign.id %>/pay/<%= s.id %>" method="POST" style="margin: 0; display: inline-block;">
                                    <button type="submit" class="btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.85rem; background: #16a34a; border-color: #16a34a;"><i class="bi bi-check2-circle"></i> Quick Pay</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">No students targeted by this campaign.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<% } %>

<!-- Create Campaign Modal -->
<div id="createCampaignModal" class="card" style="display: none; max-width: 500px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 0.5rem; color: #0284c7;"><i class="bi bi-bullseye"></i> Create Fee Campaign</h3>
    <form action="/fees/campaigns" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Campaign Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Midterm Exams 2026" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Fee Type</label>
            <select name="fee_type" class="form-control">
                <option value="Exam Fee">Exam Fee</option>
                <option value="Paper Fund">Paper Fund</option>
                <option value="Sports Fee">Sports Fee</option>
                <option value="Event Fee">Event Fee</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Default Amount (PKR)</label>
            <input type="number" step="0.01" name="default_amount" class="form-control" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem; background: #f8fafc; padding: 1rem; border-radius: 6px; border: 1px solid #e2e8f0;">
            <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer;">
                <input type="checkbox" name="applicable_to_all" id="campaignAllCheckbox" checked onchange="toggleCampaignClassSelect()"> Applicable to All Students
            </label>
            
            <div id="campaignClassSelection" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #cbd5e1;">
                <div class="form-group">
                    <label>Select Target Class</label>
                    <select name="class_id" class="form-control">
                        <% classes.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.name %></option>
                        <% }) %>
                    </select>
                </div>
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; margin-top: 0.5rem;">
                    <input type="checkbox" name="applicable_to_class_all" checked> Applicable to All Students in Class
                </label>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">(Uncheck to select specific students later)</p>
            </div>
        </div>
        <input type="hidden" name="year" value="<%= activeYear %>">
        <input type="hidden" name="month" value="13">
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeCampaignModal()">Cancel</button>
            <button type="submit" class="btn-primary">Create Campaign</button>
        </div>
    </form>
</div>

<!-- Edit Campaign Modal -->
<div id="editCampaignModal" class="card" style="display: none; max-width: 500px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 0.5rem; color: #0284c7;"><i class="bi bi-pencil-square"></i> Edit Fee Campaign</h3>
    <form id="editCampaignForm" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Campaign Title</label>
            <input type="text" id="editCampaignTitle" name="title" class="form-control" required>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Fee Type</label>
            <select id="editCampaignFeeType" name="fee_type" class="form-control">
                <option value="Exam Fee">Exam Fee</option>
                <option value="Paper Fund">Paper Fund</option>
                <option value="Sports Fee">Sports Fee</option>
                <option value="Event Fee">Event Fee</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Default Amount (PKR)</label>
            <input type="number" step="0.01" id="editCampaignAmount" name="default_amount" class="form-control" required>
        </div>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeEditCampaignModal()">Cancel</button>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>
<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeOtherFeeModal(); closeDetailsModal(); closeEditOtherFeeModal(); closeCampaignModal(); closeEditCampaignModal();"></div>

<% } %>

<script>
    function openOtherFeeModalForStudent(studentId) {
        openOtherFeeModal(studentId);
    }

    function openOtherFeeModal(studentId = null) {
        if (studentId) {
            document.getElementById('otherModalStudentId').value = studentId;
        } else {
            document.getElementById('otherModalStudentId').value = '';
        }
        document.getElementById('otherModalFeeType').value = 'Exam Fee';
        document.getElementById('otherModalAmount').value = '';
        document.getElementById('otherModalDesc').value = '';
        document.getElementById('otherFeeModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeOtherFeeModal() {
        document.getElementById('otherFeeModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }

    function openEditCampaignModal(id, title, type, amount) {
        document.getElementById('editCampaignForm').action = '/fees/campaigns/' + id + '/edit';
        document.getElementById('editCampaignTitle').value = title;
        document.getElementById('editCampaignFeeType').value = type;
        document.getElementById('editCampaignAmount').value = amount;
        
        document.getElementById('editCampaignModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeEditCampaignModal() {
        document.getElementById('editCampaignModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }

    function filterOtherModalStudents() {
        const classFilter = document.getElementById('otherModalClassFilter').value;
        const searchStr = document.getElementById('otherModalStudentSearch').value.toLowerCase().trim();
        const select = document.getElementById('otherModalStudentId');
        
        let firstVisible = null;
        
        for (let i = 1; i < select.options.length; i++) { // Skip index 0 (Choose Student)
            const opt = select.options[i];
            const optClass = opt.getAttribute('data-class-id');
            const optSearch = opt.getAttribute('data-search');
            
            const matchClass = !classFilter || optClass === classFilter;
            const matchSearch = !searchStr || optSearch.includes(searchStr);
            
            if (matchClass && matchSearch) {
                opt.style.display = '';
                if (!firstVisible) firstVisible = opt;
            } else {
                opt.style.display = 'none';
            }
        }
        
        const currentSelected = select.options[select.selectedIndex];
        if (currentSelected && currentSelected.style.display === 'none') {
            select.value = '';
        }
    }

    function toggleOtherFeeDesc() {
        const type = document.getElementById('otherModalFeeType').value;
        const descGroup = document.getElementById('otherModalDescGroup');
        if (type === 'Custom') {
            descGroup.style.display = 'block';
        } else {
            descGroup.style.display = 'none';
        }
    }

    function filterOtherFeesGrid(status) {
        const rows = document.querySelectorAll('#other-fees-grid-table tbody tr.other-student-row');
        rows.forEach(row => {
            if (status === 'all') {
                row.style.display = '';
            } else if (status === 'paid') {
                if (row.classList.contains('other-status-paid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (status === 'unpaid') {
                if (row.classList.contains('other-status-unpaid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }

    // Embed all other payments into JS for the details modal
    const allOtherPayments = <%- JSON.stringify(locals.otherPayments || []) %>;
    
    function openDetailsModal(studentId) {
        const studentPayments = allOtherPayments.filter(op => op.student_id == studentId);
        let html = '<div style="display: flex; flex-direction: column; gap: 0.75rem;">';
        
        if (studentPayments.length === 0) {
            html += '<p style="color: #64748b;">No fees found.</p>';
        } else {
            studentPayments.forEach(op => {
                const amount = (parseFloat(op.amount_paid) > 0 ? parseFloat(op.amount_paid) : parseFloat(op.additional_fee || 0)).toLocaleString();
                const desc = op.additional_fee_description || 'Other Fee';
                const date = new Date(op.payment_date).toLocaleDateString();
                html += `
                    <div style="display: flex; align-items: center; justify-content: space-between; background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 6px;">
                        <div>
                            <div style="color: #0f172a; font-weight: 600; margin-bottom: 0.25rem;">${desc}</div>
                            <div style="color: #64748b; font-size: 0.85rem;"><i class="bi bi-calendar3"></i> ${date}</div>
                        </div>
                        <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
                            <div style="color: #059669; font-weight: 700;">PKR ${amount}</div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="btn-secondary" onclick="openEditOtherFeeModal('${op.id}', ${op.amount_paid > 0 ? op.amount_paid : op.additional_fee}, '${desc}', '${op.payment_date.substring(0, 10)}')" style="padding: 0.1rem 0.3rem; font-size: 0.75rem;"><i class="bi bi-pencil"></i></button>
                                <a href="/fees/receipt/${op.id}" target="_blank" style="color: #0284c7; text-decoration: none; font-size: 0.85rem;"><i class="bi bi-printer"></i> Receipt</a>
                            </div>
                        </div>
                    </div>
                `;
            });
        }
        
        html += '</div>';
        document.getElementById('detailsModalContent').innerHTML = html;
        document.getElementById('detailsModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeDetailsModal() {
        document.getElementById('detailsModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }

    function openEditOtherFeeModal(paymentId, amount, desc, date) {
        document.getElementById('editOtherFeeForm').action = '/fees/pay-other/edit/' + paymentId;
        document.getElementById('editModalAmount').value = amount;
        document.getElementById('editModalDesc').value = desc;
        document.getElementById('editModalPaymentDate').value = date;
        
        closeDetailsModal();
        document.getElementById('editOtherFeeModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeEditOtherFeeModal() {
        document.getElementById('editOtherFeeModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }
    
    function toggleCampaignClassSelect() {
        const isAll = document.getElementById('campaignAllCheckbox').checked;
        const panel = document.getElementById('campaignClassSelection');
        panel.style.display = isAll ? 'none' : 'block';
    }

    function openCampaignModal() {
        document.getElementById('createCampaignModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeCampaignModal() {
        document.getElementById('createCampaignModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }
    
    function openCampaignCollectModal(studentId, campaignId, defaultAmount, feeType) {
        document.getElementById('otherModalStudentId').value = studentId;
        // Find existing campaign hidden input or create it
        let campaignInput = document.getElementById('otherModalCampaignId');
        if (!campaignInput) {
            campaignInput = document.createElement('input');
            campaignInput.type = 'hidden';
            campaignInput.id = 'otherModalCampaignId';
            campaignInput.name = 'campaign_id';
            document.querySelector('#otherFeeModal form').appendChild(campaignInput);
        }
        campaignInput.value = campaignId;
        
        // Auto-fill redirect
        let redirectInput = document.querySelector('#otherFeeModal form input[name="redirect_url"]');
        redirectInput.value = `/fees/other?view=campaigns&campaign_id=${campaignId}&year=<%= activeYear %>`;

        document.getElementById('otherModalFeeType').value = 'Custom';
        toggleOtherFeeDesc();
        document.getElementById('otherModalDesc').value = feeType;
        document.getElementById('otherModalAmount').value = defaultAmount;
        document.getElementById('otherFeeModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function filterCampaignTracker() {
        const filterVal = document.querySelector('input[name="trackerFilter"]:checked').value;
        const classFilter = document.getElementById('trackerClassFilter').value;
        const searchStr = document.getElementById('trackerSearch').value.toLowerCase().trim();
        const rows = document.querySelectorAll('#tracker-table tbody tr.tracker-row');
        
        rows.forEach(row => {
            const isPaid = row.classList.contains('tracker-status-paid');
            const rowClass = row.getAttribute('data-class');
            const rowSearch = row.getAttribute('data-search');
            
            const matchStatus = (filterVal === 'all') || 
                                (filterVal === 'paid' && isPaid) || 
                                (filterVal === 'unpaid' && !isPaid);
            const matchClass = !classFilter || rowClass === classFilter;
            const matchSearch = !searchStr || rowSearch.includes(searchStr);
            
            if (matchStatus && matchClass && matchSearch) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>

<%- include('partials/footer') %>
