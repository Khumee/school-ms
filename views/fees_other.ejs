<%- include('partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title" style="margin: 0;"><i class="bi bi-receipt-cutoff"></i> Other Fees Management</h1>
    <div style="display: flex; gap: 0.75rem;">
        <button type="button" class="btn-primary" onclick="openOtherFeeModal()" style="display: flex; align-items: center; gap: 0.5rem; background: linear-gradient(135deg, #0284c7, #0369a1); border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; cursor: pointer;">
            <i class="bi bi-plus-square-fill" style="font-size: 1.1rem;"></i> Collect Other Fees
        </button>
    </div>
</div>

<form action="/fees/other" method="GET" class="filter-bar">
    <div class="form-group">
        <label for="classId">Filter by Class</label>
        <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
            <option value="">All Classes</option>
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= (locals.classId && locals.classId == c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="year">Year</label>
        <select name="year" id="year" class="form-control" onchange="this.form.submit()">
            <% const currY = new Date().getFullYear(); for(let y = 2024; y <= currY; y++) { %>
                <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
            <% } %>
        </select>
    </div>
    <div class="form-group" style="flex: 2;">
        <label for="search">Search</label>
        <div style="display: flex; gap: 0.5rem;">
            <input type="text" name="search" id="search" class="form-control" placeholder="Name/RegNo..." value="<%= locals.search || '' %>">
            <button type="submit" class="btn-primary" style="white-space: nowrap;"><i class="bi bi-search"></i> Search</button>
            <a href="/fees/other" class="btn-secondary" style="display: inline-flex; align-items: center; white-space: nowrap;">Reset</a>
        </div>
    </div>
</form>

<div style="margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
    <div style="display: flex; gap: 1.5rem; align-items: center;">
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="all" checked onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> All Students
        </label>
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="paid" onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> Paid Other Fees
        </label>
        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; color: var(--ink);">
            <input type="radio" name="otherFeeFilter" value="unpaid" onchange="filterOtherFeesGrid(this.value)" style="cursor: pointer;"> No Other Fees
        </label>
    </div>
    <div style="font-size: 0.85rem; color: var(--muted); font-weight: 600;">
        Showing <%= students.length %> students
    </div>
</div>

<div class="table-container">
    <table class="simple-ledger-table" id="other-fees-grid-table">
        <thead>
            <tr>
                <th style="text-align: left;">Reg No</th>
                <th style="text-align: left;">Student Name</th>
                <th style="text-align: left;">Class</th>
                <th style="text-align: left;">Other Fees</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (students.length > 0) { %>
                <% students.forEach(s => { 
                    const sOtherPayments = locals.otherPayments ? otherPayments.filter(op => op.student_id === s.id) : [];
                    const hasOther = sOtherPayments.length > 0;
                %>
                    <tr class="other-student-row <%= hasOther ? 'other-status-paid' : 'other-status-unpaid' %>">
                        <td style="font-weight: 600; text-align: left;"><%= s.reg_no %></td>
                        <td style="text-align: left; font-weight: 500;"><a href="/students/view/<%= s.id %>" style="color: var(--primary-color, #4f46e5); text-decoration: underline; cursor: pointer;"><%= s.name %></a></td>
                        <td style="text-align: left;"><%= s.class_name || 'Unassigned' %></td>
                        <td style="text-align: left;">
                            <% if (hasOther) { %>
                                <button type="button" class="btn-secondary" onclick="openDetailsModal('<%= s.id %>')" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;"><i class="bi bi-list-ul"></i> View Details (<%= sOtherPayments.length %>)</button>
                            <% } else { %>
                                <span style="color: #94a3b8; font-size: 0.85rem;">-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (hasOther) { %>
                                <span class="status-cell status-paid"><i class="bi bi-check-circle-fill"></i> PAID</span>
                            <% } else { %>
                                <span class="status-cell status-unpaid" style="background-color: #f1f5f9; color: #64748b;"><i class="bi bi-dash-circle"></i> NONE</span>
                            <% } %>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.4rem; justify-content: center;">
                                <button type="button" class="btn-primary nav-btn" onclick="openOtherFeeModalForStudent('<%= s.id %>')" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;"><i class="bi bi-plus-circle-fill"></i> Collect</button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">No students found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Other Fee Payment Modal -->
<div id="otherFeeModal" class="card" style="display: none; max-width: 440px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <h3 style="margin-bottom: 0.5rem; color: #0284c7;"><i class="bi bi-receipt-cutoff"></i> Collect Other Fees</h3>
    <p style="margin-bottom: 1.25rem; font-size: 0.85rem; color: var(--muted);">Record non-monthly fees like Exam, Paper, Event, or Sports fees.</p>
    <form action="/fees/pay-other" method="POST">
        <input type="hidden" name="redirect_url" value="/fees/other">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalStudentId">Select Student</label>
            <select id="otherModalStudentId" name="student_id" class="form-control" required style="font-weight: 500;">
                <option value="">-- Choose Student --</option>
                <% students.forEach(s => { %>
                    <option value="<%= s.id %>"><%= s.reg_no %> - <%= s.name %> (<%= s.class_name || 'No Class' %>)</option>
                <% }) %>
            </select>
        </div>

        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label for="otherModalFeeType">Fee Type</label>
                <select id="otherModalFeeType" name="fee_type" class="form-control" onchange="toggleOtherFeeDesc()">
                    <option value="Exam Fee">Exam Fee</option>
                    <option value="Paper Fund">Paper Fund</option>
                    <option value="Sports Fee">Sports Fee</option>
                    <option value="Event Fee">Event Fee</option>
                    <option value="Admission Fee">Admission Fee</option>
                    <option value="Custom">Custom / Other...</option>
                </select>
            </div>
            <div class="form-group" id="otherModalDescGroup" style="display: none;">
                <label for="otherModalDesc">Custom Description</label>
                <input type="text" id="otherModalDesc" name="additional_fee_description" class="form-control" placeholder="e.g. Fine, ID Card">
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalAmount">Amount (PKR)</label>
            <input type="number" step="0.01" id="otherModalAmount" name="amount" class="form-control" required>
        </div>

        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label for="otherModalMonth">Record For Month</label>
                <select id="otherModalMonth" name="month" class="form-control">
                    <option value="13">N/A (General)</option>
                    <option value="0">0 - Admission</option>
                    <option value="1">1 - January</option>
                    <option value="2">2 - February</option>
                    <option value="3">3 - March</option>
                    <option value="4">4 - April</option>
                    <option value="5">5 - May</option>
                    <option value="6">6 - June</option>
                    <option value="7">7 - July</option>
                    <option value="8">8 - August</option>
                    <option value="9">9 - September</option>
                    <option value="10">10 - October</option>
                    <option value="11">11 - November</option>
                    <option value="12">12 - December</option>
                </select>
            </div>
            <div class="form-group">
                <label for="otherModalYear">Record For Year</label>
                <select id="otherModalYear" name="year" class="form-control">
                    <% const otherCurrY = new Date().getFullYear(); for(let y = 2024; y <= otherCurrY; y++) { %>
                        <option value="<%= y %>" <%= activeYear == y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="otherModalPaymentDate">Payment Date</label>
            <input type="date" id="otherModalPaymentDate" name="payment_date" class="form-control" value="<%= new Date().toISOString().substring(0, 10) %>">
        </div>
        
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeOtherFeeModal()">Cancel</button>
            <button type="submit" class="btn-primary" style="background: linear-gradient(135deg, #0284c7, #0369a1); border: none;">Save Other Fee</button>
        </div>
    </form>
</div>
<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeOtherFeeModal(); closeDetailsModal();"></div>

<!-- Details Modal -->
<div id="detailsModal" class="card" style="display: none; max-width: 500px; margin: 0; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0; color: #0284c7;"><i class="bi bi-card-list"></i> Other Fees Details</h3>
        <button type="button" onclick="closeDetailsModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b;">&times;</button>
    </div>
    <div id="detailsModalContent">
        <!-- Content injected via JS -->
    </div>
</div>

<script>
    function openOtherFeeModalForStudent(studentId) {
        openOtherFeeModal(studentId);
    }

    function openOtherFeeModal(studentId = null) {
        if (studentId) {
            document.getElementById('otherModalStudentId').value = studentId;
        } else {
            document.getElementById('otherModalStudentId').value = '';
        }
        document.getElementById('otherModalFeeType').value = 'Exam Fee';
        document.getElementById('otherModalAmount').value = '';
        document.getElementById('otherModalDesc').value = '';
        document.getElementById('otherFeeModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeOtherFeeModal() {
        document.getElementById('otherFeeModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }

    function toggleOtherFeeDesc() {
        const type = document.getElementById('otherModalFeeType').value;
        const descGroup = document.getElementById('otherModalDescGroup');
        if (type === 'Custom') {
            descGroup.style.display = 'block';
        } else {
            descGroup.style.display = 'none';
        }
    }

    function filterOtherFeesGrid(status) {
        const rows = document.querySelectorAll('#other-fees-grid-table tbody tr.other-student-row');
        rows.forEach(row => {
            if (status === 'all') {
                row.style.display = '';
            } else if (status === 'paid') {
                if (row.classList.contains('other-status-paid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            } else if (status === 'unpaid') {
                if (row.classList.contains('other-status-unpaid')) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }

    // Embed all other payments into JS for the details modal
    const allOtherPayments = <%- JSON.stringify(locals.otherPayments || []) %>;
    
    function openDetailsModal(studentId) {
        const studentPayments = allOtherPayments.filter(op => op.student_id == studentId);
        let html = '<div style="display: flex; flex-direction: column; gap: 0.75rem;">';
        
        if (studentPayments.length === 0) {
            html += '<p style="color: #64748b;">No fees found.</p>';
        } else {
            studentPayments.forEach(op => {
                const amount = (parseFloat(op.amount_paid) > 0 ? parseFloat(op.amount_paid) : parseFloat(op.additional_fee || 0)).toLocaleString();
                const desc = op.additional_fee_description || 'Other Fee';
                const date = new Date(op.payment_date).toLocaleDateString();
                html += `
                    <div style="display: flex; align-items: center; justify-content: space-between; background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 6px;">
                        <div>
                            <div style="color: #0f172a; font-weight: 600; margin-bottom: 0.25rem;">${desc}</div>
                            <div style="color: #64748b; font-size: 0.85rem;"><i class="bi bi-calendar3"></i> ${date}</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="color: #059669; font-weight: 700; margin-bottom: 0.25rem;">PKR ${amount}</div>
                            <a href="/fees/receipt/${op.id}" target="_blank" style="color: #0284c7; text-decoration: none; font-size: 0.85rem;"><i class="bi bi-printer"></i> Receipt</a>
                        </div>
                    </div>
                `;
            });
        }
        
        html += '</div>';
        document.getElementById('detailsModalContent').innerHTML = html;
        document.getElementById('detailsModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }

    function closeDetailsModal() {
        document.getElementById('detailsModal').style.display = 'none';
        document.getElementById('modalOverlay').style.display = 'none';
    }
</script>

<%- include('partials/footer') %>
