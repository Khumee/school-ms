<%- include('partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title"><i class="bi bi-person-plus-fill"></i> New Student Admission</h1>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <% if (tenant.feature_ocr_student) { %>
        <span id="header_scan_status" style="font-size: 0.9rem; color: #64748b; display: none;"><i class="bi bi-hourglass-split"></i> AI Processing...</span>
        <button type="button" id="header_scan_btn" class="btn-primary" onclick="openScanModal()" style="background-color: #4f46e5; border-color: #4f46e5;"><i class="bi bi-magic"></i> Auto-fill via Form Scan</button>
        <% } %>
        <a href="/students" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Directory</a>
    </div>
</div>
    <!-- scan inputs live inside the modal below to avoid duplicate IDs -->

<% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>



<div class="card">
    <form action="/students/add" method="POST" enctype="multipart/form-data" onsubmit="return handlePhotoCompress(event)">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color);">1. Academic & Admission Information</h3>
        
        <!-- Photo Upload -->
        <div style="margin-bottom: 1.5rem; background-color: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 80px; height: 80px; background-color: #cbd5e1; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white;">
                <i class="bi bi-person-fill" style="font-size: 2.5rem;"></i>
            </div>
            <div style="flex: 1;">
                <label style="font-weight: 600; margin-bottom: 0.5rem; display: block;">Student Profile Photo</label>
                <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                    <label style="position:relative; display:inline-block; cursor:pointer;">
                        <span class="btn-secondary" style="font-size: 0.85rem; display:inline-block;"><i class="bi bi-folder2-open"></i> Upload File</span>
                        <input type="file" name="photo" id="photo_input" accept="image/*" style="position:absolute; opacity:0; inset:0; width:100%; height:100%; cursor:pointer;" onchange="document.getElementById('photo_selected_text').innerText = this.files[0] ? this.files[0].name : 'No photo selected'">
                    </label>
                </div>
                <div id="photo_selected_text" style="font-size: 0.85rem; color: #64748b;">No photo selected</div>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label for="reg_no">Registration / Roll Number *</label>
                <input type="text" id="reg_no" name="reg_no" class="form-control" required placeholder="e.g. MIS-201">
            </div>
            
            <div class="form-group">
                <label for="class_id">Class</label>
                <select name="class_id" id="class_id" class="form-control">
                    <option value="">-- Select Class --</option>
                    <% classes.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="form-group">
                <label for="date_of_admission">Admission Date</label>
                <input type="date" id="date_of_admission" name="date_of_admission" class="form-control">
            </div>
            
            <div class="form-group">
                <label for="status">Status</label>
                <select name="status" id="status" class="form-control">
                    <option value="active">Active</option>
                    <option value="left">Left</option>
                    <option value="graduated">Graduated</option>
                </select>
            </div>
        </div>

        <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-color);">2. Personal Information</h3>
        <div class="form-grid">
            <div class="form-group">
                <label for="name">Student Full Name *</label>
                <input type="text" id="name" name="name" class="form-control" required placeholder="e.g. Ahmed Ali">
            </div>
            
            <div class="form-group">
                <label for="gender">Gender</label>
                <select name="gender" id="gender" class="form-control">
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="date_of_birth">Date of Birth</label>
                <input type="date" id="date_of_birth" name="date_of_birth" class="form-control">
            </div>
            
            <div class="form-group">
                <label for="blood_group">Blood Group</label>
                <input type="text" id="blood_group" name="blood_group" class="form-control" placeholder="e.g. O+">
            </div>
        </div>

        <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-color);">3. Family & Contact Details</h3>
        <div class="form-grid">
            <div class="form-group">
                <label for="father_name">Father / Guardian Name</label>
                <input type="text" id="father_name" name="father_name" class="form-control">
            </div>
            
            <div class="form-group">
                <label for="father_phone">Father / Guardian Phone</label>
                <input type="text" id="father_phone" name="father_phone" class="form-control">
            </div>
            
            <div class="form-group">
                <label for="emergency_contact">Emergency Contact No</label>
                <input type="text" id="emergency_contact" name="emergency_contact" class="form-control">
            </div>
            
            <div class="form-group">
                <label for="previous_school_info">Previous School Details</label>
                <input type="text" id="previous_school_info" name="previous_school_info" class="form-control">
            </div>

            <div class="form-group">
                <label for="family_members">Total Family Members</label>
                <input type="number" id="family_members" name="family_members" class="form-control" min="1">
            </div>

            <div class="form-group">
                <label for="siblings">Total Siblings</label>
                <input type="number" id="siblings" name="siblings" class="form-control" min="0">
            </div>

            <div class="form-group">
                <label for="school_going_siblings">School Going Siblings</label>
                <input type="number" id="school_going_siblings" name="school_going_siblings" class="form-control" min="0">
            </div>

            <div class="form-group">
                <label for="monthly_income">Monthly Income</label>
                <input type="text" id="monthly_income" name="monthly_income" class="form-control" placeholder="e.g. 50000 or Irregular">
            </div>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.5rem;">
            <label for="address">Residential Address</label>
            <textarea id="address" name="address" class="form-control" rows="2"></textarea>
        </div>

        <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-color);">4. One-Time Admission / Registration Fee Details</h3>
        <div class="form-grid" style="margin-bottom: 1.5rem;">
            <div class="form-group">
                <label for="admission_fee">Admission / Registration Fee (One-Time) (PKR)</label>
                <input type="number" step="0.01" id="admission_fee" name="admission_fee" class="form-control" value="0.00">
                <small style="color: var(--muted); font-size: 0.75rem; display: block; margin-top: 0.25rem;">One-time fee charged upon initial student admission.</small>
            </div>
            
            <div class="form-group">
                <label for="admission_fee_status">Admission Fee Status</label>
                <select name="admission_fee_status" id="admission_fee_status" class="form-control" onchange="toggleAdmissionPaymentDate(this.value)">
                    <option value="unpaid">Unpaid</option>
                    <option value="paid">Paid</option>
                    <option value="waived">Waived</option>
                </select>
            </div>
            
            <div class="form-group" id="admission_payment_date_group" style="display: none;">
                <label for="admission_fee_payment_date">Payment Date</label>
                <input type="date" id="admission_fee_payment_date" name="admission_fee_payment_date" class="form-control">
            </div>
        </div>

        <div id="concession_settings_section">
            <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-color);">5. Tuition Fee Concession Settings</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label>Class Standard Fee (PKR)</label>
                    <input type="text" id="class_fee_display" class="form-control" readonly value="N/A" style="background-color: #f1f5f9;">
                </div>

                <div class="form-group">
                    <label for="custom_monthly_fee">Concession Amount (PKR)</label>
                    <input type="number" step="0.01" id="custom_monthly_fee" name="custom_monthly_fee" class="form-control" placeholder="0.00" value="0">
                </div>
                
                <div class="form-group">
                    <label for="concession_reason">Concession Reason</label>
                    <select name="concession_reason" id="concession_reason" class="form-control">
                        <option value="Low Income">Low Income</option>
                        <option value="No Income">No Income</option>
                        <option value="Irregular income">Irregular income</option>
                        <option value="Orphan">Orphan</option>
                    </select>
                </div>
                
                <div class="form-group" style="grid-column: span 2;">
                    <label for="concession_notes">Concession Notes / Remarks</label>
                    <textarea id="concession_notes" name="concession_notes" class="form-control" rows="4" placeholder="e.g. Welfare support, Staff discount"></textarea>
                </div>
            </div>
        </div>

        <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: var(--primary-color);">6. Initial Document Upload (Optional)</h3>
        <div style="background-color: #f8fafc; padding: 1rem; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 1.5rem;">
            <div class="form-grid">
                <div class="form-group">
                    <label for="docType">Document Type</label>
                    <select name="document_type" id="docType" class="form-control">
                        <option value="">-- Select Type --</option>
                        <option value="B-Form">B-Form</option>
                        <option value="Father/Guardian ID Card Front">Father/Guardian ID Card Front</option>
                        <option value="Father/Guardian ID Card Back">Father/Guardian ID Card Back</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="docDesc">Description (Optional)</label>
                    <input type="text" name="document_description" id="docDesc" class="form-control" placeholder="E.g., Father's ID Card Front">
                </div>
                
                <div class="form-group" style="grid-column: span 2;">
                    <label>File (Upload)</label>
                    <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <label style="position:relative; display:inline-block; cursor:pointer;">
                            <span class="btn-secondary" style="font-size: 0.85rem; display:inline-block;"><i class="bi bi-folder2-open"></i> Upload File</span>
                            <input type="file" name="document_file" id="docFile" style="position:absolute; opacity:0; inset:0; width:100%; height:100%; cursor:pointer;" onchange="document.getElementById('docSelectedTextAdd').innerText = this.files[0] ? this.files[0].name : 'No file selected'">
                        </label>
                    </div>
                    <div id="docSelectedTextAdd" style="font-size: 0.85rem; color: #64748b;">No file selected</div>
                </div>
            </div>
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn-primary">Admit Student</button>
            <a href="/students" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<!-- Scan Modal -->
<div id="scanModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 15%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-bottom: 1rem; color: #334155; font-size: 1.1rem;"><i class="bi bi-magic"></i> Auto-fill via Form Scan</h3>
    <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">Upload or take a photo of the handwritten admission form to automatically extract and fill the details.</p>
    
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <!-- Upload File: label wrapping keeps it mobile-safe -->
        <label style="flex:1; position:relative; display:inline-block; cursor:pointer;">
            <span class="btn-secondary" style="display:block; text-align:center; font-size: 0.85rem;"><i class="bi bi-folder2-open"></i> Upload File</span>
            <input type="file" id="scan_image_input" accept="image/*" style="position:absolute; opacity:0; inset:0; width:100%; height:100%; cursor:pointer;" onchange="document.getElementById('scanSelectedText').innerText = this.files[0] ? this.files[0].name : 'No file selected'; if(this.files[0]) { scanForm(this); }">
        </label>
    </div>
    
    <div id="scanSelectedText" style="font-size: 0.85rem; color: #64748b; text-align: center; margin-bottom: 1rem;">No file selected</div>
    
    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
        <button type="button" class="btn-secondary" onclick="closeScanModal()">Cancel</button>
        <button type="button" id="scan_btn" class="btn-primary" onclick="scanForm()"><i class="bi bi-upc-scan"></i> Scan Form</button>
    </div>
    <div id="scan_status" style="font-size: 0.9rem; color: #64748b; display: none; text-align: center; margin-top: 1rem;"><i class="bi bi-hourglass-split"></i> Processing with AI... This may take a few seconds.</div>
</div>
<div id="scanModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeScanModal()"></div>

<!-- Review Extracted Data Modal -->
<div id="reviewModal" class="card" style="display: none; max-width: 600px; margin: 1rem auto; position: fixed; top: 10%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 80vh; overflow-y: auto;">
    <h3 style="margin-bottom: 1rem; color: #334155; font-size: 1.1rem;"><i class="bi bi-check2-circle"></i> Review Extracted Information</h3>
    <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">The AI has extracted the following details. Please review and confirm to populate the admission form.</p>
    
    <div style="margin-bottom: 1rem; text-align: center;">
        <img id="preview_ai_image" src="" style="max-width: 100%; max-height: 150px; border: 1px dashed #4f46e5; border-radius: 4px; cursor: pointer;" title="Click to enlarge"/>
        <button type="button" class="btn btn-primary mt-2" onclick="window.open(document.getElementById('preview_ai_image').src, '_blank');">Enlarge</button>
    </div>


    <div id="review_content" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; font-size: 0.9rem; color: #334155;">
        <!-- Dynamic content goes here -->
    </div>
    
    <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
        <button type="button" class="btn-secondary" onclick="closeReviewModal()">Cancel</button>
        <button type="button" class="btn-primary" onclick="applyExtractedData()"><i class="bi bi-check-lg"></i> Confirm & Populate</button>
    </div>
</div>
<div id="reviewModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeReviewModal()"></div>

<script>
    let pendingExtractedData = null;

    function openReviewModal(data, imageB64) {
        pendingExtractedData = data;
        
        if (imageB64) {
            document.getElementById('preview_ai_image').src = 'data:image/jpeg;base64,' + imageB64;
        }

        let html = '<table style="width: 100%; border-collapse: collapse;">';
        const labels = {
            name: "Student Name", father_name: "Father's Name", father_phone: "Father's Phone",
            emergency_contact: "Emergency Contact", date_of_birth: "Date of Birth",
            address: "Address", gender: "Gender", blood_group: "Blood Group",
            previous_school_info: "Previous School"
        };
        
        for (const [key, value] of Object.entries(data)) {
            let label = labels[key] || key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
            let displayValue = value ? value : '<span style="color:#94a3b8; font-style:italic;">Not found</span>';
            html += `<tr><td style="padding: 0.5rem; border-bottom: 1px solid #e2e8f0; font-weight: 600; width: 40%;">${label}</td><td style="padding: 0.5rem; border-bottom: 1px solid #e2e8f0;">${displayValue}</td></tr>`;
        }
        
        if (Object.keys(data).length === 0) {
            html += `<tr><td colspan="2" style="padding: 1rem; text-align: center; color: #ef4444;">No data could be extracted. The image might be too blurry or not a valid form.</td></tr>`;
        }
        html += '</table>';
        
        document.getElementById('review_content').innerHTML = html;
        document.getElementById('reviewModal').style.display = 'block';
        document.getElementById('reviewModalOverlay').style.display = 'block';
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').style.display = 'none';
        document.getElementById('reviewModalOverlay').style.display = 'none';
        pendingExtractedData = null;
    }

    function applyExtractedData() {
        const json = pendingExtractedData;
        if (!json) return;
        
        if (json.name) document.getElementById('name').value = json.name;
        if (json.father_name) document.getElementById('father_name').value = json.father_name;
        if (json.father_phone) document.getElementById('father_phone').value = json.father_phone;
        if (json.emergency_contact) document.getElementById('emergency_contact').value = json.emergency_contact;
        if (json.date_of_birth) document.getElementById('date_of_birth').value = json.date_of_birth;
        if (json.address) document.getElementById('address').value = json.address;
        if (json.previous_school_info) document.getElementById('previous_school_info').value = json.previous_school_info;
        if (json.blood_group) document.getElementById('blood_group').value = json.blood_group;
        if (json.gender) {
            const g = json.gender.toLowerCase();
            const select = document.getElementById('gender');
            for (let i = 0; i < select.options.length; i++) {
                if (select.options[i].value === g) {
                    select.selectedIndex = i;
                    break;
                }
            }
        }
        
        closeReviewModal();
    }

    function openScanModal() {
        document.getElementById('scanModal').style.display = 'block';
        document.getElementById('scanModalOverlay').style.display = 'block';
    }
    function closeScanModal() {
        document.getElementById('scanModal').style.display = 'none';
        document.getElementById('scanModalOverlay').style.display = 'none';
    }

    const classFees = {
        <% classes.forEach(c => { %>
            "<%= c.id %>": <%= c.default_monthly_fee %>,
        <% }) %>
    };

    const classHifzStatus = {
        <% classes.forEach(c => { %>
            "<%= c.id %>": <%= c.is_hifz_class === 1 || c.is_hifz_class === true ? 'true' : 'false' %>,
        <% }) %>
    };

    const classSelect = document.getElementById('class_id');
    const classFeeDisplay = document.getElementById('class_fee_display');
    const concessionSection = document.getElementById('concession_settings_section');

    function updateClassFee() {
        const classId = classSelect.value;
        if (classId && classFees[classId] !== undefined) {
            classFeeDisplay.value = 'PKR ' + parseFloat(classFees[classId]).toLocaleString();
        } else {
            classFeeDisplay.value = 'N/A';
        }

        if (classId && classHifzStatus[classId] === true) {
            concessionSection.style.display = 'block';
            <% if (default_hifz_fee_waiver) { %>
                document.getElementById('custom_monthly_fee').value = classFees[classId];
            <% } %>
        } else {
            concessionSection.style.display = 'block';
        }
    }

    function toggleAdmissionPaymentDate(status) {
        const dateGroup = document.getElementById('admission_payment_date_group');
        const dateInput = document.getElementById('admission_fee_payment_date');
        if (status === 'paid') {
            dateGroup.style.display = 'block';
            if (!dateInput.value) {
                dateInput.value = new Date().toISOString().substring(0, 10);
            }
        } else {
            dateGroup.style.display = 'none';
        }
    }

    classSelect.addEventListener('change', updateClassFee);
    updateClassFee(); // Run on initial load
    toggleAdmissionPaymentDate(document.getElementById('admission_fee_status').value);
    function scanForm(sourceInput) {
        let file = null;
        if (sourceInput && sourceInput.files && sourceInput.files[0]) {
            file = sourceInput.files[0];
        } else {
            const fileInput = document.getElementById('scan_image_input');
            file = fileInput && fileInput.files && fileInput.files[0];
        }
        if (!file) {
            alert('Please select or capture a photo first.');
            return;
        }
        const btn = document.getElementById('scan_btn');
        const status = document.getElementById('scan_status');
        const headerBtn = document.getElementById('header_scan_btn');
        const headerStatus = document.getElementById('header_scan_status');
        btn.disabled = true;
        status.style.display = 'inline-block';
        if (headerBtn) headerBtn.style.display = 'none';
        if (headerStatus) headerStatus.style.display = 'flex';
        
        const img = new Image();
        const reader = new FileReader();
        reader.onload = function(e) {
            img.onload = function() {
                const canvas = document.createElement('canvas');
                // Use a generous max size for OCR to preserve readability
                const MAX_SIZE = 1500;
                let width = img.width;
                let height = img.height;
                if (width > height && width > MAX_SIZE) {
                    height *= MAX_SIZE / width;
                    width = MAX_SIZE;
                } else if (height > width && height > MAX_SIZE) {
                    width *= MAX_SIZE / height;
                    height = MAX_SIZE;
                }
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                
                const base64 = canvas.toDataURL('image/jpeg', 0.85).split(',')[1];
                // Estimate size based on base64 length (approx 0.75 ratio)
                const fileSize = Math.round(base64.length * 0.75);

                fetch('/students/admission-form/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ image_b64: base64, mime_type: 'image/jpeg', file_size: fileSize })
                })
                .then(res => {
                    const ct = res.headers.get('content-type') || '';
                    if (!ct.includes('application/json')) {
                        throw new Error('Session expired or server error. Please log in again and retry.');
                    }
                    return res.json();
                })
                .then(data => {
                    btn.disabled = false;
                    status.style.display = 'none';
                    if (headerBtn) headerBtn.style.display = 'inline-block';
                    if (headerStatus) headerStatus.style.display = 'none';
                    if (data.error) { alert('Error: ' + data.error); return; }
                    const json = data.data;
                    if (json && Object.keys(json).length > 0) {
                        closeScanModal();
                        openReviewModal(json, base64);
                    } else {
                        alert('Could not extract any data from the image.');
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    status.style.display = 'none';
                    if (headerBtn) headerBtn.style.display = 'inline-block';
                    if (headerStatus) headerStatus.style.display = 'none';
                    alert('An error occurred during scanning: ' + err.message);
                    console.error(err);
                });
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    let isCompressing = false;
    function handlePhotoCompress(event) {
        if (isCompressing) return true;
        
        const fileInput = document.getElementById('photo_input');
        if (fileInput && fileInput.files && fileInput.files.length > 0) {
            event.preventDefault();
            const file = fileInput.files[0];
            
            const img = new Image();
            const reader = new FileReader();
            reader.onload = function(e) {
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 400; // Profile photo doesn't need to be huge
                    const MAX_HEIGHT = 400;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) {
                            height *= MAX_WIDTH / width;
                            width = MAX_WIDTH;
                        }
                    } else {
                        if (height > MAX_HEIGHT) {
                            width *= MAX_HEIGHT / height;
                            height = MAX_HEIGHT;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    canvas.toBlob(function(blob) {
                        const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                            type: 'image/jpeg',
                            lastModified: Date.now()
                        });
                        
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(newFile);
                        fileInput.files = dataTransfer.files;
                        
                        isCompressing = true;
                        event.target.submit();
                    }, 'image/jpeg', 0.85);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
            return false;
        }
        return true;
    }
</script>
