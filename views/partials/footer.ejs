    </main>
    <footer class="main-footer" style="margin-top: 3rem; background-color: #f8fafc; border-top: 1px solid #e2e8f0; padding: 2rem 0;">
        <div class="footer-container" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 2rem; max-width: 1400px; margin: 0 auto; padding: 0 1.5rem;">
            
            <!-- School Info -->
            <div style="flex: 1; min-width: 250px;">
                <p style="margin: 0 0 0.5rem 0; font-weight: 700; color: #0f172a; font-size: 1.1rem;">&copy; <%= new Date().getFullYear() %> <%= typeof tenant !== 'undefined' && tenant ? tenant.name : 'OmniSchool' %></p>
                <p style="margin: 0; font-size: 0.875rem; color: #64748b;">All rights reserved. Managed via OmniSchool Platform.</p>
            </div>

            <!-- Product Branding -->
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 0.75rem; align-items: center;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Powered by</span>
                    <img src="/images/omnischool_logo.png" alt="OmniSchool" style="height: 32px; width: auto; object-fit: contain;">
                </div>
                <a href="https://omnischoolapp.com" target="_blank" style="font-size: 0.875rem; color: #4f46e5; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem; transition: color 0.2s;"><i class="bi bi-globe"></i> omnischoolapp.com</a>
            </div>

            <!-- Company Info -->
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 0.5rem; text-align: right;">
                <p style="margin: 0; font-size: 0.75rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Developed & Maintained By</p>
                <p style="margin: 0; font-weight: 700; color: #0f172a; font-size: 1.1rem;">Muhaimin Technologies</p>
                <a href="mailto:sales@omnischoolapp.com" style="font-size: 0.875rem; color: #64748b; text-decoration: none; transition: color 0.2s;"><i class="bi bi-envelope-fill"></i> sales@omnischoolapp.com</a>
            </div>
            
        </div>
    </footer>

    <!-- Global Custom Confirm Dialog -->
    <div id="globalConfirmModal" class="card" style="display: none; max-width: 400px; margin: 1rem auto; position: fixed; top: 20%; left: 50%; transform: translate(-50%, 0); z-index: 9999; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <h3 id="globalConfirmTitle" style="margin-bottom: 1rem; color: #b91c1c;"><i class="bi bi-exclamation-triangle-fill"></i> Confirm Action</h3>
        <p id="globalConfirmMessage" style="margin-bottom: 1.5rem; color: #475569;">Are you sure?</p>
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="closeGlobalConfirm()">Cancel</button>
            <button type="button" class="btn-danger" id="globalConfirmBtn">Confirm</button>
        </div>
    </div>
    <div id="globalConfirmOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.5); z-index: 9998;" onclick="closeGlobalConfirm()"></div>

    <script>
        let globalConfirmCallback = null;
        function customConfirm(message, callback) {
            document.getElementById('globalConfirmMessage').innerText = message;
            globalConfirmCallback = callback;
            document.getElementById('globalConfirmModal').style.display = 'block';
            document.getElementById('globalConfirmOverlay').style.display = 'block';
        }
        function closeGlobalConfirm() {
            document.getElementById('globalConfirmModal').style.display = 'none';
            document.getElementById('globalConfirmOverlay').style.display = 'none';
            globalConfirmCallback = null;
        }
        document.getElementById('globalConfirmBtn').addEventListener('click', () => {
            if (globalConfirmCallback) globalConfirmCallback();
            closeGlobalConfirm();
        });

        function confirmSubmit(event, message) {
            event.preventDefault();
            const form = event.target;
            customConfirm(message, () => {
                form.submit();
            });
        }
    </script>
</body>
</html>
