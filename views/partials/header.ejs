<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= tenant ? tenant.school_name : 'OmniSchool' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: <%= tenant ? tenant.primary_color : '#3b82f6' %>;
            --secondary-color: <%= tenant ? tenant.secondary_color : '#1d4ed8' %>;
        }
    </style>
</head>
<body>
    <% if (session && session.userId) { %>
        <% const hasPerm = (p) => session.roleName === 'Admin' || (session.permissions && session.permissions.includes(p)); %>
        <nav class="main-nav">
            <div class="nav-container">
                <a href="/" class="brand-link" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                    <img src="/images/omnischool_logo.png" alt="OmniSchool" style="height: 36px; width: auto; object-fit: contain; background: white; padding: 4px; border-radius: 6px;">
                </a>
                <button class="mobile-menu-btn" onclick="document.getElementById('main-nav-links').classList.toggle('active')">
                    <i class="bi bi-list"></i>
                </button>
                <ul class="nav-links" id="main-nav-links">
                    <% if (hasPerm('Dashboard')) { %>
                    <li><a href="/"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <% } %>
                    
                    <% if (hasPerm('Students')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-mortarboard-fill"></i> Students</a>
                        <div class="dropdown-content">
                            <a href="/students/add"><i class="bi bi-person-plus-fill"></i> Add New Student</a>
                            <a href="/students"><i class="bi bi-person-fill"></i> Student List</a>
                            <a href="/classes"><i class="bi bi-building"></i> Class Management</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <% if (hasPerm('Employees')) { %>
                    <li><a href="/employees"><i class="bi bi-person-badge-fill"></i> Employees</a></li>
                    <% } %>
                    
                    <% if (hasPerm('Fees')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-cash-coin"></i> Fees</a>
                        <div class="dropdown-content">
                            <a href="/fees/ledger"><i class="bi bi-table"></i> Monthly Ledger</a>
                            <a href="/fees/concessions"><i class="bi bi-tags-fill"></i> Concessions</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <%# Donations — optional module %>
                    <% if (tenant && tenant.enable_donations_module && hasPerm('Donations')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-heart-fill"></i> Donations</a>
                        <div class="dropdown-content">
                            <a href="/donations"><i class="bi bi-table"></i> Overview</a>
                            <a href="/donations/directory"><i class="bi bi-people-fill"></i> Donor Directory</a>
                            <a href="/donations/matrix"><i class="bi bi-grid-3x3-gap-fill"></i> Matrix View</a>
                            <a href="/donations?action=add_donation"><i class="bi bi-plus-lg"></i> Add Donation</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <% if (hasPerm('Attendance')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-calendar2-check-fill"></i> Attendance</a>
                        <div class="dropdown-content">
                            <a href="/attendance/students"><i class="bi bi-people"></i> Student Attendance</a>
                            <a href="/attendance/employees"><i class="bi bi-person-badge"></i> Employee Attendance</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <% if (hasPerm('Ledgers')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-journal-richtext"></i> Ledgers</a>
                        <div class="dropdown-content">
                            <a href="/expenses"><i class="bi bi-receipt"></i> Overhead Expenses</a>
                            <a href="/salaries"><i class="bi bi-wallet2"></i> Salaries/Payroll</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <%# Hifz Diary — optional module %>
                    <% if (tenant && tenant.enable_hifz_module && hasPerm('Hifz')) { %>
                    <li><a href="/hifz"><i class="bi bi-book-half"></i> Hifz Diary</a></li>
                    <% } %>
                    
                    <% if (hasPerm('Settings')) { %>
                    <li class="dropdown">
                        <a href="#" class="dropbtn"><i class="bi bi-gear-fill"></i> Settings</a>
                        <div class="dropdown-content">
                            <a href="/settings/general"><i class="bi bi-palette-fill"></i> General (Theme/Logo)</a>
                            <a href="/settings/merge"><i class="bi bi-intersect"></i> Merge Duplicates</a>
                            <a href="/settings/roles"><i class="bi bi-shield-lock-fill"></i> Roles & Permissions</a>
                            <a href="/settings/users"><i class="bi bi-people-fill"></i> User Accounts</a>
                        </div>
                    </li>
                    <% } %>
                    
                    <li class="dropdown user-menu dropdown-right">
                        <a href="#" class="dropbtn"><i class="bi bi-person-circle"></i> Hi, <%= session.username %> <i class="bi bi-chevron-down" style="font-size: 0.75rem; margin-left: 0.2rem;"></i></a>
                        <div class="dropdown-content">
                            <a href="/change-password"><i class="bi bi-key-fill"></i> Change Password</a>
                            <a href="/logout" style="color: #b91c1c;"><i class="bi bi-box-arrow-right"></i> Logout</a>
                        </div>
                    </li>
                    <li style="display: flex; align-items: center; padding-left: 1rem; margin-left: 0.5rem; border-left: 1px solid rgba(255,255,255,0.3);">
                        <% if (tenant && tenant.logo_url) { %>
                            <img src="<%= tenant.logo_url %>" alt="Logo" class="nav-logo" style="height: 32px; width: 32px; object-fit: contain; border-radius: 4px; margin-right: 0.5rem; background: white; padding: 2px;">
                        <% } %>
                        <span style="font-size: 0.85rem; font-weight: 600; color: white;"><%= tenant ? tenant.school_name : 'School Portal' %></span>
                    </li>
                </ul>
            </div>
        </nav>
    <% } %>
    <main class="main-content">
