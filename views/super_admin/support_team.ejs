<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin - Support Team</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
    </style>
</head>
<body>
    <%- include('nav', { activeTab: 'support_team', req: typeof req !== 'undefined' ? req : {} }) %>

    <main class="main-content">
        <div class="section-header">
            <h1 class="section-title"><i class="bi bi-headset"></i> Support Team Roster</h1>
            <button type="button" class="btn-primary" onclick="openAddAgentModal()"><i class="bi bi-person-plus-fill"></i> Add Support Agent</button>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="card table-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username / Login</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (agents.length > 0) { %>
                        <% agents.forEach(a => { %>
                            <tr>
                                <td style="font-weight: 700; color: #0f172a;"><%= a.name || 'Support Agent' %></td>
                                <td style="font-weight: 600; color: #4f46e5;">@<%= a.username %></td>
                                <td><%= a.phone || '-' %></td>
                                <td>
                                    <span class="status-cell <%= a.is_active ? 'status-paid' : 'status-unpaid' %>">
                                        <i class="bi <%= a.is_active ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' %>"></i>
                                        <%= a.is_active ? 'ACTIVE' : 'INACTIVE' %>
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <form action="/admin/support/team/<%= a.id %>/toggle" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-secondary nav-btn" style="color: <%= a.is_active ? '#dc2626' : '#16a34a' %>;">
                                            <i class="bi <%= a.is_active ? 'bi-person-x' : 'bi-person-check' %>"></i> <%= a.is_active ? 'Deactivate' : 'Activate' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" style="text-align: center; color: #64748b; padding: 2rem;">
                                No support agents added yet.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- ADD SUPPORT AGENT MODAL -->
    <div id="addAgentModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #ffffff; padding: 2rem; border-radius: 12px; max-width: 450px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin-top: 0; color: #4f46e5; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;"><i class="bi bi-person-plus-fill"></i> Add Support Agent</h3>

            <form action="/admin/support/team/new" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Full Name *</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Sara Khan" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Username *</label>
                    <input type="text" name="username" class="form-control" placeholder="e.g. sara_support" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Password *</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="font-weight: 600;">Phone Number</label>
                    <input type="text" name="phone" class="form-control" placeholder="e.g. 03009876543">
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeAddAgentModal()">Cancel</button>
                    <button type="submit" class="btn-primary"><i class="bi bi-check-circle"></i> Create Support Account</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openAddAgentModal() {
            document.getElementById('addAgentModal').style.display = 'flex';
        }
        function closeAddAgentModal() {
            document.getElementById('addAgentModal').style.display = 'none';
        }
    </script>
</body>
</html>
