<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prescreening Scraped Leads - OmniSchool</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; margin: 0; }
        .page-container { padding: 2rem; max-width: 1400px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: #0f172a; }
        .card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .table th, .table td { padding: 1rem; text-align: left; border-bottom: 1px solid #e2e8f0; }
        .table th { background: #f8fafc; font-weight: 600; color: #475569; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .table tbody tr:hover { background: #f1f5f9; }
        .badge { padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
        .badge-pending { background: #fef08a; color: #854d0e; }
        .btn { padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
        .btn-primary { background: #4f46e5; color: white; }
        .btn-primary:hover { background: #4338ca; }
        .btn-danger { background: #ef4444; color: white; }
        .btn-danger:hover { background: #dc2626; }
        .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
        
        .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); display: none; align-items: center; justify-content: center; z-index: 50; }
        .modal { background: white; border-radius: 12px; width: 100%; max-width: 500px; padding: 2rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .modal-title { font-size: 1.25rem; font-weight: 700; margin: 0; }
        .close-btn { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; color: #334155; }
        .form-control { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; font-family: inherit; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem; }
    </style>
</head>
<body>
    <%- include('../super_admin/nav', { activeTab: 'prescreening', req: req }) %>

    <div class="page-container">
        <% if (success) { %>
            <div style="background: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div style="background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="header" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>Prescreening Scraped Leads</h1>
                <p style="color: #64748b; margin-top: 0.5rem; font-size: 0.9rem;">Review auto-generated leads from the web scraper before adding them to the CRM.</p>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <% if (role === 'super_admin') { %>
                <% 
                    let usagePct = Math.min((apiUsage / apiLimit) * 100, 100);
                    let usageColor = usagePct >= 100 ? '#ef4444' : (usagePct >= 80 ? '#f59e0b' : '#3b82f6');
                %>
                <div style="display: flex; align-items: center; background: white; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.25rem 0.75rem; font-size: 0.85rem; font-weight: 600; color: #475569; height: 38px;" title="Google Maps API Usage this month">
                    <i class="bi bi-google" style="margin-right: 0.5rem; color: <%= usageColor %>;"></i>
                    <span style="margin-right: 0.5rem;"><%= apiUsage %> / <%= apiLimit %></span>
                    <div style="width: 40px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden; margin-top: 1px;">
                        <div style="height: 100%; width: <%= usagePct %>%; background: <%= usageColor %>;"></div>
                    </div>
                </div>
                <% } %>
                
                <button type="button" class="btn btn-secondary" style="background: #25D366; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; height: 38px; gap: 0.5rem;" onclick="openTestWhatsAppModal()">
                    <i class="bi bi-whatsapp"></i> Test WhatsApp Msg
                </button>

                <% if (role === 'super_admin') { %>
                <button type="button" class="btn btn-secondary" style="background: #475569; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; height: 38px; gap: 0.5rem;" onclick="openScraperSettingsModal()">
                    <i class="bi bi-gear-fill"></i> Scraper Settings
                </button>
                <a href="/admin/crm/scraper-map" class="btn btn-primary" style="background: #10b981; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="bi bi-map-fill"></i> View Coverage Map
                </a>
                <% } %>
            </div>
        </div>

        <!-- Select2 CSS/JS for searchable dropdown -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        
        <form action="/admin/crm/prescreening" method="GET" class="filter-form" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Search Name/Address</label>
                <input type="text" name="search" class="form-control" placeholder="e.g. Model Town..." value="<%= query.search || '' %>" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
            </div>
            <div class="form-group" style="flex: 1; min-width: 180px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Filter by City</label>
                <select name="city" id="cityFilter" class="form-control" onchange="this.form.submit()" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
                    <option value="">All Cities</option>
                    <% cities.forEach(c => { %>
                        <option value="<%= c %>" <%= query.city === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group" style="min-width: 140px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Status</label>
                <select name="status" class="form-control" onchange="this.form.submit()" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
                    <option value="pending" <%= (!query.status || query.status === 'pending') ? 'selected' : '' %>>Pending</option>
                    <option value="archived" <%= query.status === 'archived' ? 'selected' : '' %>>Archived</option>
                </select>
            </div>
            <div class="form-group" style="min-width: 140px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Phone Type</label>
                <select name="phone_type" class="form-control" onchange="this.form.submit()" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
                    <option value="">All Phones</option>
                    <option value="mobile" <%= query.phone_type === 'mobile' ? 'selected' : '' %>>Mobile Only</option>
                    <option value="landline" <%= query.phone_type === 'landline' ? 'selected' : '' %>>Landline Only</option>
                </select>
            </div>
            <div class="form-group" style="display: flex; gap: 0.5rem;">
                <a href="/admin/crm/prescreening" class="btn btn-secondary" style="background: #e2e8f0; color: #475569; padding: 0.5rem 0.75rem; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; height: 38px;" title="Clear Filters">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>

        <script>
            // Initialize Select2 on the city filter when document is ready
            document.addEventListener('DOMContentLoaded', function() {
                // Check if jQuery exists (Select2 requires it). If not, load it.
                if (typeof jQuery === 'undefined') {
                    const jq = document.createElement('script');
                    jq.src = "https://code.jquery.com/jquery-3.6.0.min.js";
                    jq.onload = function() {
                        $('#cityFilter').select2({ placeholder: "Search city..." });
                        // Ensure Select2 triggers the form submit when changed
                        $('#cityFilter').on('select2:select', function (e) {
                            this.form.submit();
                        });
                    };
                    document.head.appendChild(jq);
                } else {
                    $('#cityFilter').select2({ placeholder: "Search city..." });
                    $('#cityFilter').on('select2:select', function (e) {
                        this.form.submit();
                    });
                }
            });
        </script>

        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>School Name</th>
                        <th>City & Address</th>
                        <th>Phone</th>
                        <th>Date Scraped</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (scraped_leads.length === 0) { %>
                        <tr>
                            <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">No pending leads for prescreening.</td>
                        </tr>
                    <% } %>
                    <% scraped_leads.forEach(lead => { %>
                        <tr>
                            <td>
                                <strong><%= lead.school_name %></strong>
                                <% if (lead.source_url) { %>
                                    <br><a href="<%= lead.source_url %>" target="_blank" style="font-size: 0.75rem; color: #10b981; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 0.25rem;"><i class="bi bi-geo-alt-fill"></i> View on Map</a>
                                <% } %>
                            </td>
                            <td>
                                <div><%= lead.city || 'N/A' %></div>
                                <div style="font-size: 0.8rem; color: #64748b;"><%= lead.address %></div>
                            </td>
                            <td>
                                <%= lead.phone || 'N/A' %>
                            </td>
                            <td style="font-size: 0.85rem;"><%= new Date(lead.created_at).toLocaleDateString() %></td>
                            <td style="vertical-align: middle; min-width: 280px;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end; flex-wrap: wrap;">
                                    <% if (lead.phone) { 
                                        let waPhone = lead.phone.replace(/\D/g, '');
                                        if (waPhone.startsWith('0')) waPhone = '92' + waPhone.substring(1);
                                        
                                        const newMsgText = `OmniSchool — Simplify Your School Management\n\nHello!\n\nRunning a school isn't easy — fee collection, attendance, exams, and daily admin tasks take up hours every week.\n\nOmniSchool automates your entire school system in one place:\n💰 Fee Collection\n📚 Academics\n📅 Attendance\n📊 Ledger & Accounts\n💸 Salary Management\n🎧 Dedicated Support\n\nWatch this 2-minute demo video and see exactly how it works:\nhttps://omnischoolapp.com/video/`;
                                        const newMsgFooter = `\n\nHave questions? Just reply — we're happy to walk you through it.\n\n🌐 Learn more: https://omnischoolapp.com`;
                                        
                                        const waMsgSchool = encodeURIComponent(newMsgText + 'demo-en.mp4' + newMsgFooter);
                                        const waMsgHifz = encodeURIComponent(newMsgText + 'hifz-demo.mp4' + newMsgFooter);
                                    %>
                                        <div style="display: flex; gap: 0.25rem;">
                                            <a href="https://wa.me/<%= waPhone %>?text=<%= waMsgSchool %>" target="_blank" class="btn btn-sm" style="background: #25D366; color: white; padding: 0.35rem 0.5rem; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem;" title="Send School Video">
                                                <i class="bi bi-whatsapp"></i> School
                                            </a>
                                            <a href="https://wa.me/<%= waPhone %>?text=<%= waMsgHifz %>" target="_blank" class="btn btn-sm" style="background: #25D366; color: white; padding: 0.35rem 0.5rem; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem;" title="Send Hifz Video">
                                                <i class="bi bi-whatsapp"></i> Hifz
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <div style="display: flex; gap: 0.25rem;">
                                            <button type="button" class="btn btn-sm" style="background: #cbd5e1; color: white; padding: 0.35rem 0.5rem; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem; cursor: not-allowed;" disabled title="No phone number available">
                                                <i class="bi bi-whatsapp"></i> School
                                            </button>
                                            <button type="button" class="btn btn-sm" style="background: #cbd5e1; color: white; padding: 0.35rem 0.5rem; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.25rem; cursor: not-allowed;" disabled title="No phone number available">
                                                <i class="bi bi-whatsapp"></i> Hifz
                                            </button>
                                        </div>
                                    <% } %>
                                    <div style="display: flex; gap: 0.25rem;">
                                        <% if (lead.status === 'archived') { %>
                                            <form method="POST" action="/admin/crm/prescreening/<%= lead.id %>/restore" style="margin: 0;">
                                                <button type="submit" class="btn btn-primary btn-sm" style="background: #3b82f6; border: none; padding: 0.35rem 0.5rem; font-size: 0.75rem;">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <button type="button" class="btn btn-primary btn-sm" style="padding: 0.35rem 0.5rem; font-size: 0.75rem;" onclick="openConvertModal(<%= JSON.stringify(lead) %>)">
                                                <i class="bi bi-person-plus"></i> Convert
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm" style="background: #f59e0b; border: none; padding: 0.35rem 0.5rem; font-size: 0.75rem;" onclick="openArchiveModal(<%= lead.id %>)">
                                                <i class="bi bi-archive"></i> Archive
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <% if (totalPages > 1) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
                    <div style="font-size: 0.875rem; color: #64748b;">
                        Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalLeads %> total leads)
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <% 
                            let baseUrl = '/admin/crm/prescreening?';
                            if (query.city) baseUrl += `city=${encodeURIComponent(query.city)}&`;
                            if (query.search) baseUrl += `search=${encodeURIComponent(query.search)}&`;
                        %>
                        <% if (currentPage > 1) { %>
                            <a href="<%= baseUrl %>page=<%= currentPage - 1 %>" class="btn btn-sm" style="background: #f1f5f9; color: #475569; text-decoration: none;">&laquo; Prev</a>
                        <% } else { %>
                            <button class="btn btn-sm" style="background: #f8fafc; color: #94a3b8; cursor: not-allowed;" disabled>&laquo; Prev</button>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="<%= baseUrl %>page=<%= currentPage + 1 %>" class="btn btn-sm" style="background: #f1f5f9; color: #475569; text-decoration: none;">Next &raquo;</a>
                        <% } else { %>
                            <button class="btn btn-sm" style="background: #f8fafc; color: #94a3b8; cursor: not-allowed;" disabled>Next &raquo;</button>
                        <% } %>
                    </div>
                </div>
            <% } else if (totalLeads > 0) { %>
                <div style="margin-top: 1rem; font-size: 0.875rem; color: #64748b; text-align: right;">
                    Showing all <%= totalLeads %> leads
                </div>
            <% } %>
        </div>
    </div>

    <!-- Convert Modal -->
    <div id="convertModal" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Convert to Lead</h3>
                <button type="button" class="close-btn" onclick="closeConvertModal()">&times;</button>
            </div>
            <form id="convertForm" method="POST" action="">
                <div class="form-group">
                    <label>School Name (Read-Only)</label>
                    <input type="text" id="modalSchoolName" class="form-control" readonly style="background: #f1f5f9;">
                </div>
                
                <div class="form-group">
                    <label>Assign To Sales Rep</label>
                    <select name="assigned_to" class="form-control" <%= role === 'sales_rep' ? 'style="pointer-events: none; background: #f1f5f9;" tabindex="-1"' : '' %>>
                        <% if (role === 'sales_rep') { %>
                            <% const me = reps.find(r => r.username === username); %>
                            <% if (me) { %>
                                <option value="<%= me.id %>" selected><%= me.name %> (You)</option>
                            <% } else { %>
                                <option value="">-- Unassigned --</option>
                            <% } %>
                        <% } else { %>
                            <option value="">-- Unassigned --</option>
                            <% reps.forEach(rep => { %>
                                <option value="<%= rep.id %>"><%= rep.name %> (<%= rep.username %>)</option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Contact Person (if known)</label>
                    <input type="text" name="contact_person" class="form-control" placeholder="e.g., Principal / Owner">
                </div>

                <div class="form-group">
                    <label>Estimated Students (if known)</label>
                    <input type="number" name="est_students" class="form-control" placeholder="0">
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Any context from prescreening..."></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeConvertModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Convert Lead</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Test WhatsApp Modal -->
    <div id="testWaModal" class="modal-overlay">
        <div class="modal" style="max-width: 500px;">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #1e293b;"><i class="bi bi-whatsapp" style="color: #25D366;"></i> Test WhatsApp Message</h3>
                <button type="button" class="close-btn" onclick="closeTestWhatsAppModal()">&times;</button>
            </div>
            <div class="form-group" style="margin-top: 1rem;">
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; display: block; color: #475569;">Test Phone Number</label>
                <input type="text" id="testWaPhone" class="form-control" placeholder="e.g. 03001234567">
            </div>
            <div class="form-group">
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; display: block; color: #475569;">Select Video Version</label>
                <select id="testWaVideo" class="form-control">
                    <option value="demo-en.mp4">English Demo</option>
                    <option value="hifz-demo.mp4">Hifz Demo</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeTestWhatsAppModal()">Cancel</button>
                <button type="button" class="btn btn-primary" style="background: #25D366; border: none; font-weight: 600;" onclick="sendTestWhatsApp()">Send Test via WhatsApp</button>
            </div>
        </div>
    </div>

    <!-- Archive Modal -->
    <div id="archiveModal" class="modal-overlay">
        <div class="modal" style="max-width: 400px;">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #d97706;"><i class="bi bi-archive"></i> Archive Lead</h3>
                <button type="button" class="close-btn" onclick="closeArchiveModal()">&times;</button>
            </div>
            <p style="color: #475569; margin-bottom: 1.5rem;">Are you sure you want to archive this lead? It will be removed from your pending list, but you can always restore it later.</p>
            <form id="archiveForm" method="POST" action="">
                <div class="modal-footer">
                    <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeArchiveModal()">Cancel</button>
                    <button type="submit" class="btn btn-danger" style="background: #f59e0b; border: none;">Yes, Archive Lead</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openConvertModal(lead) {
            document.getElementById('convertForm').action = `/admin/crm/prescreening/${lead.id}/convert`;
            document.getElementById('modalSchoolName').value = lead.school_name;
            document.getElementById('convertModal').style.display = 'flex';
        }

        function closeConvertModal() {
            document.getElementById('convertModal').style.display = 'none';
        }

        function openArchiveModal(leadId) {
            document.getElementById('archiveForm').action = `/admin/crm/prescreening/${leadId}/archive`;
            document.getElementById('archiveModal').style.display = 'flex';
        }

        function closeArchiveModal() {
            document.getElementById('archiveModal').style.display = 'none';
        }

        function openTestWhatsAppModal() {
            document.getElementById('testWaModal').style.display = 'flex';
        }
        
        function closeTestWhatsAppModal() {
            document.getElementById('testWaModal').style.display = 'none';
        }

        function openScraperSettingsModal() {
            document.getElementById('scraperSettingsModal').style.display = 'flex';
        }

        function closeScraperSettingsModal() {
            document.getElementById('scraperSettingsModal').style.display = 'none';
        }
        
        function closeTestWhatsAppModal() {
            document.getElementById('testWaModal').style.display = 'none';
        }
        
        function sendTestWhatsApp() {
            let phone = document.getElementById('testWaPhone').value.replace(/\D/g, '');
            if (phone.startsWith('0')) phone = '92' + phone.substring(1);
            if (!phone) {
                alert('Please enter a valid test phone number.');
                return;
            }
            
            const video = document.getElementById('testWaVideo').value;
            
            const newMsgText = `OmniSchool — Simplify Your School Management\n\nHello!\n\nRunning a school isn't easy — fee collection, attendance, exams, and daily admin tasks take up hours every week.\n\nOmniSchool automates your entire school system in one place:\n💰 Fee Collection\n📚 Academics\n📅 Attendance\n📊 Ledger & Accounts\n💸 Salary Management\n🎧 Dedicated Support\n\nWatch this 2-minute demo video and see exactly how it works:\nhttps://omnischoolapp.com/video/${video}`;
            const newMsgFooter = `\n\nHave questions? Just reply — we're happy to walk you through it.\n\n🌐 Learn more: https://omnischoolapp.com`;
            
            const rawMsg = newMsgText + newMsgFooter;
            
            window.open(`https://wa.me/${phone}?text=${encodeURIComponent(rawMsg)}`, '_blank');
        }
    </script>
    <!-- Scraper Settings Modal -->
    <div id="scraperSettingsModal" class="modal-overlay">
        <div class="modal" style="max-width: 600px;">
            <div class="modal-header">
                <h3 class="modal-title"><i class="bi bi-gear-fill"></i> Scraper Exclusion Settings</h3>
                <button type="button" class="close-btn" onclick="closeScraperSettingsModal()">&times;</button>
            </div>
            
            <form action="/admin/crm/scraper-settings/add" method="POST" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
                <input type="text" name="keyword" class="form-control" placeholder="Add new keyword (e.g. 'govt', 'beaconhouse')" required>
                <button type="submit" class="btn btn-primary" style="background: #4f46e5; border: none; flex-shrink: 0;">Add</button>
            </form>

            <h4 style="margin-bottom: 0.5rem; font-size: 0.9rem; color: #475569;">Active Exclusions</h4>
            <div style="max-height: 300px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                <table class="table" style="margin-top: 0;">
                    <tbody>
                        <% if (exclusions && exclusions.length > 0) { %>
                            <% exclusions.forEach(ex => { %>
                                <tr>
                                    <td style="font-weight: 500;"><%= ex.keyword %></td>
                                    <td style="text-align: right; width: 80px;">
                                        <form action="/admin/crm/scraper-settings/delete/<%= ex.id %>" method="POST" style="margin: 0;">
                                            <button type="submit" class="btn btn-danger btn-sm" style="background: #ef4444; border: none;" onclick="return confirm('Remove this exclusion?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="2" style="text-align: center; color: #64748b; padding: 1rem;">No exclusions found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>
