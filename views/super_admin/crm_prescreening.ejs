<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prescreening Scraped Leads - OmniSchool</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; margin: 0; }
        .page-container { padding: 2rem; max-width: 1400px; margin: 0 auto; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; color: #0f172a; }
        .card { background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .table th, .table td { padding: 1rem; text-align: left; border-bottom: 1px solid #e2e8f0; }
        .table th { background: #f8fafc; font-weight: 600; color: #475569; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .table tbody tr:hover { background: #f1f5f9; }
        .badge { padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
        .badge-pending { background: #fef08a; color: #854d0e; }
        .btn { padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
        .btn-primary { background: #4f46e5; color: white; }
        .btn-primary:hover { background: #4338ca; }
        .btn-danger { background: #ef4444; color: white; }
        .btn-danger:hover { background: #dc2626; }
        .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
        
        .modal-overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); display: none; align-items: center; justify-content: center; z-index: 50; }
        .modal { background: white; border-radius: 12px; width: 100%; max-width: 500px; padding: 2rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .modal-title { font-size: 1.25rem; font-weight: 700; margin: 0; }
        .close-btn { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #64748b; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; color: #334155; }
        .form-control { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; font-family: inherit; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem; }
    </style>
</head>
<body>
    <%- include('../super_admin/nav', { activeTab: 'prescreening', req: req }) %>

    <div class="page-container">
        <% if (success) { %>
            <div style="background: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div style="background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="header" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>Prescreening Scraped Leads</h1>
                <p style="color: #64748b; margin-top: 0.5rem; font-size: 0.9rem;">Review auto-generated leads from the web scraper before adding them to the CRM.</p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button type="button" class="btn btn-secondary" style="background: #25D366; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; display: inline-flex; align-items: center; gap: 0.5rem;" onclick="openTestWhatsAppModal()">
                    <i class="bi bi-whatsapp"></i> Test WhatsApp Msg
                </button>
                <a href="/admin/crm/scraper-map" class="btn btn-primary" style="background: #10b981; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="bi bi-map-fill"></i> View Coverage Map
                </a>
            </div>
        </div>

        <!-- Select2 CSS/JS for searchable dropdown -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        
        <form action="/admin/crm/prescreening" method="GET" class="filter-form" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <div class="form-group" style="flex: 1; min-width: 250px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Search Name/Address</label>
                <input type="text" name="search" class="form-control" placeholder="e.g. Model Town..." value="<%= query.search || '' %>" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
            </div>
            <div class="form-group" style="flex: 1; min-width: 200px;">
                <label style="font-size: 0.85rem; color: #64748b; font-weight: 600; margin-bottom: 0.25rem; display: block;">Filter by City</label>
                <select name="city" id="cityFilter" class="form-control" onchange="this.form.submit()" style="width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.5rem 0.75rem;">
                    <option value="">All Cities</option>
                    <% cities.forEach(c => { %>
                        <option value="<%= c %>" <%= query.city === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary" style="background: #4f46e5; border: none; padding: 0.5rem 1rem; border-radius: 6px; color: white; font-weight: 600; height: 38px;">Filter</button>
                <% if (query.search || query.city) { %>
                    <a href="/admin/crm/prescreening" class="btn btn-secondary" style="background: #e2e8f0; color: #475569; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; margin-left: 0.5rem; display: inline-flex; align-items: center; height: 38px;">Clear</a>
                <% } %>
            </div>
        </form>

        <script>
            // Initialize Select2 on the city filter when document is ready
            document.addEventListener('DOMContentLoaded', function() {
                // Check if jQuery exists (Select2 requires it). If not, load it.
                if (typeof jQuery === 'undefined') {
                    const jq = document.createElement('script');
                    jq.src = "https://code.jquery.com/jquery-3.6.0.min.js";
                    jq.onload = function() {
                        $('#cityFilter').select2({ placeholder: "Search city..." });
                        // Ensure Select2 triggers the form submit when changed
                        $('#cityFilter').on('select2:select', function (e) {
                            this.form.submit();
                        });
                    };
                    document.head.appendChild(jq);
                } else {
                    $('#cityFilter').select2({ placeholder: "Search city..." });
                    $('#cityFilter').on('select2:select', function (e) {
                        this.form.submit();
                    });
                }
            });
        </script>

        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>School Name</th>
                        <th>City & Address</th>
                        <th>Phone</th>
                        <th>Search Term</th>
                        <th>Date Scraped</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (scraped_leads.length === 0) { %>
                        <tr>
                            <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">No pending leads for prescreening.</td>
                        </tr>
                    <% } %>
                    <% scraped_leads.forEach(lead => { %>
                        <tr>
                            <td>
                                <strong><%= lead.school_name %></strong>
                                <% if (lead.source_url) { %>
                                    <br><a href="<%= lead.source_url %>" target="_blank" style="font-size: 0.75rem; color: #10b981; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem; margin-top: 0.25rem;"><i class="bi bi-geo-alt-fill"></i> View on Map</a>
                                <% } %>
                            </td>
                            <td>
                                <div><%= lead.city || 'N/A' %></div>
                                <div style="font-size: 0.8rem; color: #64748b;"><%= lead.address %></div>
                            </td>
                            <td>
                                <%= lead.phone || 'N/A' %>
                                <% if (lead.phone) { 
                                    let waPhone = lead.phone.replace(/\D/g, '');
                                    if (waPhone.startsWith('0')) waPhone = '92' + waPhone.substring(1);
                                    
                                    const baseMsgEn = `Hello from OmniSchool! 👋\n\nWe noticed ${lead.school_name} is doing fantastic work in the community. As education evolves, managing campus operations seamlessly is more critical than ever.\n\nOmniSchool is a complete, all-in-one School Management System designed to automate your fee collection, academics, and administration—saving you hours of administrative work every week.`;
                                    const baseMsgUr = `\n\nالسلام علیکم! ہم نے دیکھا کہ آپ کا ادارہ زبردست کام کر رہا ہے۔ آج کے جدید دور میں سکول کے نظام کو بہتر اور ڈیجیٹل بنانا بہت ضروری ہو چکا ہے۔ OmniSchool ایک مکمل سکول مینجمنٹ سسٹم ہے جو آپ کی فیس کلیکشن، امتحانات، اور تمام انتظامی امور کو خودکار (Automate) کر دیتا ہے۔`;
                                    
                                    const videoIntro = `\n\n▶️ Watch our quick 2-minute product demo here to see it in action:\nhttps://omnischoolapp.com/video/`;
                                    const endMsg = `\n\nLearn more at our website: https://omnischoolapp.com\n\nWe would love to connect and show you how we can add value to your campus!`;
                                    
                                    const waMsgSchool = encodeURIComponent(baseMsgEn + baseMsgUr + videoIntro + 'demo-en.mp4' + endMsg);
                                    const waMsgHifz = encodeURIComponent(baseMsgEn + baseMsgUr + videoIntro + 'hifz-demo.mp4' + endMsg);
                                %>
                                    <div style="display: flex; gap: 0.25rem; margin-top: 0.5rem; flex-wrap: wrap;">
                                        <a href="https://wa.me/<%= waPhone %>?text=<%= waMsgSchool %>" target="_blank" class="btn btn-sm" style="background: #25D366; color: white; padding: 0.15rem 0.4rem; font-size: 0.7rem; display: inline-flex; align-items: center; gap: 0.25rem;" title="Send School Video">
                                            <i class="bi bi-whatsapp"></i> School
                                        </a>
                                        <a href="https://wa.me/<%= waPhone %>?text=<%= waMsgHifz %>" target="_blank" class="btn btn-sm" style="background: #25D366; color: white; padding: 0.15rem 0.4rem; font-size: 0.7rem; display: inline-flex; align-items: center; gap: 0.25rem;" title="Send Hifz Video">
                                            <i class="bi bi-whatsapp"></i> Hifz
                                        </a>
                                    </div>
                                <% } %>
                            </td>
                            <td><span class="badge" style="background: #e2e8f0; color: #475569;"><%= lead.search_term_used || 'N/A' %></span></td>
                            <td style="font-size: 0.85rem;"><%= new Date(lead.created_at).toLocaleDateString() %></td>
                            <td style="text-align: right; white-space: nowrap;">
                                <button type="button" class="btn btn-primary btn-sm" onclick="openConvertModal(<%= JSON.stringify(lead) %>)">
                                    <i class="bi bi-person-plus"></i> Convert
                                </button>
                                <button type="button" class="btn btn-danger btn-sm" onclick="openRejectModal(<%= lead.id %>)">
                                    <i class="bi bi-x-lg"></i> Reject
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <% if (totalPages > 1) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #e2e8f0;">
                    <div style="font-size: 0.875rem; color: #64748b;">
                        Showing page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> (<%= totalLeads %> total leads)
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <% 
                            let baseUrl = '/admin/crm/prescreening?';
                            if (query.city) baseUrl += `city=${encodeURIComponent(query.city)}&`;
                            if (query.search) baseUrl += `search=${encodeURIComponent(query.search)}&`;
                        %>
                        <% if (currentPage > 1) { %>
                            <a href="<%= baseUrl %>page=<%= currentPage - 1 %>" class="btn btn-sm" style="background: #f1f5f9; color: #475569; text-decoration: none;">&laquo; Prev</a>
                        <% } else { %>
                            <button class="btn btn-sm" style="background: #f8fafc; color: #94a3b8; cursor: not-allowed;" disabled>&laquo; Prev</button>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="<%= baseUrl %>page=<%= currentPage + 1 %>" class="btn btn-sm" style="background: #f1f5f9; color: #475569; text-decoration: none;">Next &raquo;</a>
                        <% } else { %>
                            <button class="btn btn-sm" style="background: #f8fafc; color: #94a3b8; cursor: not-allowed;" disabled>Next &raquo;</button>
                        <% } %>
                    </div>
                </div>
            <% } else if (totalLeads > 0) { %>
                <div style="margin-top: 1rem; font-size: 0.875rem; color: #64748b; text-align: right;">
                    Showing all <%= totalLeads %> leads
                </div>
            <% } %>
        </div>
    </div>

    <!-- Convert Modal -->
    <div id="convertModal" class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Convert to Lead</h3>
                <button type="button" class="close-btn" onclick="closeConvertModal()">&times;</button>
            </div>
            <form id="convertForm" method="POST" action="">
                <div class="form-group">
                    <label>School Name (Read-Only)</label>
                    <input type="text" id="modalSchoolName" class="form-control" readonly style="background: #f1f5f9;">
                </div>
                
                <div class="form-group">
                    <label>Assign To Sales Rep</label>
                    <select name="assigned_to" class="form-control" <%= role === 'sales_rep' ? 'style="pointer-events: none; background: #f1f5f9;" tabindex="-1"' : '' %>>
                        <% if (role === 'sales_rep') { %>
                            <% const me = reps.find(r => r.username === username); %>
                            <% if (me) { %>
                                <option value="<%= me.id %>" selected><%= me.name %> (You)</option>
                            <% } else { %>
                                <option value="">-- Unassigned --</option>
                            <% } %>
                        <% } else { %>
                            <option value="">-- Unassigned --</option>
                            <% reps.forEach(rep => { %>
                                <option value="<%= rep.id %>"><%= rep.name %> (<%= rep.username %>)</option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Contact Person (if known)</label>
                    <input type="text" name="contact_person" class="form-control" placeholder="e.g., Principal / Owner">
                </div>

                <div class="form-group">
                    <label>Estimated Students (if known)</label>
                    <input type="number" name="est_students" class="form-control" placeholder="0">
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Any context from prescreening..."></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeConvertModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Convert Lead</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Test WhatsApp Modal -->
    <div id="testWaModal" class="modal-overlay">
        <div class="modal" style="max-width: 500px;">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #1e293b;"><i class="bi bi-whatsapp" style="color: #25D366;"></i> Test WhatsApp Message</h3>
                <button type="button" class="close-btn" onclick="closeTestWhatsAppModal()">&times;</button>
            </div>
            <div class="form-group" style="margin-top: 1rem;">
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; display: block; color: #475569;">Test Phone Number</label>
                <input type="text" id="testWaPhone" class="form-control" placeholder="e.g. 03001234567">
            </div>
            <div class="form-group">
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.5rem; display: block; color: #475569;">Select Video Version</label>
                <select id="testWaVideo" class="form-control">
                    <option value="demo-en.mp4">English Demo</option>
                    <option value="hifz-demo.mp4">Hifz Demo</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeTestWhatsAppModal()">Cancel</button>
                <button type="button" class="btn btn-primary" style="background: #25D366; border: none; font-weight: 600;" onclick="sendTestWhatsApp()">Send Test via WhatsApp</button>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div id="rejectModal" class="modal-overlay">
        <div class="modal" style="max-width: 400px;">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #dc2626;"><i class="bi bi-exclamation-triangle"></i> Reject Lead</h3>
                <button type="button" class="close-btn" onclick="closeRejectModal()">&times;</button>
            </div>
            <p style="color: #475569; margin-bottom: 1.5rem;">Are you sure you want to reject this lead? This action cannot be undone and it will be permanently removed from your prescreening pool.</p>
            <form id="rejectForm" method="POST" action="">
                <div class="modal-footer">
                    <button type="button" class="btn" style="background: #e2e8f0; color: #475569;" onclick="closeRejectModal()">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Reject Lead</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openConvertModal(lead) {
            document.getElementById('convertForm').action = `/admin/crm/prescreening/${lead.id}/convert`;
            document.getElementById('modalSchoolName').value = lead.school_name;
            document.getElementById('convertModal').style.display = 'flex';
        }

        function closeConvertModal() {
            document.getElementById('convertModal').style.display = 'none';
        }

        function openRejectModal(leadId) {
            document.getElementById('rejectForm').action = `/admin/crm/prescreening/${leadId}/reject`;
            document.getElementById('rejectModal').style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        function openTestWhatsAppModal() {
            document.getElementById('testWaModal').style.display = 'flex';
        }
        
        function closeTestWhatsAppModal() {
            document.getElementById('testWaModal').style.display = 'none';
        }
        
        function sendTestWhatsApp() {
            let phone = document.getElementById('testWaPhone').value.replace(/\D/g, '');
            if (phone.startsWith('0')) phone = '92' + phone.substring(1);
            if (!phone) {
                alert('Please enter a valid test phone number.');
                return;
            }
            
            const video = document.getElementById('testWaVideo').value;
            
            const baseMsgEn = `Hello from OmniSchool! 👋\n\nAs education evolves, managing campus operations seamlessly is more critical than ever.\n\nOmniSchool is a complete, all-in-one School Management System designed to automate your fee collection, academics, and administration—saving you hours of administrative work every week.`;
            const baseMsgUr = `\n\nالسلام علیکم! آج کے جدید دور میں سکول کے نظام کو بہتر اور ڈیجیٹل بنانا بہت ضروری ہو چکا ہے۔ OmniSchool ایک مکمل سکول مینجمنٹ سسٹم ہے جو آپ کی فیس کلیکشن، امتحانات، اور تمام انتظامی امور کو خودکار (Automate) کر دیتا ہے۔`;
            const endMsg = `\n\n▶️ Watch our quick 2-minute product demo here to see it in action:\nhttps://omnischoolapp.com/video/${video}\n\nLearn more at our website: https://omnischoolapp.com\n\nWe would love to connect and show you how we can add value to your campus!`;
            
            const rawMsg = baseMsgEn + baseMsgUr + endMsg;
            
            window.open(`https://wa.me/${phone}?text=${encodeURIComponent(rawMsg)}`, '_blank');
        }
    </script>
</body>
</html>
