<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit Lead' : 'Add New Lead' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.25rem;
        }
    </style>
</head>
<body>
    <%- include('nav', { activeTab: 'leads', req: typeof req !== 'undefined' ? req : {} }) %>

    <main class="main-content">
        <div class="section-header">
            <h1 class="section-title"><i class="bi bi-funnel"></i> <%= isEdit ? `Edit Lead: ${lead.school_name}` : 'Add New School Lead' %></h1>
            <a href="/admin/crm/leads" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Leads</a>
        </div>

        <div class="card" style="padding: 2rem; max-width: 900px; margin: 0 auto;">
            <form action="<%= isEdit ? `/admin/crm/leads/${lead.id}/edit` : '/admin/crm/leads/new' %>" method="POST">
                
                <h3 style="margin-top: 0; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #4f46e5; font-size: 1.1rem;">
                    <i class="bi bi-building"></i> School Information
                </h3>
                
                <div class="form-grid" style="margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label style="font-weight: 600;">School Name *</label>
                        <input type="text" name="school_name" class="form-control" value="<%= isEdit ? lead.school_name : '' %>" required placeholder="e.g. Al-Huda Academy">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">City *</label>
                        <input type="text" name="city" class="form-control" value="<%= isEdit ? lead.city : '' %>" required placeholder="e.g. Lahore, Karachi, Rawalpindi">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Address</label>
                        <input type="text" name="address" class="form-control" value="<%= isEdit ? lead.address : '' %>" placeholder="Full branch address">
                    </div>
                </div>

                <h3 style="border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #4f46e5; font-size: 1.1rem; margin-top: 1.5rem;">
                    <i class="bi bi-person-lines-fill"></i> Decision Maker / Contact Details
                </h3>

                <div class="form-grid" style="margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label style="font-weight: 600;">Contact Person Name *</label>
                        <input type="text" name="contact_person" class="form-control" value="<%= isEdit ? lead.contact_person : '' %>" required placeholder="e.g. Qari Abdul Rehman">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Designation / Role</label>
                        <input type="text" name="designation" class="form-control" value="<%= isEdit ? lead.designation : '' %>" placeholder="e.g. Principal / Director / Trustee">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Phone Number *</label>
                        <input type="text" name="phone" class="form-control" value="<%= isEdit ? lead.phone : '' %>" required placeholder="e.g. 03001234567">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Email Address</label>
                        <input type="email" name="email" class="form-control" value="<%= isEdit ? lead.email : '' %>" placeholder="e.g. school@gmail.com">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Group Director (One Level Up Decision Maker)</label>
                        <input type="text" name="group_director" class="form-control" value="<%= isEdit ? lead.group_director : '' %>" placeholder="e.g. Director of Group / Owner of multiple schools">
                    </div>
                </div>

                <h3 style="border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #4f46e5; font-size: 1.1rem; margin-top: 1.5rem;">
                    <i class="bi bi-pie-chart-fill"></i> Operational Profile & Assignment
                </h3>

                <div class="form-grid" style="margin-bottom: 1.5rem;">
                    <div class="form-group">
                        <label style="font-weight: 600;">Estimated Student Strength</label>
                        <input type="number" name="est_students" class="form-control" value="<%= isEdit ? lead.est_students : '' %>" placeholder="e.g. 350">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Current System / Software</label>
                        <input type="text" name="current_system" class="form-control" value="<%= isEdit ? lead.current_system : '' %>" placeholder="e.g. Paper Registers, Excel, Competitor Software">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Assigned Sales Representative</label>
                        <% if (typeof role !== 'undefined' && role === 'sales_rep') { %>
                            <input type="text" class="form-control" value="<%= (reps.find(r => r.id == lead.assigned_to) || {}).name || 'You' %>" readonly>
                            <small style="color: #64748b;">Use "Hand Off Lead" on the lead's page to reassign ownership.</small>
                        <% } else { %>
                            <select name="assigned_to" class="form-control">
                                <option value="">-- Select Sales Rep --</option>
                                <% reps.forEach(r => { %>
                                    <option value="<%= r.id %>" <%= (isEdit && lead.assigned_to == r.id) ? 'selected' : '' %>><%= r.name || r.username %></option>
                                <% }) %>
                            </select>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Pipeline Status</label>
                        <select name="status" class="form-control">
                            <option value="new" <%= (isEdit && lead.status === 'new') ? 'selected' : '' %>>New Lead</option>
                            <option value="contacted" <%= (isEdit && lead.status === 'contacted') ? 'selected' : '' %>>Contacted</option>
                            <option value="meeting_scheduled" <%= (isEdit && lead.status === 'meeting_scheduled') ? 'selected' : '' %>>Meeting Scheduled</option>
                            <option value="demo_given" <%= (isEdit && lead.status === 'demo_given') ? 'selected' : '' %>>Demo Given</option>
                            <option value="negotiation" <%= (isEdit && lead.status === 'negotiation') ? 'selected' : '' %>>Negotiation</option>
                            <option value="won" <%= (isEdit && lead.status === 'won') ? 'selected' : '' %>>Won / Converted</option>
                            <option value="lost" <%= (isEdit && lead.status === 'lost') ? 'selected' : '' %>>Lost</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Lead Source</label>
                        <input type="text" name="lead_source" class="form-control" value="<%= isEdit ? lead.lead_source : '' %>" placeholder="e.g. Field Visit, Referral, Cold Call">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Referrer Contact (Who provided the lead)</label>
                        <input type="text" name="referred_by_contact" class="form-control" value="<%= isEdit ? lead.referred_by_contact : '' %>" placeholder="e.g. Name, Phone or Email of referrer">
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="font-weight: 600;">Notes & Background</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Any special notes or background about this prospect..."><%= isEdit ? lead.notes : '' %></textarea>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <a href="/admin/crm/leads" class="btn-secondary" style="padding: 0.6rem 1.5rem;">Cancel</a>
                    <button type="submit" class="btn-primary" style="padding: 0.6rem 2rem; font-weight: 600;"><i class="bi bi-save"></i> <%= isEdit ? 'Update Lead' : 'Create Lead' %></button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
