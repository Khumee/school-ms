<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin - Tenants</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
    </style>
</head>
<body>
    <nav class="main-nav">
        <div class="nav-container">
            <a href="/admin" class="brand-link" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
                <img src="/images/omnischool_logo.png" alt="OmniSchool" style="height: 32px; width: auto; border-radius: 4px;">
                <span class="brand-name" style="font-weight: 700; color: #1e293b;">OmniSchool</span>
            </a>
            <ul class="nav-links">
                <li class="user-menu">
                    <span class="user-greeting"><i class="bi bi-person-circle"></i> Hi, <%= username %></span>
                    <a href="/admin/logout" class="btn-danger nav-btn"><i class="bi bi-box-arrow-right"></i> Logout</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        <div class="section-header">
            <h1 class="section-title"><i class="bi bi-buildings"></i> Tenants</h1>
            <a href="/admin/tenants/new" class="btn-primary" style="display: inline-flex; align-items: center; gap: 0.5rem;"><i class="bi bi-plus-circle"></i> Add Tenant</a>
        </div>

        <% if (success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="card table-container">
            <table>
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>School Name</th>
                        <th>Subdomain</th>
                        <th>Custom Domain</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% tenants.forEach(t => { %>
                        <tr>
                            <td><img src="<%= t.logo_url %>" alt="logo" style="height: 32px; max-width: 80px; object-fit: contain;"></td>
                            <td style="font-weight: 600;"><%= t.school_name %></td>
                            <td><%= t.subdomain %></td>
                            <td><%= t.custom_domain || '-' %></td>
                            <td>
                                <span class="status-cell <%= t.status === 'active' ? 'status-paid' : 'status-unpaid' %>">
                                    <i class="bi <%= t.status === 'active' ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' %>"></i>
                                    <%= t.status.toUpperCase() %>
                                </span>
                            </td>
                            <td><%= new Date(t.created_at).toLocaleDateString() %></td>
                            <td style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                <a href="/admin/tenants/<%= t.id %>/contract" class="btn-primary nav-btn" style="background-color: #2563eb; color: white;"><i class="bi bi-file-earmark-text"></i> Contract</a>
                                <a href="/admin/tenants/<%= t.id %>/billing" class="btn-primary nav-btn" style="background-color: #10b981; color: white;"><i class="bi bi-wallet2"></i> Billing</a>
                                <a href="/admin/tenants/<%= t.id %>/edit" class="btn-secondary nav-btn"><i class="bi bi-pencil-square"></i> Edit</a>
                                <button type="button" class="btn-danger nav-btn" onclick="openDeleteModal('<%= t.id %>', '<%= t.subdomain %>')"><i class="bi bi-trash"></i> Delete</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6);">
        <div class="modal-content" style="background-color: #fff; margin: 10% auto; padding: 2rem; border-radius: 8px; max-width: 500px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h3 style="color: #dc2626; margin-top: 0; font-size: 1.25rem;"><i class="bi bi-exclamation-triangle-fill"></i> Danger Zone</h3>
            <p style="color: #475569; line-height: 1.5; margin-bottom: 1.5rem; font-size: 0.95rem;">
                You are about to permanently delete this tenant. This will wipe all users, students, and financial data. This action <strong>CANNOT</strong> be undone.
            </p>
            <p style="color: #0f172a; margin-bottom: 0.5rem; font-size: 0.9rem;">
                Please type <strong id="deleteConfirmTarget" style="user-select: none; color: #dc2626; padding: 0.1rem 0.4rem; background: #fee2e2; border-radius: 4px;"></strong> to confirm.
            </p>
            <form id="deleteForm" method="POST" action="">
                <input type="text" id="deleteConfirmInput" class="form-control" autocomplete="off" oninput="validateDelete()" style="margin-bottom: 1.5rem;" required>
                
                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeDeleteModal()">Cancel</button>
                    <button type="submit" id="deleteSubmitBtn" class="btn-danger" disabled>Delete this tenant</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentDeleteSubdomain = '';

        function openDeleteModal(tenantId, subdomain) {
            currentDeleteSubdomain = subdomain;
            document.getElementById('deleteConfirmTarget').innerText = subdomain;
            document.getElementById('deleteForm').action = '/admin/tenants/' + tenantId + '/delete';
            document.getElementById('deleteConfirmInput').value = '';
            document.getElementById('deleteSubmitBtn').disabled = true;
            document.getElementById('deleteModal').style.display = 'block';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
        }

        function validateDelete() {
            const input = document.getElementById('deleteConfirmInput').value;
            document.getElementById('deleteSubmitBtn').disabled = (input !== currentDeleteSubdomain);
        }

        window.onclick = function(event) {
            const modal = document.getElementById('deleteModal');
            if (event.target == modal) {
                closeDeleteModal();
            }
        }
    </script>
</body>
</html>
