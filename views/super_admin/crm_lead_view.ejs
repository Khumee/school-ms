<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lead.school_name %> - Lead 360 View</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 1.5rem;
        }
        @media (max-width: 900px) {
            .grid-2col { grid-template-columns: 1fr; }
        }
        .timeline-item {
            border-left: 3px solid #cbd5e1;
            padding-left: 1.25rem;
            position: relative;
            padding-bottom: 1.5rem;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -7px;
            top: 0;
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background-color: #4f46e5;
        }
    </style>
</head>
<body>
    <%- include('nav', { activeTab: 'leads', req: typeof req !== 'undefined' ? req : {} }) %>

    <main class="main-content">
        <div class="section-header">
            <div>
                <h1 class="section-title" style="margin-bottom: 0.25rem;"><i class="bi bi-building"></i> <%= lead.school_name %></h1>
                <div style="color: #64748b; font-size: 0.9rem;"><i class="bi bi-geo-alt"></i> <%= lead.address ? lead.address + ', ' : '' %><%= lead.city || '' %></div>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <button type="button" class="btn-primary" onclick="openMeetingModal()" style="background-color: #10b981;">
                    <i class="bi bi-calendar-plus"></i> Log Visit / Meeting
                </button>
                <% if (lead.converted_tenant_id) { %>
                    <span class="status-cell status-paid" style="padding: 0.5rem 1rem; font-size: 0.9rem;"><i class="bi bi-check-circle-fill"></i> Converted Tenant (#<%= lead.converted_tenant_id %>)</span>
                <% } else if (typeof role === 'undefined' || role === 'super_admin') { %>
                    <button type="button" class="btn-primary" onclick="openConvertModal()" style="background-color: #2563eb;">
                        <i class="bi bi-arrow-right-circle"></i> Convert to Tenant
                    </button>
                <% } %>
                <a href="/admin/crm/leads" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>

        <!-- Next Meeting Banner if scheduled -->
        <% if (lead.next_meeting_date) { %>
            <div style="background: linear-gradient(135deg, #fef08a, #fde047); color: #713f12; padding: 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; border: 1px solid #facc15; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <strong style="font-size: 1.1rem; display: block; margin-bottom: 0.25rem;"><i class="bi bi-bell-fill" style="color: #c2410c;"></i> Upcoming Scheduled Visit / Follow-up</strong>
                    <div>Date: <strong><%= new Date(lead.next_meeting_date).toLocaleString([], {weekday:'short', year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></strong></div>
                    <% if (lead.next_meeting_agenda) { %>
                        <div style="font-size: 0.9rem; margin-top: 0.2rem;">Agenda: <%= lead.next_meeting_agenda %></div>
                    <% } %>
                </div>
                <button type="button" class="btn-primary" onclick="openMeetingModal()" style="background-color: #854d0e; border: none; color: white;">
                    <i class="bi bi-check2-circle"></i> Complete / Update Meeting
                </button>
            </div>
        <% } %>

        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
            <!-- Left Column: Lead Info Card & Commercial Rates -->
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <!-- Lead Details Card -->
                <div style="background: #ffffff; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f1f5f9;">
                        <i class="bi bi-info-circle-fill" style="color: #4f46e5;"></i> Lead Information
                    </h3>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
                        <div><strong style="color: #64748b;">Contact Person:</strong> <%= lead.contact_person %> (<%= lead.designation || 'Contact' %>)</div>
                        <div><strong style="color: #64748b;">Phone:</strong> <a href="tel:<%= lead.phone %>" style="color: #2563eb; text-decoration: none;"><%= lead.phone %></a></div>
                        <div><strong style="color: #64748b;">Email:</strong> <%= lead.email || 'N/A' %></div>
                        <div><strong style="color: #64748b;">City / Address:</strong> <%= lead.city || '' %>, <%= lead.address || 'N/A' %></div>
                        <div><strong style="color: #64748b;">Est. Student Count:</strong> <%= lead.est_students || 0 %></div>
                        <div><strong style="color: #64748b;">Current System:</strong> <%= lead.current_system || 'Manual / Paper' %></div>
                        <div><strong style="color: #64748b;">Assigned Rep:</strong> <span style="background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;"><%= lead.rep_name || 'Unassigned' %></span></div>
                        <div><strong style="color: #64748b;">Lead Source:</strong> <%= lead.lead_source || 'Direct Outreach' %></div>
                        <% if (lead.notes) { %>
                            <div style="margin-top: 0.5rem; padding: 0.75rem; background: #f8fafc; border-radius: 6px; border-left: 3px solid #6366f1; font-size: 0.85rem;">
                                <strong>Internal Notes:</strong> <%= lead.notes %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Agreed Commercial Rates Card -->
                <div style="background: #ffffff; padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #f1f5f9;">
                        <i class="bi bi-currency-dollar" style="color: #10b981;"></i> Commercial Rates & Commission
                    </h3>

                    <form action="/admin/crm/leads/<%= lead.id %>/pricing" method="POST" style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Agreed Setup / Onboarding Fee (PKR)</label>
                            <input type="number" step="0.01" name="agreed_setup_fee" class="form-control" value="<%= lead.agreed_setup_fee || 0 %>" <%= (typeof role !== 'undefined' && role === 'sales_rep') ? 'readonly' : '' %>>
                        </div>
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Agreed Monthly SaaS Fee (PKR)</label>
                            <input type="number" step="0.01" name="agreed_monthly_rate" class="form-control" value="<%= lead.agreed_monthly_rate || 0 %>" <%= (typeof role !== 'undefined' && role === 'sales_rep') ? 'readonly' : '' %>>
                        </div>
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Agreed Per-Student Monthly Rate (PKR)</label>
                            <input type="number" step="0.01" name="agreed_rate_per_student" class="form-control" value="<%= lead.agreed_rate_per_student || 0 %>" <%= (typeof role !== 'undefined' && role === 'sales_rep') ? 'readonly' : '' %>>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                            <div class="form-group">
                                <label style="font-size: 0.8rem; font-weight: 600;">Sales Rep Comm (%)</label>
                                <input type="number" step="0.1" name="rep_commission_pct" class="form-control" value="<%= lead.rep_commission_pct || 0 %>" <%= (typeof role !== 'undefined' && role === 'sales_rep') ? 'readonly' : '' %>>
                            </div>
                            <div class="form-group">
                                <label style="font-size: 0.8rem; font-weight: 600;">Flat Comm (PKR)</label>
                                <input type="number" step="0.01" name="rep_commission_flat" class="form-control" value="<%= lead.rep_commission_flat || 0 %>" <%= (typeof role !== 'undefined' && role === 'sales_rep') ? 'readonly' : '' %>>
                            </div>
                        </div>
                        <% if (typeof role === 'undefined' || role === 'super_admin') { %>
                            <button type="submit" class="btn-primary" style="background-color: #7e22ce; margin-top: 0.5rem;"><i class="bi bi-save"></i> Save Financial Rates</button>
                        <% } %>
                    </form>
                </div>
            </div>

            <!-- Right Column: Meetings, Customer Demands & Visit Expenses Timeline -->
            <div class="card" style="padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0; font-size: 1.1rem; color: #0f172a;"><i class="bi bi-journal-text"></i> Meetings & Visits History (<%= meetings.length %>)</h3>
                    <button type="button" class="btn-primary" onclick="openMeetingModal()" style="font-size: 0.85rem;"><i class="bi bi-plus-lg"></i> Record Meeting</button>
                </div>

                <% if (meetings.length > 0) { %>
                    <div style="display: flex; flex-direction: column;">
                        <% meetings.forEach(m => { %>
                            <div class="timeline-item">
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                                    <strong style="color: #0f172a; font-size: 0.95rem;">
                                        <i class="bi bi-calendar-check"></i> <%= new Date(m.meeting_date).toLocaleString([], {weekday:'short', year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %>
                                    </strong>
                                    <span class="status-cell" style="background-color: #f1f5f9; color: #475569; font-size: 0.75rem; text-transform: uppercase;">
                                        <%= m.meeting_type.replace('_', ' ') %>
                                    </span>
                                </div>

                                <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.2rem;">
                                    By: <strong><%= m.rep_name %></strong> | Person Met: <strong><%= m.person_met || lead.contact_person %></strong>
                                </div>

                                <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 0.75rem; margin-top: 0.5rem; font-size: 0.9rem;">
                                    <strong style="color: #334155; display: block; margin-bottom: 0.25rem;">Discussion Notes:</strong>
                                    <div style="white-space: pre-line; color: #1e293b;"><%= m.discussion_notes %></div>

                                    <% if (m.client_demands) { %>
                                        <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #cbd5e1; color: #991b1b; background-color: #fef2f2; padding: 0.5rem; border-radius: 6px;">
                                            <strong style="display: block;"><i class="bi bi-exclamation-circle-fill"></i> Customer Demands / Special Commands:</strong>
                                            <div style="white-space: pre-line;"><%= m.client_demands %></div>
                                        </div>
                                    <% } %>
                                </div>

                                <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; font-size: 0.8rem; color: #475569;">
                                    <% if (m.expense_amount > 0) { %>
                                        <div style="background-color: #fef3c7; color: #92400e; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 600;">
                                            <i class="bi bi-wallet2"></i> Visit Expense: Rs. <%= Number(m.expense_amount).toLocaleString() %> <%= m.expense_notes ? `(${m.expense_notes})` : '' %>
                                        </div>
                                    <% } %>
                                    <div style="font-weight: 600;">
                                        Outcome: <span style="color: #4f46e5; text-transform: uppercase;"><%= m.outcome.replace('_', ' ') %></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div style="text-align: center; color: #64748b; padding: 3rem 1rem; background-color: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;">
                        <i class="bi bi-chat-left-dots" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem; color: #94a3b8;"></i>
                        No meetings or visits logged for this lead yet.
                        <div style="margin-top: 1rem;">
                            <button type="button" class="btn-primary" onclick="openMeetingModal()"><i class="bi bi-plus-lg"></i> Log First Visit / Meeting</button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <!-- LOG MEETING MODAL -->
    <div id="meetingModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #ffffff; padding: 2rem; border-radius: 12px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin-top: 0; color: #4f46e5; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;"><i class="bi bi-journal-plus"></i> Record Meeting / Visit</h3>
            
            <form action="/admin/crm/leads/<%= lead.id %>/meeting" method="POST">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label style="font-weight: 600;">Meeting Date & Time</label>
                        <input type="datetime-local" name="meeting_date" class="form-control" value="<%= new Date().toISOString().slice(0, 16) %>" required>
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Meeting Type</label>
                        <select name="meeting_type" class="form-control">
                            <option value="in_person_visit">In-Person School Visit</option>
                            <option value="phone_call">Phone Call</option>
                            <option value="video_demo">Online Video Demo</option>
                            <option value="follow_up">Follow-up</option>
                        </select>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label style="font-weight: 600;">Person Met</label>
                        <input type="text" name="person_met" class="form-control" value="<%= lead.contact_person %>" placeholder="e.g. Principal / Director">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600;">Meeting Outcome</label>
                        <select name="outcome" class="form-control">
                            <option value="requires_followup">Requires Follow-up</option>
                            <option value="positive">Positive Interest</option>
                            <option value="demo_requested">Demo Requested</option>
                            <option value="deal_closed">Deal Closed / Won</option>
                            <option value="neutral">Neutral</option>
                            <option value="rejected">Rejected / Not Interested</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Discussion Notes</label>
                    <textarea name="discussion_notes" class="form-control" rows="3" placeholder="Key topics discussed, feedback given..." required></textarea>
                </div>

                <div class="form-group" style="margin-bottom: 1rem; background-color: #fef2f2; padding: 0.75rem; border-radius: 8px; border: 1px solid #fecaca;">
                    <label style="font-weight: 600; color: #991b1b;"><i class="bi bi-chat-right-text-fill"></i> Specific Customer Demands / Commands</label>
                    <textarea name="client_demands" class="form-control" rows="2" placeholder="Record any feature requests, specific discount demands, or custom conditions from customer..."></textarea>
                </div>

                <!-- Visit Expense Section -->
                <div style="background: #fdf4ff; border: 1px solid #f0abfc; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">
                    <h4 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 0.95rem; color: #86198f;"><i class="bi bi-wallet2"></i> Meeting Visit Expense (Optional)</h4>
                    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 0.75rem;">
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Amount (PKR)</label>
                            <input type="number" step="0.01" name="expense_amount" class="form-control" placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Expense Notes</label>
                            <input type="text" name="expense_notes" class="form-control" placeholder="e.g. Fuel, Lunch, Printed Brochures">
                        </div>
                    </div>
                </div>

                <!-- Next Meeting Schedule -->
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
                    <h4 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 0.95rem; color: #1e3a8a;"><i class="bi bi-calendar-event"></i> Schedule Next Visit / Meeting (Optional)</h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Next Date & Time</label>
                            <input type="datetime-local" name="next_meeting_date" class="form-control">
                        </div>
                        <div class="form-group">
                            <label style="font-size: 0.8rem; font-weight: 600;">Next Meeting Agenda</label>
                            <input type="text" name="next_meeting_agenda" class="form-control" placeholder="e.g. Staff Demo, Final Contract Signing">
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeMeetingModal()">Cancel</button>
                    <button type="submit" class="btn-primary" style="background-color: #10b981;"><i class="bi bi-save"></i> Save Meeting Record</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CONVERT TO TENANT MODAL -->
    <div id="convertModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #ffffff; padding: 2rem; border-radius: 12px; max-width: 500px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin-top: 0; color: #2563eb; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;"><i class="bi bi-building-add"></i> Convert Lead to Active Tenant</h3>
            
            <form action="/admin/crm/leads/<%= lead.id %>/convert" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">School / Tenant Name</label>
                    <input type="text" name="school_name" class="form-control" value="<%= lead.school_name %>" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Subdomain (URL Key)</label>
                    <input type="text" name="subdomain" class="form-control" value="<%= lead.school_name.toLowerCase().replace(/[^a-z0-9]/g, '') %>" required>
                    <small style="color: #64748b;">This will form school URL: e.g. <code>subdomain.omnischool.pk</code></small>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Admin User Email</label>
                    <input type="email" name="admin_email" class="form-control" value="<%= lead.email || '' %>" required>
                </div>
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="font-weight: 600;">Initial Admin Password</label>
                    <input type="password" name="admin_password" class="form-control" placeholder="Set default password" required>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeConvertModal()">Cancel</button>
                    <button type="submit" class="btn-primary" style="background-color: #2563eb;"><i class="bi bi-check-circle"></i> Create Tenant</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openMeetingModal() {
            document.getElementById('meetingModal').style.display = 'flex';
        }
        function closeMeetingModal() {
            document.getElementById('meetingModal').style.display = 'none';
        }
        function openConvertModal() {
            document.getElementById('convertModal').style.display = 'flex';
        }
        function closeConvertModal() {
            document.getElementById('convertModal').style.display = 'none';
        }
    </script>
</body>
</html>
