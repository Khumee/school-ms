<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scraper Coverage Map</title>
    <!-- Common CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .btn-back {
            background: #e2e8f0;
            color: #475569;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        #map {
            height: 75vh;
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>
    
    <%- include('nav') %>

    <div class="container">
        <div class="header">
            <div>
                <h1 style="margin: 0; font-size: 1.5rem; color: #1e293b;">Scraper Coverage Map</h1>
                <p style="margin: 0.25rem 0 0 0; color: #64748b; font-size: 0.9rem;">Visualizing all successfully scraped 3km blocks across Pakistan.</p>
            </div>
            <div style="display: flex; gap: 1rem; align-items: center;">
                <% 
                    let usagePct = Math.min((apiUsage / apiLimit) * 100, 100);
                    let usageColor = usagePct >= 100 ? '#ef4444' : (usagePct >= 80 ? '#f59e0b' : '#3b82f6');
                %>
                <div style="display: flex; align-items: center; background: white; border: 1px solid #cbd5e1; border-radius: 6px; padding: 0.25rem 0.75rem; font-size: 0.85rem; font-weight: 600; color: #475569; height: 38px;" title="Google Maps API Usage this month">
                    <i class="bi bi-google" style="margin-right: 0.5rem; color: <%= usageColor %>;"></i>
                    <span style="margin-right: 0.5rem;"><%= apiUsage %> / <%= apiLimit %></span>
                    <div style="width: 40px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden; margin-top: 1px;">
                        <div style="height: 100%; width: <%= usagePct %>%; background: <%= usageColor %>;"></div>
                    </div>
                </div>
                <a href="/admin/crm/prescreening" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Prescreening</a>
            </div>
        </div>

        <div id="map"></div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        // Pass server data to frontend
        const gridStates = <%- JSON.stringify(grid_states || []) %>;
        
        // Initialize map centered roughly on Pakistan
        const map = L.map('map').setView([30.3753, 69.3451], 6);

        // Add OpenStreetMap tiles (Free, no API key needed)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // Helper function: Reproduces the spiral index to coordinate offset mapping
        function getSpiralOffset(n) {
            let x = 0, y = 0, dx = 0, dy = -1;
            for (let i = 0; i < n; i++) {
                if (x === y || (x < 0 && x === -y) || (x > 0 && x === 1 - y)) {
                    let temp = dx;
                    dx = -dy;
                    dy = temp;
                }
                x += dx;
                y += dy;
            }
            return { x, y };
        }

        const gridStepDegrees = 0.027; // ~3km step

        gridStates.forEach(state => {
            const centerLat = parseFloat(state.center_lat);
            const centerLng = parseFloat(state.center_lng);
            
            // Add a marker for the city center
            L.marker([centerLat, centerLng])
                .addTo(map)
                .bindPopup(`<b>${state.city}</b><br>Blocks Scraped: ${state.spiral_index}`);

            // Draw a circle for EVERY spiral step completed so far
            for (let i = 0; i < state.spiral_index; i++) {
                const offset = getSpiralOffset(i);
                const lat = centerLat + (offset.y * gridStepDegrees);
                const lng = centerLng + (offset.x * gridStepDegrees);
                
                // Draw a 3000 meter (3km) radius circle
                L.circle([lat, lng], {
                    color: '#3b82f6',
                    fillColor: '#3b82f6',
                    fillOpacity: 0.15,
                    weight: 1,
                    radius: 3000
                }).addTo(map);
            }
        });
    </script>
</body>
</html>
