<style>
    .superadmin-nav-bar {
        display: flex;
        gap: 0.5rem;
        background: #ffffff;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 1.5rem;
        align-items: center;
        flex-wrap: wrap;
    }
    .superadmin-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        color: #64748b;
        transition: all 0.15s ease;
    }
    .superadmin-nav-link:hover {
        background-color: #f1f5f9;
        color: #1e293b;
    }
    .superadmin-nav-link.active {
        background-color: #4f46e5;
        color: #ffffff;
        box-shadow: 0 2px 4px rgba(79, 70, 229, 0.25);
    }
</style>

<nav class="main-nav">
    <div class="nav-container">
        <a href="/admin" class="brand-link" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; white-space: nowrap;">
            <img src="/images/omnischool_logo.png" alt="OmniSchool" style="height: 32px; width: auto; border-radius: 4px;">
            <span class="brand-name" style="font-weight: 700; color: #1e293b; white-space: nowrap; font-size: 1.1rem;">OmniSchool Super Admin</span>
        </a>
        <ul class="nav-links">
            <li class="user-menu" style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="user-greeting"><i class="bi bi-person-circle"></i> Hi, <%= typeof username !== 'undefined' ? username : (req.session.masterAdminUsername || 'Admin') %></span>
                <button type="button" onclick="openAdminPasswordModal()" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-weight: 600; padding: 0.4rem 0.85rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem;">
                    <i class="bi bi-key-fill" style="color: #6366f1;"></i> Change Password
                </button>
                <a href="/admin/logout" class="btn-danger nav-btn"><i class="bi bi-box-arrow-right"></i> Logout</a>
            </li>
        </ul>
    </div>
</nav>

<% const userRole = (typeof role !== 'undefined' && role) ? role : (typeof req !== 'undefined' && req.session ? req.session.masterAdminRole : 'super_admin'); %>

<div class="superadmin-nav-bar">
    <% if (userRole === 'super_admin') { %>
        <a href="/admin" class="superadmin-nav-link <%= activeTab === 'tenants' ? 'active' : '' %>">
            <i class="bi bi-buildings"></i> Tenants
        </a>
    <% } %>
    <% if (userRole === 'super_admin' || userRole === 'sales_rep') { %>
        <a href="/admin/crm/leads" class="superadmin-nav-link <%= activeTab === 'leads' ? 'active' : '' %>">
            <i class="bi bi-funnel-fill"></i> <%= userRole === 'sales_rep' ? 'My Leads' : 'CRM Leads' %>
        </a>
        <a href="/admin/crm/meetings" class="superadmin-nav-link <%= activeTab === 'meetings' ? 'active' : '' %>">
            <i class="bi bi-calendar-event"></i> <%= userRole === 'sales_rep' ? 'My Meetings & Visits' : 'Meetings & Visits' %>
        </a>
        <% if (userRole === 'super_admin') { %>
            <a href="/admin/crm/team" class="superadmin-nav-link <%= activeTab === 'team' ? 'active' : '' %>">
                <i class="bi bi-people-fill"></i> Sales Team
            </a>
        <% } %>
        <a href="/admin/crm/finances" class="superadmin-nav-link <%= activeTab === 'finances' ? 'active' : '' %>">
            <i class="bi bi-cash-stack"></i> <%= userRole === 'sales_rep' ? 'My Expenses & Advances' : 'Finances & Expenses' %>
        </a>
    <% } %>
    <% if (userRole === 'super_admin' || userRole === 'support_agent') { %>
        <a href="/admin/support/tickets" class="superadmin-nav-link <%= activeTab === 'support_tickets' ? 'active' : '' %>">
            <i class="bi bi-life-preserver"></i> Support Tickets
        </a>
        <% if (userRole === 'super_admin') { %>
            <a href="/admin/support/team" class="superadmin-nav-link <%= activeTab === 'support_team' ? 'active' : '' %>">
                <i class="bi bi-headset"></i> Support Team
            </a>
        <% } %>
    <% } %>
</div>

<!-- Change Password Modal for Master Admins / Sales Reps -->
<div id="adminPasswordModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; width: 100%; max-width: 440px; border-radius: 12px; padding: 1.75rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); border: 1px solid #e2e8f0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 0.5rem;">
                <i class="bi bi-shield-lock-fill" style="color: #4f46e5;"></i> Change Password
            </h3>
            <button type="button" onclick="closeAdminPasswordModal()" style="background: none; border: none; font-size: 1.25rem; color: #64748b; cursor: pointer;">&times;</button>
        </div>

        <form action="/admin/change-password" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.35rem;">Current Password</label>
                <input type="password" name="current_password" required class="form-control" placeholder="Enter current password" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem;">
            </div>
            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.35rem;">New Password</label>
                <input type="password" name="new_password" required minlength="6" class="form-control" placeholder="Minimum 6 characters" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem;">
            </div>
            <div>
                <label style="font-size: 0.85rem; font-weight: 600; color: #334155; display: block; margin-bottom: 0.35rem;">Confirm New Password</label>
                <input type="password" name="confirm_password" required minlength="6" class="form-control" placeholder="Re-enter new password" style="width: 100%; padding: 0.6rem 0.75rem; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.9rem;">
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem; padding-top: 0.75rem; border-top: 1px solid #f1f5f9;">
                <button type="button" onclick="closeAdminPasswordModal()" class="btn-secondary" style="padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer;">Cancel</button>
                <button type="submit" class="btn-primary" style="background: #4f46e5; border: none; color: white; padding: 0.5rem 1.25rem; border-radius: 6px; font-weight: 600; cursor: pointer;">Update Password</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAdminPasswordModal() {
        document.getElementById('adminPasswordModal').style.display = 'flex';
    }
    function closeAdminPasswordModal() {
        document.getElementById('adminPasswordModal').style.display = 'none';
    }
</script>
