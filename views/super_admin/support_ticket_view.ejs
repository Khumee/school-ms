<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= ticket.subject %> - Support Ticket</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
        .badge-status { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.3rem 0.75rem; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
        .status-open { background-color: #e0f2fe; color: #0369a1; }
        .status-in_progress { background-color: #fef3c7; color: #b45309; }
        .status-resolved { background-color: #dcfce7; color: #15803d; }
        .status-closed { background-color: #f1f5f9; color: #475569; }
        .msg-bubble { border-radius: 10px; padding: 0.9rem 1rem; margin-bottom: 1rem; max-width: 80%; }
        .msg-tenant { background-color: #eff6ff; border: 1px solid #bfdbfe; margin-right: auto; }
        .msg-support { background-color: #f0fdf4; border: 1px solid #bbf7d0; margin-left: auto; }
        .msg-shot { max-width: 260px; border-radius: 8px; margin-top: 0.6rem; display: block; border: 1px solid #e2e8f0; }
    </style>
</head>
<body>
    <%- include('nav', { activeTab: 'support_tickets', req: typeof req !== 'undefined' ? req : {} }) %>

    <main class="main-content">
        <div class="section-header">
            <div>
                <h1 class="section-title" style="margin-bottom: 0.25rem;"><i class="bi bi-life-preserver"></i> <%= ticket.subject %></h1>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span class="badge-status status-<%= ticket.status %>"><%= ticket.status.replace('_', ' ') %></span>
                    <span style="color: #64748b; font-size: 0.9rem;"><i class="bi bi-building"></i> <%= ticket.school_name %></span>
                </div>
            </div>
            <a href="/admin/support/tickets" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
            <div style="font-size: 0.85rem; color: #64748b; margin-bottom: 0.5rem;">
                Raised by <strong><%= ticket.created_by_name || 'N/A' %></strong> on <%= new Date(ticket.created_at).toLocaleString([], {year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %>
            </div>
            <div style="white-space: pre-line; color: #1e293b;"><%= ticket.description %></div>
            <% if (ticket.screenshot_path) { %>
                <a href="<%= ticket.screenshot_path %>" target="_blank"><img src="<%= ticket.screenshot_path %>" class="msg-shot" alt="Screenshot"></a>
            <% } %>
        </div>

        <div class="card" style="padding: 1.5rem;">
            <h3 style="margin-top: 0; font-size: 1.05rem; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem; margin-bottom: 1.25rem;"><i class="bi bi-chat-left-text-fill"></i> Conversation</h3>

            <% if (messages.length > 0) { %>
                <% messages.forEach(m => { %>
                    <div class="msg-bubble <%= m.sender_role === 'tenant' ? 'msg-tenant' : 'msg-support' %>">
                        <div style="font-size: 0.8rem; font-weight: 700; color: <%= m.sender_role === 'tenant' ? '#1d4ed8' : '#15803d' %>; margin-bottom: 0.3rem;">
                            <%= m.sender_name || (m.sender_role === 'tenant' ? 'Tenant' : 'Support') %> · <%= m.sender_role === 'tenant' ? 'School' : 'Support Team' %>
                        </div>
                        <% if (m.message) { %><div style="white-space: pre-line;"><%= m.message %></div><% } %>
                        <% if (m.screenshot_path) { %>
                            <a href="<%= m.screenshot_path %>" target="_blank"><img src="<%= m.screenshot_path %>" class="msg-shot" alt="Screenshot"></a>
                        <% } %>
                        <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 0.4rem;"><%= new Date(m.created_at).toLocaleString([], {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; color: #64748b; padding: 2rem 1rem; background-color: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; margin-bottom: 1.25rem;">
                    No replies yet.
                </div>
            <% } %>

            <form action="/admin/support/tickets/<%= ticket.id %>/reply" method="POST" enctype="multipart/form-data" style="margin-top: 1.5rem; border-top: 1px solid #f1f5f9; padding-top: 1.25rem;">
                <div class="form-group" style="margin-bottom: 0.75rem;">
                    <label style="font-weight: 600;">Respond to School</label>
                    <textarea name="message" class="form-control" rows="3" placeholder="Type your response..."></textarea>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.85rem;">Attach a Screenshot (Optional)</label>
                        <input type="file" name="screenshot" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.85rem;">Update Status</label>
                        <select name="status" class="form-control">
                            <option value="open" <%= ticket.status === 'open' ? 'selected' : '' %>>Open</option>
                            <option value="in_progress" <%= ticket.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="resolved" <%= ticket.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                            <option value="closed" <%= ticket.status === 'closed' ? 'selected' : '' %>>Closed</option>
                        </select>
                    </div>
                </div>
                <div style="display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn-primary"><i class="bi bi-send-fill"></i> Send Response</button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
