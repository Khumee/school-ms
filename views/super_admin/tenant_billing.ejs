<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8fafc; font-family: 'Inter', sans-serif; }
        .card { border: none; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border-radius: 12px; margin-bottom: 24px; }
        .card-header { background: linear-gradient(135deg, #1e293b, #0f172a); color: white; border-radius: 12px 12px 0 0 !important; display: flex; justify-content: space-between; align-items: center;}
        .table th { background-color: #f1f5f9; color: #475569; font-weight: 600; }
        .badge-draft { background-color: #94a3b8; }
        .badge-sent { background-color: #3b82f6; }
        .badge-paid { background-color: #10b981; }
        .badge-overdue { background-color: #ef4444; }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4><i class="bi bi-wallet2"></i> Billing & Invoices: <%= tenant.name %></h4>
            <div>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateInvoiceModal">
                    <i class="bi bi-plus-lg"></i> Generate Invoice
                </button>
                <button class="btn btn-success ms-2" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
                    <i class="bi bi-cash-coin"></i> Record Payment
                </button>
                <a href="/admin" class="btn btn-secondary ms-2">Back to Tenants</a>
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="row">
            <div class="col-md-3">
                <div class="card text-center py-4">
                    <h6 class="text-muted text-uppercase mb-2">Active Students</h6>
                    <h2 class="mb-0 text-primary"><%= activeStudents %></h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center py-4">
                    <h6 class="text-muted text-uppercase mb-2">Rate (PKR)</h6>
                    <h2 class="mb-0 text-dark"><%= contract ? parseFloat(contract.rate_per_student).toFixed(0) : '0' %></h2>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card text-center py-4" style="background-color: #e0f2fe; border: 1px solid #bae6fd;">
                    <h6 class="text-muted text-uppercase mb-2" style="color: #0369a1 !important;">Suggested Monthly Total</h6>
                    <h2 class="mb-0 text-primary">Rs <%= contract ? (parseFloat(contract.rate_per_student) * activeStudents).toLocaleString() : '0' %></h2>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header py-3">
                <h5 class="mb-0">Invoice History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Issue Date</th>
                                <th>Billing Period</th>
                                <th>Students Billed</th>
                                <th>Total (PKR)</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (invoices.length === 0) { %>
                                <tr><td colspan="7" class="text-center py-4 text-muted">No invoices found for this tenant.</td></tr>
                            <% } %>
                            <% invoices.forEach(inv => { %>
                                <tr>
                                    <td><strong><%= inv.invoice_number %></strong></td>
                                    <td><%= new Date(inv.issue_date).toLocaleDateString() %></td>
                                    <td>
                                        <small class="text-muted">
                                            <%= new Date(inv.billing_period_start).toLocaleDateString() %> - <%= new Date(inv.billing_period_end).toLocaleDateString() %>
                                        </small>
                                    </td>
                                    <td><%= inv.total_students_billed %></td>
                                    <td><strong>Rs <%= parseFloat(inv.total_amount_pkr).toLocaleString() %></strong></td>
                                    <td>
                                        <span class="badge badge-<%= inv.status.toLowerCase() %>"><%= inv.status %></span>
                                    </td>
                                    <td class="d-flex gap-2">
                                        <a href="/admin/tenants/<%= tenant.id %>/invoices/<%= inv.id %>/view" class="btn btn-sm btn-outline-primary" target="_blank">
                                            <i class="bi bi-file-pdf"></i> View
                                        </a>
                                        <% if (inv.status !== 'Paid') { %>
                                            <form action="/admin/tenants/<%= tenant.id %>/invoices/<%= inv.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this invoice? This cannot be undone.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header py-3">
                <h5 class="mb-0">Payment History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoice Ref</th>
                                <th>Amount Paid (PKR)</th>
                                <th>Method</th>
                                <th>Reference #</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (payments.length === 0) { %>
                                <tr><td colspan="5" class="text-center py-4 text-muted">No payments recorded.</td></tr>
                            <% } %>
                            <% payments.forEach(pay => { %>
                                <tr>
                                    <td><%= new Date(pay.payment_date).toLocaleDateString() %></td>
                                    <td><span class="text-primary"><%= pay.invoice_number %></span></td>
                                    <td><strong class="text-success">Rs <%= parseFloat(pay.amount_paid).toLocaleString() %></strong></td>
                                    <td><%= pay.payment_method %></td>
                                    <td><small class="text-muted"><%= pay.reference_number || '-' %></small></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Generate Invoice Modal -->
    <div class="modal fade" id="generateInvoiceModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generate New Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/tenants/<%= tenant.id %>/invoices/generate" method="POST">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-12 mb-1">
                                <label class="form-label fw-bold" style="margin-bottom: 0;">Billing Period Selection</label>
                                <div>
                                    <div class="form-check form-check-inline mt-1">
                                        <input class="form-check-input" type="radio" name="period_type" id="pt_month" value="month" checked onchange="togglePeriodType()">
                                        <label class="form-check-label" for="pt_month">Select Month</label>
                                    </div>
                                    <div class="form-check form-check-inline mt-1">
                                        <input class="form-check-input" type="radio" name="period_type" id="pt_custom" value="custom" onchange="togglePeriodType()">
                                        <label class="form-check-label" for="pt_custom">Custom Dates</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12" id="month_selector_container">
                                <label class="form-label">Billing Month</label>
                                <input type="month" id="billing_month" class="form-control" onchange="updateCustomDatesFromMonth()">
                            </div>
                            <div class="col-md-6 custom_date_field" style="display:none;">
                                <label class="form-label">Billing Period Start</label>
                                <input type="date" name="billing_period_start" id="billing_period_start" class="form-control" required>
                            </div>
                            <div class="col-md-6 custom_date_field" style="display:none;">
                                <label class="form-label">Billing Period End</label>
                                <input type="date" name="billing_period_end" id="billing_period_end" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Issue Date</label>
                                <input type="date" name="issue_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Due Date</label>
                                <% 
                                    let nextWeek = new Date();
                                    nextWeek.setDate(nextWeek.getDate() + 7);
                                %>
                                <input type="date" name="due_date" class="form-control" value="<%= nextWeek.toISOString().split('T')[0] %>" required>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Students to Bill <small class="text-muted">(Auto-calculated: <%= activeStudents %>)</small></label>
                                <input type="number" name="total_students_billed" class="form-control" value="<%= activeStudents %>" required>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Discount Amount (PKR) <small class="text-muted">(Optional)</small></label>
                                <input type="number" step="0.01" name="discount" class="form-control" value="0">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Internal Notes</label>
                                <textarea name="notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Generate Invoice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Record Payment Modal -->
    <div class="modal fade" id="recordPaymentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Record Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/admin/tenants/<%= tenant.id %>/payments/add" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Select Invoice</label>
                            <select name="invoice_id" class="form-select" required>
                                <% invoices.filter(i => i.status !== 'Paid' && i.status !== 'Cancelled').forEach(inv => { %>
                                    <option value="<%= inv.id %>"><%= inv.invoice_number %> - Rs <%= parseFloat(inv.total_amount_pkr).toLocaleString() %> (Due: <%= new Date(inv.due_date).toLocaleDateString() %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Date</label>
                            <input type="date" name="payment_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Amount Paid (PKR)</label>
                            <input type="number" step="0.01" name="amount_paid" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Payment Method</label>
                            <select name="payment_method" class="form-select" required>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Cash">Cash</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reference / Transaction Number</label>
                            <input type="text" name="reference_number" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Payment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePeriodType() {
            const isMonth = document.getElementById('pt_month').checked;
            document.getElementById('month_selector_container').style.display = isMonth ? 'block' : 'none';
            document.querySelectorAll('.custom_date_field').forEach(el => {
                el.style.display = isMonth ? 'none' : 'block';
            });
            if (isMonth) {
                updateCustomDatesFromMonth();
            }
        }
        
        function updateCustomDatesFromMonth() {
            const monthVal = document.getElementById('billing_month').value;
            if (!monthVal) return;
            const parts = monthVal.split('-');
            const year = parseInt(parts[0]);
            const month = parseInt(parts[1]);
            
            const startDate = `${year}-${month.toString().padStart(2, '0')}-01`;
            const nextMonthDate = new Date(year, month, 0); // Day 0 is last day of previous month, wait!
            // Wait, new Date(year, month, 0) gives the last day of `month`. e.g. new Date(2026, 8, 0) gives Aug 31 because month is 0-indexed in Date, so month=8 is September, day 0 is last day of Aug.
            // But from input type="month", month is 1-indexed. So month=8 is Aug. 
            // So new Date(year, month, 0) gives last day of Aug. That's perfect.
            const endDate = `${year}-${month.toString().padStart(2, '0')}-${nextMonthDate.getDate().toString().padStart(2, '0')}`;
            
            document.getElementById('billing_period_start').value = startDate;
            document.getElementById('billing_period_end').value = endDate;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const year = now.getFullYear();
            const month = (now.getMonth() + 1).toString().padStart(2, '0');
            document.getElementById('billing_month').value = `${year}-${month}`;
            togglePeriodType();
        });
    </script>
</body>
</html>
