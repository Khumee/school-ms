<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin - Sales Team</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #4338ca;
        }
    </style>
</head>
<body>
    <%- include('nav', { activeTab: 'team', req: typeof req !== 'undefined' ? req : {} }) %>

    <main class="main-content">
        <div class="section-header">
            <h1 class="section-title"><i class="bi bi-people-fill"></i> Sales & Marketing Team Roster</h1>
            <button type="button" class="btn-primary" onclick="openAddRepModal()"><i class="bi bi-person-plus-fill"></i> Add Sales Representative</button>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
        <% } %>

        <div class="card table-container">
            <table>
                <thead>
                    <tr>
                        <th>Sales Person Name</th>
                        <th>Username / Login</th>
                        <th>Phone</th>
                        <th>Default Commission %</th>
                        <th>Assigned Leads</th>
                        <th>Meetings Conducted</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (reps.length > 0) { %>
                        <% reps.forEach(r => { %>
                            <tr>
                                <td>
                                    <div style="font-weight: 700; color: #0f172a;"><%= r.name || 'Sales Rep' %></div>
                                    <div style="font-size: 0.8rem; color: #64748b;"><%= r.role === 'super_admin' ? 'Master Admin & Rep' : 'Field Sales Rep' %></div>
                                </td>
                                <td style="font-weight: 600; color: #4f46e5;">@<%= r.username %></td>
                                <td><%= r.phone || '-' %></td>
                                <td style="font-weight: 700; color: #7e22ce;"><%= r.commission_rate || 0 %>%</td>
                                <td style="font-weight: 600;"><%= r.total_leads || 0 %> Leads</td>
                                <td style="font-weight: 600;"><%= r.total_meetings || 0 %> Visits</td>
                                <td>
                                    <span class="status-cell <%= r.is_active ? 'status-paid' : 'status-unpaid' %>">
                                        <i class="bi <%= r.is_active ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' %>"></i>
                                        <%= r.is_active ? 'ACTIVE' : 'INACTIVE' %>
                                    </span>
                                </td>
                                <td style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <button type="button" class="btn-secondary nav-btn" onclick='openEditRepModal(<%- JSON.stringify(r) %>)'><i class="bi bi-pencil"></i> Edit</button>
                                    <form action="/admin/crm/team/<%= r.id %>/toggle" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-secondary nav-btn" style="color: <%= r.is_active ? '#dc2626' : '#16a34a' %>;">
                                            <i class="bi <%= r.is_active ? 'bi-person-x' : 'bi-person-check' %>"></i> <%= r.is_active ? 'Deactivate' : 'Activate' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; color: #64748b; padding: 2rem;">
                                No sales representatives added yet.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- ADD SALES REP MODAL -->
    <div id="addRepModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #ffffff; padding: 2rem; border-radius: 12px; max-width: 450px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin-top: 0; color: #4f46e5; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;"><i class="bi bi-person-plus-fill"></i> Add Sales Representative</h3>
            
            <form action="/admin/crm/team/new" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Full Name *</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Mohammad Ali" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Username *</label>
                    <input type="text" name="username" class="form-control" placeholder="e.g. ali_sales" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Password *</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Phone Number</label>
                    <input type="text" name="phone" class="form-control" placeholder="e.g. 03009876543">
                </div>
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="font-weight: 600;">Default Commission Rate (%)</label>
                    <input type="number" step="0.1" name="commission_rate" class="form-control" value="10.00" placeholder="e.g. 10.0">
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeAddRepModal()">Cancel</button>
                    <button type="submit" class="btn-primary"><i class="bi bi-check-circle"></i> Create Sales Account</button>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT SALES REP MODAL -->
    <div id="editRepModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #ffffff; padding: 2rem; border-radius: 12px; max-width: 450px; width: 90%; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin-top: 0; color: #4f46e5; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;"><i class="bi bi-pencil-square"></i> Edit Sales Representative</h3>
            
            <form id="editRepForm" action="" method="POST">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Full Name *</label>
                    <input type="text" id="edit_name" name="name" class="form-control" required>
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Phone Number</label>
                    <input type="text" id="edit_phone" name="phone" class="form-control">
                </div>
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 600;">Default Commission Rate (%)</label>
                    <input type="number" step="0.1" id="edit_commission_rate" name="commission_rate" class="form-control">
                </div>
                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label style="font-weight: 600;">New Password (Leave blank to keep unchanged)</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••">
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button type="button" class="btn-secondary" onclick="closeEditRepModal()">Cancel</button>
                    <button type="submit" class="btn-primary"><i class="bi bi-save"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openAddRepModal() {
            document.getElementById('addRepModal').style.display = 'flex';
        }
        function closeAddRepModal() {
            document.getElementById('addRepModal').style.display = 'none';
        }
        function openEditRepModal(repData) {
            document.getElementById('editRepForm').action = `/admin/crm/team/${repData.id}/edit`;
            document.getElementById('edit_name').value = repData.name || '';
            document.getElementById('edit_phone').value = repData.phone || '';
            document.getElementById('edit_commission_rate').value = repData.commission_rate || 0;
            document.getElementById('editRepModal').style.display = 'flex';
        }
        function closeEditRepModal() {
            document.getElementById('editRepModal').style.display = 'none';
        }
    </script>
</body>
</html>
