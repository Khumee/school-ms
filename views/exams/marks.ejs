<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
        <div class="row">
            <%- include('../partials/sidebar') %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Enter Marks</h1>
                    <div>
                        <a href="/exams/papers" class="btn btn-outline-secondary">Back to Papers</a>
                    </div>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-md-4">
                                <strong>Class:</strong> <%= paper.class_name %>
                            </div>
                            <div class="col-md-4">
                                <strong>Subject:</strong> <%= paper.subject_name %>
                            </div>
                        </div>
                    </div>
                </div>

                <form action="/exams/marks/<%= paper.id %>" method="POST">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Paper Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3" style="max-width: 300px;">
                                <label for="total_marks" class="form-label fw-bold">Total Marks for Paper</label>
                                <input type="number" step="0.5" class="form-control form-control-lg" id="total_marks" name="total_marks" value="<%= paper.total_marks %>" required>
                                <small class="text-muted">You must define the total marks first.</small>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">Student Marks</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Roll / Reg No</th>
                                            <th>Student Name</th>
                                            <th style="width: 250px;">Obtained Marks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (students.length > 0) { %>
                                            <% students.forEach(s => { %>
                                                <tr>
                                                    <td><%= s.reg_no %></td>
                                                    <td class="fw-bold"><%= s.name %></td>
                                                    <td>
                                                        <input type="number" step="0.5" class="form-control" name="student_marks[<%= s.id %>]" value="<%= marksMap[s.id] !== undefined ? marksMap[s.id] : '' %>" placeholder="Enter marks">
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4">No active students found in this class.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-white text-end">
                            <button type="submit" class="btn btn-success btn-lg px-5">Save All Marks</button>
                        </div>
                    </div>
                </form>
            </main>
        </div>
    </div>
    
    <%- include('../partials/footer_scripts') %>
</body>
</html>
