<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
        <div class="row">
            <%- include('../partials/sidebar') %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Enter Marks</h1>
                    <div>
                        <a href="/exams/papers" class="btn btn-outline-secondary">Back to Papers</a>
                        <a href="/exams/papers/<%= paper.id %>/build" class="btn btn-info text-white ms-2">Build Paper</a>
                    </div>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-md-4">
                                <strong>Class:</strong> <%= paper.class_name %>
                            </div>
                            <div class="col-md-4">
                                <strong>Subject:</strong> <%= paper.subject_name %>
                            </div>
                            <div class="col-md-4 text-end">
                                <strong>Paper Total Marks:</strong> <span class="badge bg-primary fs-6"><%= paper.total_marks %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <form action="/exams/marks/<%= paper.id %>" method="POST">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">Student Marks (By Question)</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered mb-0 text-center align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-start">Roll / Reg No</th>
                                            <th class="text-start">Student Name</th>
                                            <% questions.forEach(q => { %>
                                                <th style="width: 120px;">
                                                    <div class="fw-bold"><%= q.question_text %></div>
                                                    <div class="text-muted small">(<%= q.marks %> marks)</div>
                                                </th>
                                            <% }) %>
                                            <th style="width: 120px;">Obtained Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (questions.length === 0) { %>
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">No questions defined for this paper. <br><a href="/exams/papers/<%= paper.id %>/build" class="btn btn-sm btn-info text-white mt-2">Build Paper Now</a></td>
                                            </tr>
                                        <% } else if (students.length > 0) { %>
                                            <% students.forEach(s => { %>
                                                <tr>
                                                    <td class="text-start"><%= s.reg_no %></td>
                                                    <td class="text-start fw-bold"><%= s.name %></td>
                                                    
                                                    <% let studentTotal = 0; %>
                                                    <% questions.forEach(q => { %>
                                                        <% 
                                                            let qMark = qMarksMap[s.id] && qMarksMap[s.id][q.id] !== undefined ? qMarksMap[s.id][q.id] : ''; 
                                                            if (qMark !== '') studentTotal += parseFloat(qMark);
                                                        %>
                                                        <td>
                                                            <input type="number" step="0.5" class="form-control text-center mx-auto" style="max-width: 90px;" name="student_marks[<%= s.id %>][<%= q.id %>]" value="<%= qMark %>" max="<%= q.marks %>" placeholder="-">
                                                        </td>
                                                    <% }) %>
                                                    
                                                    <td class="fw-bold bg-light"><%= studentTotal %></td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="100%" class="text-center text-muted py-4">No active students found in this class.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <% if (questions.length > 0 && students.length > 0) { %>
                        <div class="card-footer bg-white text-end">
                            <button type="submit" class="btn btn-success btn-lg px-5">Save All Marks</button>
                        </div>
                        <% } %>
                    </div>
                </form>
            </main>
        </div>
    </div>
    
    <%- include('../partials/footer_scripts') %>
</body>
</html>
