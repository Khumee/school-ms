<%- include('../partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title"><i class="bi bi-pencil-square"></i> Enter Marks</h1>
    <div style="display: flex; gap: 0.5rem;">
        <a href="/exams/papers" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Papers</a>
        <a href="/exams/papers/<%= paper.id %>/build" class="btn-secondary" style="color: #0284c7; border-color: #bae6fd; background: #f0f9ff;"><i class="bi bi-tools"></i> Build Paper</a>
    </div>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<div class="card" style="margin-bottom: 1.5rem; background: #f8fafc; border: 1px solid #e2e8f0;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="font-size: 1.05rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Class:</strong> <%= paper.class_name %>
        </div>
        <div style="font-size: 1.05rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Subject:</strong> <%= paper.subject_name %>
        </div>
        <div style="font-size: 1.05rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Paper Total Marks:</strong> 
            <span style="background: var(--primary-color); color: white; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 700; font-size: 1rem;"><%= paper.total_marks %></span>
        </div>
    </div>
</div>

<form action="/exams/marks/<%= paper.id %>" method="POST">
    <div class="card" style="padding: 0; overflow: hidden;">
        <div style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; color: var(--primary-color); font-size: 1.15rem;">
                <i class="bi bi-table"></i> Student Marks (By Question)
            </h3>
            <span style="font-size: 0.85rem; color: var(--muted);"><%= students.length %> active students</span>
        </div>
        
        <div style="overflow-x: auto;">
            <table class="table" style="width: 100%; margin: 0; border-collapse: collapse;">
                <thead style="background: #f1f5f9;">
                    <tr>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Roll / Reg No</th>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Student Name</th>
                        <% questions.forEach(q => { %>
                            <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: center; color: var(--muted); font-weight: 600; min-width: 120px;">
                                <div style="color: var(--ink); font-weight: 700;"><%= q.question_text %></div>
                                <div style="font-size: 0.8rem; font-weight: normal; color: var(--muted);">(<%= q.marks %> marks)</div>
                            </th>
                        <% }) %>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: center; color: var(--muted); font-weight: 600; width: 130px;">Obtained Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (questions.length === 0) { %>
                        <tr>
                            <td colspan="4" style="padding: 3rem; text-align: center; color: var(--muted);">
                                <i class="bi bi-inbox" style="font-size: 2.5rem; color: #cbd5e1; display: block; margin-bottom: 0.75rem;"></i>
                                <strong>No questions defined for this paper yet.</strong><br>
                                <p style="font-size: 0.9rem; color: #64748b; margin: 0.5rem 0 1rem;">Add questions (e.g. Q1, Q2, Q3) to generate the marks entry sheet.</p>
                                <a href="/exams/papers/<%= paper.id %>/build" class="btn-primary" style="display: inline-block;">Build Paper Now</a>
                            </td>
                        </tr>
                    <% } else if (students.length > 0) { %>
                        <% students.forEach(s => { %>
                            <tr class="student-row" data-student-id="<%= s.id %>" style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 0.75rem; font-weight: 500;"><%= s.reg_no %></td>
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--ink);"><%= s.name %></td>
                                
                                <% let studentTotal = 0; %>
                                <% questions.forEach(q => { %>
                                    <% 
                                        let qMark = qMarksMap[s.id] && qMarksMap[s.id][q.id] !== undefined ? qMarksMap[s.id][q.id] : ''; 
                                        if (qMark !== '') studentTotal += parseFloat(qMark);
                                    %>
                                    <td style="padding: 0.75rem; text-align: center;">
                                        <input type="number" step="0.5" class="form-control mark-input" 
                                               style="width: 80px; margin: 0 auto; text-align: center; padding: 0.4rem; font-weight: 600;" 
                                               name="student_marks[<%= s.id %>][<%= q.id %>]" 
                                               value="<%= qMark %>" 
                                               max="<%= q.marks %>" 
                                               min="0"
                                               placeholder="-" 
                                               oninput="recalculateRow(this)">
                                    </td>
                                <% }) %>
                                
                                <td style="padding: 0.75rem; text-align: center; font-weight: 700; background: #f8fafc; color: var(--primary-color); font-size: 1.1rem;" class="row-total">
                                    <%= studentTotal %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="100%" style="padding: 2.5rem; text-align: center; color: var(--muted);">No active students found in this class.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        
        <% if (questions.length > 0 && students.length > 0) { %>
        <div style="padding: 1.5rem; border-top: 1px solid var(--border); background: var(--surface); text-align: right;">
            <button type="submit" class="btn-primary" style="background-color: #16a34a; border-color: #16a34a; padding: 0.75rem 2rem; font-size: 1.05rem;">
                <i class="bi bi-check2-circle"></i> Save All Marks
            </button>
        </div>
        <% } %>
    </div>
</form>

<script>
    function recalculateRow(input) {
        const row = input.closest('.student-row');
        const inputs = row.querySelectorAll('.mark-input');
        let total = 0;
        inputs.forEach(inp => {
            const val = parseFloat(inp.value);
            if (!isNaN(val)) {
                total += val;
            }
        });
        row.querySelector('.row-total').innerText = total;
    }
</script>

<%- include('../partials/footer') %>
