<%- include('../partials/header') %>
<div class="container mt-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Build Exam Paper</h1>
                    <div>
                        <a href="/exams/papers" class="btn btn-outline-secondary">Back to Papers</a>
                        <a href="/exams/marks/<%= paper.id %>" class="btn btn-success ms-2">Enter Marks</a>
                    </div>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-md-4">
                                <strong>Class:</strong> <%= paper.class_name %>
                            </div>
                            <div class="col-md-4">
                                <strong>Subject:</strong> <%= paper.subject_name %>
                            </div>
                            <div class="col-md-4 text-end">
                                <strong>Total Marks:</strong> <span class="badge bg-primary fs-6"><%= paper.total_marks %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h5 class="mb-0">Questions</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th>Question Text</th>
                                                <th style="width: 100px;">Marks</th>
                                                <th style="width: 100px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (questions.length > 0) { %>
                                                <% questions.forEach((q, idx) => { %>
                                                    <tr>
                                                        <td><%= idx + 1 %></td>
                                                        <td class="fw-bold"><%= q.question_text %></td>
                                                        <td><%= q.marks %></td>
                                                        <td>
                                                            <form action="/exams/papers/<%= paper.id %>/questions/delete/<%= q.id %>" method="POST" onsubmit="return confirm('Delete this question? Existing marks for this question will also be deleted.');">
                                                                <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-4">No questions added yet. Add some questions!</td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Add Question</h5>
                            </div>
                            <div class="card-body">
                                <form action="/exams/papers/<%= paper.id %>/questions/add" method="POST">
                                    <div class="mb-3">
                                        <label for="question_text" class="form-label">Question Text (e.g. Q1, or full text)</label>
                                        <input type="text" class="form-control" id="question_text" name="question_text" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="marks" class="form-label">Marks</label>
                                        <input type="number" class="form-control" id="marks" name="marks" required min="1">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">Add Question</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
<%- include('../partials/footer') %>
