<%- include('../partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title"><i class="bi bi-tools"></i> Build Exam Paper</h1>
    <div style="display: flex; gap: 0.5rem;">
        <a href="/exams/papers" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Papers</a>
        <a href="/exams/marks/<%= paper.id %>" class="btn-primary" style="background-color: #16a34a; border-color: #16a34a;"><i class="bi bi-pencil-square"></i> Enter Marks</a>
    </div>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<div class="card" style="margin-bottom: 2rem; background: #f8fafc; border: 1px solid #e2e8f0;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="font-size: 1.1rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Class:</strong> <%= paper.class_name %>
        </div>
        <div style="font-size: 1.1rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Subject:</strong> <%= paper.subject_name %>
        </div>
        <div style="font-size: 1.1rem; color: var(--ink);">
            <strong style="color: var(--muted); margin-right: 0.25rem;">Total Marks:</strong> 
            <span style="background: var(--primary-color); color: white; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 700; font-size: 1rem;"><%= paper.total_marks %></span>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; align-items: start;">
    <div class="card" style="padding: 0; overflow: hidden;">
        <h3 style="margin: 0; padding: 1rem 1.5rem; color: var(--primary-color); border-bottom: 1px solid var(--border); background: #f8fafc;">
            <i class="bi bi-list-ol"></i> Questions
        </h3>
        <div style="overflow-x: auto;">
            <table class="table" style="width: 100%; margin: 0; border-collapse: collapse;">
                <thead style="background: #f1f5f9;">
                    <tr>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 60px;">#</th>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Question Text</th>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 120px;">Marks</th>
                        <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (questions.length > 0) { %>
                        <% questions.forEach((q, idx) => { %>
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 0.75rem; color: var(--muted);"><%= idx + 1 %></td>
                                <td style="padding: 0.75rem; font-weight: 600; color: var(--ink);"><%= q.question_text %></td>
                                <td style="padding: 0.75rem; font-weight: 600; color: #0f766e;"><%= q.marks %></td>
                                <td style="padding: 0.75rem;">
                                    <form action="/exams/papers/<%= paper.id %>/questions/delete/<%= q.id %>" method="POST" onsubmit="return confirm('Delete this question? Existing marks for this question will also be deleted.');" style="margin: 0;">
                                        <button type="submit" class="btn-secondary" style="color: #ef4444; border-color: #fca5a5; background: #fef2f2; padding: 0.25rem 0.6rem; border-radius: 4px;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="padding: 2.5rem; text-align: center; color: var(--muted);">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                                No questions added yet. Add some questions!
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="card">
        <h3 style="margin-bottom: 1.5rem; color: var(--primary-color); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <i class="bi bi-plus-circle"></i> Add Question
        </h3>
        <form action="/exams/papers/<%= paper.id %>/questions/add" method="POST">
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="question_text">Question Text (e.g. Q1, or full text)</label>
                <input type="text" class="form-control" id="question_text" name="question_text" required>
            </div>
            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label for="marks">Marks</label>
                <input type="number" class="form-control" id="marks" name="marks" required min="1">
            </div>
            <button type="submit" class="btn-primary" style="width: 100%;">Add Question</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
