<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <div class="container-fluid mt-4">
        <div class="row">
            <%- include('../partials/sidebar') %>
            
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Exam Papers</h1>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <form action="/exams/papers" method="GET" class="d-flex align-items-center">
                            <label for="exam_id" class="me-3 fw-bold">Select Exam Term:</label>
                            <select name="exam_id" id="exam_id" class="form-select w-auto me-3" onchange="this.form.submit()">
                                <% exams.forEach(e => { %>
                                    <option value="<%= e.id %>" <%= selectedExamId == e.id ? 'selected' : '' %>><%= e.name %></option>
                                <% }) %>
                            </select>
                            
                            <% if (isAdmin && selectedExamId) { %>
                                <div class="ms-auto">
                                    <form action="/exams/generate_papers" method="POST" class="d-inline" onsubmit="return confirm('This will auto-generate papers based on the current timetable. Continue?');">
                                        <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
                                        <button type="submit" class="btn btn-warning"><i class="bi bi-magic"></i> Auto-Generate Papers</button>
                                    </form>
                                </div>
                            <% } %>
                        </form>
                    </div>
                </div>

                <% if (selectedExamId) { %>
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Assigned Papers</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Class</th>
                                        <th>Subject</th>
                                        <th>Assigned Teacher</th>
                                        <th>Total Marks</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (papers.length > 0) { %>
                                        <% papers.forEach(p => { %>
                                            <tr>
                                                <td><%= p.class_name %></td>
                                                <td class="fw-bold"><%= p.subject_name %></td>
                                                <td><%= p.teacher_name %></td>
                                                <td><%= p.total_marks ? p.total_marks : '<span class="badge bg-secondary">Not Set</span>' %></td>
                                                <td>
                                                    <a href="/exams/papers/<%= p.id %>/build" class="btn btn-sm btn-info text-white me-1">Build Paper</a>
                                                    <a href="/exams/marks/<%= p.id %>" class="btn btn-sm btn-primary">Enter Marks</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">No papers found for this exam.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <% } %>
            </main>
        </div>
    </div>
    
    <%- include('../partials/footer_scripts') %>
</body>
</html>
