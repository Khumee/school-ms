<%- include('../partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <h1 class="section-title"><i class="bi bi-file-earmark-text"></i> Exam Papers</h1>
    <div style="display: flex; gap: 0.5rem;">
        <a href="/exams/manage" class="btn-secondary"><i class="bi bi-arrow-left"></i> Manage Exams</a>
        <% if (isAdmin && selectedExamId) { %>
            <button type="button" class="btn-primary" onclick="openAddPaperModal()">
                <i class="bi bi-plus-circle"></i> Add Paper
            </button>
        <% } %>
    </div>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<!-- Standard Filter Panel -->
<details class="filter-panel" open style="margin-bottom: 1.5rem;">
    <summary>
        <span><i class="bi bi-funnel-fill"></i> Filter & Search Papers <%= (classId || search) ? '(Active)' : '' %></span>
        <i class="bi bi-chevron-down toggle-icon"></i>
    </summary>
    <form action="/exams/papers" method="GET" class="filter-content">
        <div class="form-group">
            <label for="exam_id">Exam Term</label>
            <select name="exam_id" id="exam_id" class="form-control" onchange="this.form.submit()">
                <% exams.forEach(e => { %>
                    <option value="<%= e.id %>" <%= selectedExamId == e.id ? 'selected' : '' %>><%= e.name %></option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label for="classId">Class</label>
            <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Classes --</option>
                <% (typeof classes !== 'undefined' ? classes : []).forEach(c => { %>
                    <option value="<%= c.id %>" <%= classId == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="form-group">
            <label for="search">Search</label>
            <input type="text" name="search" id="search" class="form-control" value="<%= search || '' %>" placeholder="Search by Subject or Teacher...">
        </div>
        
        <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
            <button type="submit" class="btn-secondary" style="height: 38px;">Search</button>
            <a href="/exams/papers?exam_id=<%= selectedExamId %>" class="btn-secondary" style="height: 38px; display: inline-flex; align-items: center;">Reset</a>
        </div>
    </form>
</details>

<% if (selectedExamId) { %>
<div class="card" style="padding: 0; overflow: hidden;">
    <div style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="margin: 0; color: var(--primary-color); font-size: 1.15rem;">
            <i class="bi bi-journal-text"></i> Assigned Papers
        </h3>
        <span style="font-size: 0.85rem; color: var(--muted);"><%= papers.length %> papers found</span>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; margin: 0; border-collapse: collapse;">
            <thead style="background: #f1f5f9;">
                <tr>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Class</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Subject</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Assigned Teacher</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Total Marks</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 170px;">Paper Date</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: right; color: var(--muted); font-weight: 600; width: 200px; white-space: nowrap;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (papers.length > 0) { %>
                    <% papers.forEach(p => { %>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.6rem 0.75rem;"><%= p.class_name %></td>
                            <td style="padding: 0.6rem 0.75rem; font-weight: 600; color: var(--ink);"><%= p.subject_name %></td>
                            <td style="padding: 0.6rem 0.75rem;"><%= p.teacher_name || 'Unassigned' %></td>
                            <td style="padding: 0.6rem 0.75rem; white-space: nowrap;">
                                <% if (p.total_marks && Number(p.total_marks) > 0) { %>
                                    <span style="font-weight: 700; color: var(--primary-color);"><%= p.total_marks %></span>
                                <% } else { %>
                                    <span style="font-size: 0.75rem; background: #fef3c7; color: #92400e; padding: 0.2rem 0.55rem; border-radius: 4px; font-weight: 600; display: inline-flex; align-items: center; gap: 0.25rem;">
                                        <i class="bi bi-clock-history"></i> Not Started
                                    </span>
                                <% } %>
                            </td>
                            <td style="padding: 0.6rem 0.75rem; white-space: nowrap;">
                                <div style="display: flex; align-items: center; gap: 0.35rem;">
                                    <input type="date" class="form-control" value="<%= p.paper_date ? new Date(p.paper_date).toISOString().split('T')[0] : '' %>" onchange="updatePaperDate(this, '<%= p.id %>')" style="height: 32px; font-size: 0.82rem; padding: 0.15rem 0.4rem; max-width: 140px; border-radius: 5px;">
                                    <span id="dateSavedIcon_<%= p.id %>" style="display: none; color: #16a34a; font-size: 0.9rem;"><i class="bi bi-check-circle-fill"></i></span>
                                </div>
                            </td>
                            <td style="padding: 0.6rem 0.75rem; text-align: right; white-space: nowrap;">
                                <div style="display: inline-flex; gap: 0.35rem; align-items: center;">
                                    <a href="/exams/papers/<%= p.id %>/build" class="btn-secondary" style="color: #0284c7; border-color: #bae6fd; background: #f0f9ff; padding: 0.25rem 0.6rem; text-decoration: none; font-size: 0.85rem; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.25rem;" title="Build & View Paper Sheet">
                                        <i class="bi bi-file-earmark-ruled"></i> Build
                                    </a>
                                    <a href="/exams/marks/<%= p.id %>" class="btn-primary" style="padding: 0.25rem 0.6rem; text-decoration: none; font-size: 0.85rem; font-weight: 600; white-space: nowrap; display: inline-flex; align-items: center; gap: 0.25rem;" title="Enter Marks">
                                        <i class="bi bi-pencil-square"></i> Marks
                                    </a>
                                    <% if (isAdmin) { %>
                                        <button type="button" class="btn-secondary" style="color: #ef4444; border-color: #fca5a5; background: #fff; padding: 0.25rem 0.45rem; font-size: 0.85rem;" onclick="openDeletePaperModal('<%= p.id %>', '<%= p.subject_name %>', '<%= p.class_name %>')" title="Delete Paper">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--muted);">
                            <i class="bi bi-inbox" style="font-size: 2rem; color: #cbd5e1; display: block; margin-bottom: 0.5rem;"></i>
                            No papers found matching the filter criteria.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<!-- Add Paper Modal -->
<div id="addPaperModal" class="modal-backdrop" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="card" style="width: 100%; max-width: 500px; padding: 1.5rem; position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <h3 style="margin: 0; font-size: 1.2rem; color: var(--primary-color);">
                <i class="bi bi-plus-circle"></i> Add Exam Paper
            </h3>
            <button type="button" onclick="closeAddPaperModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--muted);">&times;</button>
        </div>

        <form action="/exams/papers/add" method="POST">
            <input type="hidden" name="exam_id" value="<%= selectedExamId %>">

            <div class="form-group" style="margin-bottom: 1rem;">
                <label for="new_paper_class_id" style="font-weight: 600;">Class</label>
                <select name="class_id" id="new_paper_class_id" class="form-control" required onchange="filterSubjectsByClass(this.value)">
                    <option value="">-- Select Class --</option>
                    <% (typeof classes !== 'undefined' ? classes : []).forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label for="new_paper_subject_id" style="font-weight: 600;">Subject</label>
                <select name="subject_id" id="new_paper_subject_id" class="form-control" required>
                    <option value="">-- Select Subject --</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
                <label for="new_paper_teacher_id" style="font-weight: 600;">Assigned Teacher</label>
                <select name="teacher_id" id="new_paper_teacher_id" class="form-control" required>
                    <option value="">-- Select Teacher --</option>
                    <% (typeof teachers !== 'undefined' ? teachers : []).forEach(t => { %>
                        <option value="<%= t.id %>"><%= t.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label for="new_paper_total_marks" style="font-weight: 600;">Total Marks</label>
                <input type="number" name="total_marks" id="new_paper_total_marks" class="form-control" value="100" min="1" required>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn-secondary" onclick="closeAddPaperModal()">Cancel</button>
                <button type="submit" class="btn-primary">Add Paper</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deletePaperModal" class="modal-backdrop" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="card" style="width: 100%; max-width: 440px; padding: 1.5rem;">
        <h3 style="margin-top: 0; color: #dc2626; font-size: 1.2rem;">
            <i class="bi bi-exclamation-triangle-fill"></i> Delete Exam Paper
        </h3>
        <p style="color: var(--muted); font-size: 0.95rem; margin: 1rem 0;">
            Are you sure you want to delete the paper for <strong id="deletePaperSubject" style="color: var(--ink);"></strong> (<span id="deletePaperClass"></span>)?
            All associated questions and student marks for this paper will also be permanently deleted.
        </p>
        <form id="deletePaperForm" method="POST" action="">
            <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
            <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button type="button" class="btn-secondary" onclick="closeDeletePaperModal()">Cancel</button>
                <button type="submit" class="btn-danger" style="background-color: #dc2626; color: white; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600;">
                    Delete Paper
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const allSubjects = <%- JSON.stringify(typeof allSubjects !== 'undefined' ? allSubjects : []) %>;

    function filterSubjectsByClass(classId) {
        const subjectSelect = document.getElementById('new_paper_subject_id');
        subjectSelect.innerHTML = '<option value="">-- Select Subject --</option>';
        if (!classId) return;

        const filtered = allSubjects.filter(s => String(s.class_id) === String(classId));
        filtered.forEach(s => {
            const opt = document.createElement('option');
            opt.value = s.id;
            opt.textContent = s.name;
            subjectSelect.appendChild(opt);
        });
    }

    function openAddPaperModal() {
        document.getElementById('addPaperModal').style.display = 'flex';
    }

    function closeAddPaperModal() {
        document.getElementById('addPaperModal').style.display = 'none';
    }

    function openDeletePaperModal(paperId, subjectName, className) {
        document.getElementById('deletePaperSubject').textContent = subjectName;
        document.getElementById('deletePaperClass').textContent = className;
        document.getElementById('deletePaperForm').action = `/exams/papers/delete/${paperId}`;
        document.getElementById('deletePaperModal').style.display = 'flex';
    }

    function closeDeletePaperModal() {
        document.getElementById('deletePaperModal').style.display = 'none';
    }

    async function updatePaperDate(inputElem, paperId) {
        const newDate = inputElem.value;
        const icon = document.getElementById(`dateSavedIcon_${paperId}`);
        try {
            const resp = await fetch(`/exams/papers/${paperId}/quick-date`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paper_date: newDate })
            });
            const data = await resp.json();
            if (data.success && icon) {
                icon.style.display = 'inline';
                setTimeout(() => { icon.style.display = 'none'; }, 2000);
            }
        } catch (err) {
            console.error('Failed to update date:', err);
            alert('Failed to save paper date.');
        }
    }
</script>

<%- include('../partials/footer') %>
