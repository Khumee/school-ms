<%- include('../partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h1 class="section-title"><i class="bi bi-file-earmark-text"></i> Exam Papers</h1>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<div class="card" style="margin-bottom: 2rem;">
    <form action="/exams/papers" method="GET" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 1rem;">
            <label for="exam_id" style="font-weight: 600; margin: 0;">Select Exam Term:</label>
            <select name="exam_id" id="exam_id" class="form-control" style="width: auto; min-width: 250px;" onchange="this.form.submit()">
                <% exams.forEach(e => { %>
                    <option value="<%= e.id %>" <%= selectedExamId == e.id ? 'selected' : '' %>><%= e.name %></option>
                <% }) %>
            </select>
        </div>
        
        <% if (isAdmin && selectedExamId) { %>
            <form action="/exams/generate_papers" method="POST" style="margin: 0;" onsubmit="return confirm('This will auto-generate papers based on the current timetable. Continue?');">
                <input type="hidden" name="exam_id" value="<%= selectedExamId %>">
                <button type="submit" class="btn-secondary" style="color: #b45309; border-color: #fcd34d; background: #fffbeb;">
                    <i class="bi bi-magic"></i> Auto-Generate Papers
                </button>
            </form>
        <% } %>
    </form>
</div>

<% if (selectedExamId) { %>
<div class="card" style="padding: 0; overflow: hidden;">
    <h3 style="margin: 0; padding: 1rem 1.5rem; color: var(--primary-color); border-bottom: 1px solid var(--border); background: #f8fafc;">
        <i class="bi bi-journal-text"></i> Assigned Papers
    </h3>
    <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; margin: 0; border-collapse: collapse;">
            <thead style="background: #f1f5f9;">
                <tr>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Class</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Subject</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Assigned Teacher</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Total Marks</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 280px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (papers.length > 0) { %>
                    <% papers.forEach(p => { %>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.75rem;"><%= p.class_name %></td>
                            <td style="padding: 0.75rem; font-weight: 600; color: var(--ink);"><%= p.subject_name %></td>
                            <td style="padding: 0.75rem;"><%= p.teacher_name %></td>
                            <td style="padding: 0.75rem;">
                                <% if (p.total_marks) { %>
                                    <span style="font-weight: 600;"><%= p.total_marks %></span>
                                <% } else { %>
                                    <span style="font-size: 0.8rem; background: #e2e8f0; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px;">Not Set</span>
                                <% } %>
                            </td>
                            <td style="padding: 0.75rem;">
                                <div style="display: flex; gap: 0.5rem;">
                                    <a href="/exams/papers/<%= p.id %>/build" class="btn-secondary" style="color: #0284c7; border-color: #bae6fd; background: #f0f9ff; padding: 0.35rem 0.75rem; text-decoration: none;">
                                        <i class="bi bi-tools"></i> Build Paper
                                    </a>
                                    <a href="/exams/marks/<%= p.id %>" class="btn-primary" style="padding: 0.35rem 0.75rem; text-decoration: none;">
                                        <i class="bi bi-pencil-square"></i> Enter Marks
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="padding: 2rem; text-align: center; color: var(--muted);">No papers found for this exam.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>
