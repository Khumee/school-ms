<%- include('partials/header') %>

<style>
    .nav-tabs {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
        border-bottom: 2px solid #e2e8f0;
    }
    .nav-tabs .nav-item {
        margin-bottom: -2px;
    }
    .nav-tabs .nav-link {
        display: block;
        padding: 0.75rem 1.5rem;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #64748b;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.95rem;
    }
    .nav-tabs .nav-link:hover {
        color: #0f172a;
    }
    .nav-tabs .nav-link.active {
        color: #3b82f6;
        border-bottom: 2px solid #3b82f6;
    }
    .tab-content .tab-pane {
        display: none;
    }
    .tab-content .tab-pane.show.active {
        display: block;
    }
</style>

<style>
    .nav-tabs {
        display: flex;
        list-style: none !important;
        padding: 0;
        margin: 0;
        border-bottom: 2px solid #e2e8f0;
    }
    .nav-tabs .nav-item {
        margin-bottom: -2px;
        list-style: none !important;
    }
    .nav-tabs .nav-item::before {
        content: none !important;
        display: none !important;
    }
    .nav-tabs .nav-link {
        display: block;
        padding: 0.75rem 1.5rem;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #64748b;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.95rem;
    }
    .nav-tabs .nav-link:hover {
        color: #0f172a;
    }
    .nav-tabs .nav-link.active {
        color: #3b82f6;
        border-bottom: 2px solid #3b82f6;
    }
    .tab-content .tab-pane {
        display: none;
    }
    .tab-content .tab-pane.show.active {
        display: block;
    }
</style>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-calendar3"></i> Manage Holidays</h1>
</div>

<div class="card" style="padding: 1.5rem; margin-bottom: 2rem;">
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="holidayTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link <%= activeTab === 'school' ? 'active' : '' %>" id="school-tab" data-bs-toggle="tab" data-bs-target="#school" type="button" role="tab" aria-controls="school" aria-selected="<%= activeTab === 'school' %>">Normal School Holidays</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link <%= activeTab === 'hifz' ? 'active' : '' %>" id="hifz-tab" data-bs-toggle="tab" data-bs-target="#hifz" type="button" role="tab" aria-controls="hifz" aria-selected="<%= activeTab === 'hifz' %>">Hifz Holidays</button>
        </li>
    </ul>

    <div class="tab-content" id="holidayTabsContent" style="padding-top: 1.5rem;">
        
        <!-- School Holidays Tab -->
        <div class="tab-pane fade <%= activeTab === 'school' ? 'show active' : '' %>" id="school" role="tabpanel" aria-labelledby="school-tab">
            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
                <!-- Add Holiday Form -->
                <div style="height: fit-content; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem; background: #f8fafc;">
                    <h3 style="margin-top: 0; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;"><i class="bi bi-calendar-plus"></i> Add School Holiday</h3>
                    
                    <form action="/settings/holidays/school" method="POST">
                        <div class="form-group" style="margin-bottom: 1rem;">
                            <label style="font-weight: 600;">Holiday Type</label>
                            <div style="margin-top: 0.25rem; display: flex; gap: 1rem; align-items: center;">
                                <div class="form-check" style="margin-bottom: 0;">
                                    <input class="form-check-input" type="radio" name="holiday_type" id="type_single_school" value="single" checked onchange="toggleHolidayType('school')">
                                    <label class="form-check-label" for="type_single_school">Single Day</label>
                                </div>
                                <div class="form-check" style="margin-bottom: 0;">
                                    <input class="form-check-input" type="radio" name="holiday_type" id="type_range_school" value="range" onchange="toggleHolidayType('school')">
                                    <label class="form-check-label" for="type_range_school">Date Range</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" id="single_date_div_school" style="margin-bottom: 1rem;">
                            <label for="holiday_date" style="font-weight: 600;">Holiday Date</label>
                            <input type="date" name="holiday_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                        </div>

                        <div id="range_date_div_school" style="display: none; margin-bottom: 1rem;">
                            <div style="display: flex; gap: 1rem;">
                                <div style="flex: 1;">
                                    <label for="holiday_from" style="font-weight: 600;">From Date</label>
                                    <input type="date" name="holiday_from" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div style="flex: 1;">
                                    <label for="holiday_to" style="font-weight: 600;">To Date</label>
                                    <input type="date" name="holiday_to" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 1.5rem;">
                            <label for="description" style="font-weight: 600;">Description / Reason</label>
                            <input type="text" name="description" class="form-control" placeholder="e.g. Eid-ul-Adha, Winter Break, Sunday" required>
                        </div>

                        <button type="submit" class="btn-primary" style="width: 100%; height: 42px; font-weight: 600;"><i class="bi bi-plus-circle"></i> Add School Holiday</button>
                    </form>
                </div>

                <!-- Holidays List -->
                <div>
                    <h3 style="margin-top: 0; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;"><i class="bi bi-calendar3"></i> Scheduled School Holidays</h3>
                    
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Description</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (schoolHolidays.length > 0) { %>
                                    <% schoolHolidays.forEach(h => { %>
                                        <tr>
                                            <td style="font-weight: 600;"><%= new Date(h.date).toLocaleDateString() %></td>
                                            <td><%= new Date(h.date).toLocaleDateString(undefined, {weekday: 'long'}) %></td>
                                            <td><%= h.description || '-' %></td>
                                            <td>
                                                <form action="/settings/holidays/school/delete/<%= h.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this holiday?')">
                                                    <button type="submit" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; color: #dc2626; border-color: #fca5a5;">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align: center; color: #64748b; padding: 2rem;">No school holidays registered yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hifz Holidays Tab -->
        <div class="tab-pane fade <%= activeTab === 'hifz' ? 'show active' : '' %>" id="hifz" role="tabpanel" aria-labelledby="hifz-tab">
            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
                <!-- Add Holiday Form -->
                <div style="height: fit-content; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem; background: #f8fafc;">
                    <h3 style="margin-top: 0; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;"><i class="bi bi-calendar-plus"></i> Add Hifz Holiday</h3>
                    
                    <form action="/settings/holidays/hifz" method="POST">
                        <div class="form-group" style="margin-bottom: 1rem;">
                            <label style="font-weight: 600;">Holiday Type</label>
                            <div style="margin-top: 0.25rem; display: flex; gap: 1rem; align-items: center;">
                                <div class="form-check" style="margin-bottom: 0;">
                                    <input class="form-check-input" type="radio" name="holiday_type" id="type_single_hifz" value="single" checked onchange="toggleHolidayType('hifz')">
                                    <label class="form-check-label" for="type_single_hifz">Single Day</label>
                                </div>
                                <div class="form-check" style="margin-bottom: 0;">
                                    <input class="form-check-input" type="radio" name="holiday_type" id="type_range_hifz" value="range" onchange="toggleHolidayType('hifz')">
                                    <label class="form-check-label" for="type_range_hifz">Date Range</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-group" id="single_date_div_hifz" style="margin-bottom: 1rem;">
                            <label for="holiday_date" style="font-weight: 600;">Holiday Date</label>
                            <input type="date" name="holiday_date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                        </div>

                        <div id="range_date_div_hifz" style="display: none; margin-bottom: 1rem;">
                            <div style="display: flex; gap: 1rem;">
                                <div style="flex: 1;">
                                    <label for="holiday_from" style="font-weight: 600;">From Date</label>
                                    <input type="date" name="holiday_from" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div style="flex: 1;">
                                    <label for="holiday_to" style="font-weight: 600;">To Date</label>
                                    <input type="date" name="holiday_to" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group" style="margin-bottom: 1.5rem;">
                            <label for="description" style="font-weight: 600;">Description / Reason</label>
                            <input type="text" name="description" class="form-control" placeholder="e.g. Eid-ul-Adha, Winter Break, Sunday" required>
                        </div>

                        <button type="submit" class="btn-primary" style="width: 100%; height: 42px; font-weight: 600;"><i class="bi bi-plus-circle"></i> Add Hifz Holiday</button>
                    </form>
                </div>

                <!-- Holidays List -->
                <div>
                    <h3 style="margin-top: 0; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;"><i class="bi bi-calendar3"></i> Scheduled Hifz Holidays</h3>
                    
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Description</th>
                                    <th style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (hifzHolidays.length > 0) { %>
                                    <% hifzHolidays.forEach(h => { %>
                                        <tr>
                                            <td style="font-weight: 600;"><%= new Date(h.holiday_date).toLocaleDateString() %></td>
                                            <td><%= new Date(h.holiday_date).toLocaleDateString(undefined, {weekday: 'long'}) %></td>
                                            <td><%= h.description || '-' %></td>
                                            <td>
                                                <form action="/settings/holidays/hifz/delete/<%= h.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this holiday?')">
                                                    <button type="submit" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; color: #dc2626; border-color: #fca5a5;">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" style="text-align: center; color: #64748b; padding: 2rem;">No Hifz holidays registered yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>

<%- include('partials/footer') %>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const schoolTab = document.getElementById('school-tab');
        const hifzTab = document.getElementById('hifz-tab');
        const schoolPane = document.getElementById('school');
        const hifzPane = document.getElementById('hifz');

        function activateTab(tabId) {
            if (tabId === 'school') {
                schoolTab.classList.add('active');
                hifzTab.classList.remove('active');
                schoolPane.style.display = 'block';
                hifzPane.style.display = 'none';
                
                // Update URL parameter
                const url = new URL(window.location);
                url.searchParams.set('tab', 'school');
                window.history.pushState({}, '', url);
            } else {
                hifzTab.classList.add('active');
                schoolTab.classList.remove('active');
                hifzPane.style.display = 'block';
                schoolPane.style.display = 'none';
                
                // Update URL parameter
                const url = new URL(window.location);
                url.searchParams.set('tab', 'hifz');
                window.history.pushState({}, '', url);
            }
        }

        schoolTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab('school');
        });

        hifzTab.addEventListener('click', function(e) {
            e.preventDefault();
            activateTab('hifz');
        });

        // Initialize based on URL or default
        const urlParams = new URLSearchParams(window.location.search);
        const currentTab = urlParams.get('tab') || 'school';
        activateTab(currentTab);
    });

    function toggleHolidayType(tabPrefix) {
        const isSingle = document.getElementById('type_single_' + tabPrefix).checked;
        document.getElementById('single_date_div_' + tabPrefix).style.display = isSingle ? 'block' : 'none';
        document.getElementById('range_date_div_' + tabPrefix).style.display = isSingle ? 'none' : 'block';
    }
</script>
