<%- include('../partials/header') %>
    <style>
        .timetable-cell {
            min-height: 80px;
            border: 1px solid #dee2e6;
            padding: 10px;
            background: #fff;
        }
        .period-card {
            background: #f8f9fa;
            border-left: 3px solid var(--primary-color);
            padding: 8px;
            margin-bottom: 5px;
            font-size: 0.85rem;
            position: relative;
        }
        .period-card .delete-btn {
            position: absolute;
            top: 2px;
            right: 2px;
            color: #dc3545;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
        }
    </style>
<div class="container mt-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Manage Timetable</h1>
                </div>

                <% if (locals.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (locals.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <!-- Class Selector -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <form action="/timetable/manage" method="GET" class="d-flex align-items-center">
                            <label for="class_id" class="me-3 fw-bold">Select Class:</label>
                            <select name="class_id" id="class_id" class="form-select w-auto me-3" onchange="this.form.submit()">
                                <% classes.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= selectedClassId == c.id ? 'selected' : '' %>><%= c.name %></option>
                                <% }) %>
                            </select>
                        </form>
                    </div>
                </div>

                <% if (selectedClassId) { %>
                <div class="row">
                    <!-- Add Slot Form -->
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">Add Time Slot</h5>
                            </div>
                            <div class="card-body">
                                <form action="/timetable/add" method="POST">
                                    <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                    
                                    <div class="mb-3">
                                        <label for="day_of_week" class="form-label">Day</label>
                                        <select name="day_of_week" id="day_of_week" class="form-select" required>
                                            <option value="Monday">Monday</option>
                                            <option value="Tuesday">Tuesday</option>
                                            <option value="Wednesday">Wednesday</option>
                                            <option value="Thursday">Thursday</option>
                                            <option value="Friday">Friday</option>
                                            <option value="Saturday">Saturday</option>
                                            <option value="Sunday">Sunday</option>
                                        </select>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="start_time" class="form-label">Start Time</label>
                                            <input type="time" name="start_time" id="start_time" class="form-control" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label for="end_time" class="form-label">End Time</label>
                                            <input type="time" name="end_time" id="end_time" class="form-control" required>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="subject_id" class="form-label">Subject</label>
                                        <select name="subject_id" id="subject_id" class="form-select" required>
                                            <option value="">Select Subject</option>
                                            <% subjects.forEach(s => { %>
                                                <option value="<%= s.id %>"><%= s.name %></option>
                                            <% }) %>
                                        </select>
                                        <% if (subjects.length === 0) { %>
                                            <small class="text-danger">No subjects found for this class. Add subjects first.</small>
                                        <% } %>
                                    </div>

                                    <div class="mb-3">
                                        <label for="employee_id" class="form-label">Teacher</label>
                                        <select name="employee_id" id="employee_id" class="form-select" required>
                                            <option value="">Select Teacher</option>
                                            <% teachers.forEach(t => { %>
                                                <option value="<%= t.id %>"><%= t.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100" <%= subjects.length === 0 ? 'disabled' : '' %>>Add to Timetable</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Timetable View -->
                    <div class="col-md-8 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h5 class="mb-0">Class Timetable</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 14%;">Mon</th>
                                                <th style="width: 14%;">Tue</th>
                                                <th style="width: 14%;">Wed</th>
                                                <th style="width: 14%;">Thu</th>
                                                <th style="width: 14%;">Fri</th>
                                                <th style="width: 14%;">Sat</th>
                                                <th style="width: 14%;">Sun</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].forEach(day => { %>
                                                    <td class="timetable-cell">
                                                        <% const dayPeriods = periods.filter(p => p.day_of_week === day).sort((a,b) => (a.start_time || '').localeCompare(b.start_time || '')); %>
                                                        <% dayPeriods.forEach(p => { %>
                                                            <div class="period-card shadow-sm rounded">
                                                                <form action="/timetable/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this slot?');">
                                                                    <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                                                    <button type="submit" class="delete-btn" title="Delete"><i class="bi bi-x-circle-fill"></i></button>
                                                                </form>
                                                                <div class="fw-bold"><%= p.subject_name || p.subject || 'Unknown' %></div>
                                                                <div class="text-muted"><%= (p.start_time || '').substring(0,5) %> - <%= (p.end_time || '').substring(0,5) %></div>
                                                                <div class="mt-1" style="font-size: 0.75rem;"><i class="bi bi-person"></i> <%= p.teacher_name || 'Unassigned' %></div>
                                                            </div>

                                                        <% }) %>
                                                    </td>
                                                <% }) %>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
<%- include('../partials/footer') %>
