<%- include('../partials/header') %>
<style>
    .timetable-cell {
        min-height: 80px;
        border: 1px solid var(--border);
        padding: 10px;
        background: var(--surface);
    }
    .period-card {
        background: var(--bg);
        border-left: 3px solid var(--primary-color);
        padding: 8px;
        margin-bottom: 5px;
        font-size: 0.85rem;
        position: relative;
        border-radius: 4px;
        box-shadow: var(--shadow-sm);
    }
    .period-card .delete-btn {
        position: absolute;
        top: 2px;
        right: 4px;
        color: #ef4444;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        font-size: 1rem;
    }
    .period-card .delete-btn:hover {
        color: #b91c1c;
    }
</style>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h1 class="section-title"><i class="bi bi-calendar3-week"></i> Manage Timetable</h1>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<div class="card" style="margin-bottom: 1.5rem;">
    <form action="/timetable/manage" method="GET" style="display: flex; align-items: center; gap: 1rem;">
        <label for="class_id" style="font-weight: 600; margin: 0;">Select Class:</label>
        <select name="class_id" id="class_id" class="form-control" style="width: auto; min-width: 250px;" onchange="this.form.submit()">
            <% classes.forEach(c => { %>
                <option value="<%= c.id %>" <%= selectedClassId == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
        </select>
    </form>
</div>

<% if (selectedClassId) { %>
<div style="display: grid; grid-template-columns: 350px 1fr; gap: 1.5rem;">
    
    <!-- Add Slot Form -->
    <div class="card">
        <h3 style="margin-bottom: 1rem; color: var(--primary-color); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
            <i class="bi bi-plus-circle"></i> Add Time Slot
        </h3>
        
        <form action="/timetable/add" method="POST">
            <input type="hidden" name="class_id" value="<%= selectedClassId %>">
            
            <div class="form-group">
                <label for="day_of_week">Day</label>
                <select name="day_of_week" id="day_of_week" class="form-control" required>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                    <option value="Saturday">Saturday</option>
                    <option value="Sunday">Sunday</option>
                </select>
            </div>
            
            <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label for="start_time">Start Time</label>
                    <input type="time" name="start_time" id="start_time" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="end_time">End Time</label>
                    <input type="time" name="end_time" id="end_time" class="form-control" required>
                </div>
            </div>

            <div class="form-group">
                <label for="subject_id">Subject</label>
                <select name="subject_id" id="subject_id" class="form-control" required>
                    <option value="">-- Select Subject --</option>
                    <% subjects.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                    <% }) %>
                </select>
                <% if (subjects.length === 0) { %>
                    <small style="color: #dc3545; display: block; margin-top: 0.25rem;">No subjects found for this class. Add subjects first.</small>
                <% } %>
            </div>

            <div class="form-group">
                <label for="employee_id">Teacher</label>
                <select name="employee_id" id="employee_id" class="form-control" required>
                    <option value="">-- Select Teacher --</option>
                    <% teachers.forEach(t => { %>
                        <option value="<%= t.id %>"><%= t.name %></option>
                    <% }) %>
                </select>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;" <%= subjects.length === 0 ? 'disabled' : '' %>>
                Add to Timetable
            </button>
        </form>
    </div>

    <!-- Timetable View -->
    <div class="card" style="padding: 0; overflow: hidden;">
        <h3 style="margin: 0; padding: 1rem 1.5rem; color: var(--primary-color); border-bottom: 1px solid var(--border); background: #f8fafc;">
            <i class="bi bi-table"></i> Class Timetable
        </h3>
        
        <div style="overflow-x: auto;">
            <table class="table" style="width: 100%; margin: 0; border-collapse: collapse; min-width: 800px;">
                <thead style="background: #f1f5f9;">
                    <tr>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Mon</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Tue</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Wed</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Thu</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Fri</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Sat</th>
                        <th style="width: 14%; border: 1px solid var(--border); padding: 0.75rem; text-align: center; color: var(--muted); font-weight: 600;">Sun</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].forEach(day => { %>
                            <td class="timetable-cell" style="vertical-align: top;">
                                <% const dayPeriods = periods.filter(p => p.day_of_week === day).sort((a,b) => (a.start_time || '').localeCompare(b.start_time || '')); %>
                                <% dayPeriods.forEach(p => { %>
                                    <div class="period-card">
                                        <form action="/timetable/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete this slot?');">
                                            <input type="hidden" name="class_id" value="<%= selectedClassId %>">
                                            <button type="submit" class="delete-btn" title="Delete"><i class="bi bi-x-circle-fill"></i></button>
                                        </form>
                                        <div style="font-weight: 600; color: var(--ink); margin-bottom: 2px;"><%= p.subject_name || p.subject || 'Unknown' %></div>
                                        <div style="color: var(--muted); font-size: 0.75rem; margin-bottom: 4px;">
                                            <i class="bi bi-clock"></i> <%= (p.start_time || '').substring(0,5) %> - <%= (p.end_time || '').substring(0,5) %>
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--primary-color); font-weight: 500;">
                                            <i class="bi bi-person-badge"></i> <%= p.teacher_name || 'Unassigned' %>
                                        </div>
                                    </div>
                                <% }) %>
                            </td>
                        <% }) %>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<% } %>

<%- include('../partials/footer') %>
