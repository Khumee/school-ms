<%- include('partials/header') %>

<style>
    .urdu-text {
        font-family: 'Noto Nastaliq Urdu', 'Noto Serif', serif;
        direction: rtl;
    }
    .status-group {
        display: flex;
        gap: 0.25rem;
        background-color: #f1f5f9;
        padding: 0.2rem;
        border-radius: 8px;
        width: fit-content;
    }
    .btn-toggle-chip {
        border: none;
        background: none;
        padding: 0.35rem 0.65rem;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.15s ease;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }
    /* Vibrant toggle states */
    .btn-toggle-chip.active-recited {
        background-color: #10b981;
        color: #ffffff;
        box-shadow: 0 2px 4px rgba(16,185,129,0.3);
    }
    .btn-toggle-chip.active-nagha {
        background-color: #ef4444;
        color: #ffffff;
        box-shadow: 0 2px 4px rgba(239,68,68,0.3);
    }
    .btn-toggle-chip.active-absent {
        background-color: #f59e0b;
        color: #ffffff;
        box-shadow: 0 2px 4px rgba(245,158,11,0.3);
    }
    .btn-toggle-chip.active-leave {
        background-color: #3b82f6;
        color: #ffffff;
        box-shadow: 0 2px 4px rgba(59,130,246,0.3);
    }
    .grid-input-row {
        display: flex;
        gap: 0.35rem;
        align-items: center;
    }
    /* Greying states */
    .row-absent, .row-leave {
        background-color: #f1f5f9 !important;
        opacity: 0.55;
    }
    .row-absent input, .row-leave input,
    .row-absent button:not(.btn-toggle-chip), 
    .row-leave button:not(.btn-toggle-chip) {
        pointer-events: none;
        background-color: #cbd5e1 !important;
    }
    /* Column disabled states */
    .sabaq-disabled, .sabqi-disabled, .manzil-disabled {
        opacity: 0.4;
        pointer-events: none;
    }
    .sabaq-disabled input, .sabqi-disabled input, .manzil-disabled input {
        background-color: #e2e8f0 !important;
    }
</style>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-grid-3x3-gap-fill"></i> Quick Mark Hifz Matrix</h1>
    <a href="/hifz" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Roster</a>
</div>

<div class="card" style="margin-bottom: 1.5rem; padding: 1.25rem;">
    <form action="/hifz/mark-all" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <label for="date" style="font-weight: 600; color: #475569;"><i class="bi bi-calendar3"></i> Diary Date:</label>
        <input type="date" id="date" name="date" class="form-control" style="width: auto;" value="<%= today %>" onchange="this.form.submit()">
        <span style="color: #64748b; font-size: 0.9rem;">(Changing date will load entries for that day)</span>
        <div style="margin-left: auto; display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 0.35rem;" onclick="openDownloadModal()"><i class="bi bi-file-earmark-pdf"></i> Download Mark Diary (PDF)</button>
            <button type="button" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 0.35rem;" onclick="openScanModal()"><i class="bi bi-upc-scan"></i> Upload Scanned Sheet</button>
        </div>
    </form>
</div>

<!-- DOWNLOAD MARK DIARY MODAL -->
<div id="downloadModal" class="card" style="display: none; max-width: 420px; margin: 1rem auto; position: fixed; top: 15%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-top: 0;"><i class="bi bi-file-earmark-pdf"></i> Download Mark Diary (PDF)</h3>
    <p style="font-size: 0.85rem; color: #64748b;">Choose the date to print on the sheet. This is the date the entries will be filed under when you upload the filled sheet back, so make sure it's correct before printing.</p>
    <div class="form-group" style="margin-bottom: 1rem;">
        <label for="download_date" style="font-weight: 600;">Diary Date</label>
        <input type="date" id="download_date" class="form-control" value="<%= today %>">
    </div>
    <div class="form-group" style="margin-bottom: 1rem;">
        <label for="download_teacher" style="font-weight: 600;">Teacher Name (optional)</label>
        <select id="download_teacher" class="form-control">
            <option value="">Leave blank to write by hand on the printed sheet</option>
            <% qariTeachers.forEach(t => { %>
                <option value="<%= t.name %>"><%= t.name %></option>
            <% }) %>
        </select>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="btn-secondary" onclick="closeDownloadModal()">Cancel</button>
        <button type="button" class="btn-primary" onclick="submitDownload()"><i class="bi bi-download"></i> Download PDF</button>
    </div>
</div>
<div id="downloadModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeDownloadModal()"></div>

<!-- SCAN UPLOAD MODAL -->
<div id="scanModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 15%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-top: 0;"><i class="bi bi-upc-scan"></i> Upload Filled Mark Diary Sheet</h3>
    <p style="font-size: 0.85rem; color: #64748b;">Upload a clear photo of the hand-filled manual sheet. Extracted values will be filled into the matching student rows below for the diary date currently selected above (<strong><%= today %></strong>) — make sure that matches the date printed on the sheet before saving.</p>
    <div style="position: relative; border: 2px dashed #cbd5e1; border-radius: 8px; padding: 1.5rem; text-align: center; margin-bottom: 0.75rem;">
        <i class="bi bi-cloud-arrow-up" style="font-size: 1.75rem; color: #94a3b8;"></i>
        <div style="font-size: 0.85rem; color: #64748b;">Click to select or capture a photo</div>
        <input type="file" id="scan_image_input" accept="image/*" style="position:absolute; opacity:0; inset:0; width:100%; height:100%; cursor:pointer;" onchange="document.getElementById('scanSelectedText').innerText = this.files[0] ? this.files[0].name : 'No file selected'; if(this.files[0]) { scanMarkAllSheet(this); }">
    </div>
    <div id="scanSelectedText" style="font-size: 0.85rem; color: #64748b; text-align: center; margin-bottom: 1rem;">No file selected</div>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="btn-secondary" onclick="closeScanModal()">Cancel</button>
    </div>
    <div id="scan_status" style="font-size: 0.9rem; color: #64748b; display: none; text-align: center; margin-top: 1rem;"><i class="bi bi-hourglass-split"></i> Reading the sheet with AI... This may take a few seconds.</div>
</div>
<div id="scanModalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="closeScanModal()"></div>

<% if (typeof req !== 'undefined' && req.query.success) { %>
    <div class="alert" style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> Hifz diaries saved successfully!
    </div>
<% } %>

<% if (typeof isHoliday !== 'undefined' && isHoliday) { %>
    <div class="alert" style="background-color: #fef2f2; color: #991b1b; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #fecaca; text-align: center;">
        <i class="bi bi-calendar-x" style="font-size: 2rem; display: block; margin-bottom: 0.5rem;"></i>
        <h3 style="margin: 0 0 0.5rem 0;">Hifz Holiday</h3>
        <p style="margin: 0;">This date is marked as a holiday (<%= holidayDesc %>). No Hifz diaries can be recorded.</p>
    </div>
<% } else { %>
<form action="/hifz/mark-all" method="POST" onsubmit="return validateMarkAllForm()">
    <input type="hidden" name="date" value="<%= today %>">

    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <% if (students.length > 0) { %>
            <% students.forEach(s => { %>
                <% 
                    let rowClass = '';
                    let initialStatus = 'present';
                    if (s.is_absent) {
                        rowClass = 'row-absent';
                        initialStatus = 'absent';
                    } else if (s.sabaq_status === 'leave') {
                        rowClass = 'row-leave';
                        initialStatus = 'leave';
                    }

                    const sabaqStatus = s.sabaq_status || 'recited';
                    const sabqiStatus = s.sabqi_status || 'recited';
                    const manzilStatus = s.manzil_status || 'recited';
                    const isWaqafActive = s.is_in_waqaf > 0;
                %>
                <div id="row-<%= s.student_id %>" class="card student-diary-card <%= rowClass %>" style="padding: 1.25rem; border-left: 5px solid #3b82f6; transition: border-color 0.2s;">
                    <!-- Student Info & Attendance Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                        <div>
                            <strong style="color: #0f172a; font-size: 1.05rem;"><%= s.student_name %></strong>
                            <span style="font-size: 0.8rem; color: #64748b; margin-left: 0.5rem;"><%= s.reg_no %> | <%= s.phase.label %></span>
                            <% if (isWaqafActive) { %>
                                <span class="status-cell" style="background-color: #fef3c7; color: #d97706; font-size: 0.75rem; padding: 0.15rem 0.4rem; font-weight: 600; margin-left: 0.5rem;"><i class="bi bi-lock-fill"></i> WAQAF REVISION ACTIVE</span>
                            <% } %>
                        </div>
                        <div class="status-group">
                            <button type="button" class="btn-toggle-chip <%= initialStatus === 'present' ? 'active-recited' : '' %>" onclick="selectAttendance('<%= s.student_id %>', 'present', this)" title="Present"><i class="bi bi-check-lg"></i> Present</button>
                            <button type="button" class="btn-toggle-chip <%= initialStatus === 'absent' ? 'active-absent' : '' %>" onclick="selectAttendance('<%= s.student_id %>', 'absent', this)" title="Absent"><i class="bi bi-person-x"></i> Absent</button>
                            <button type="button" class="btn-toggle-chip <%= initialStatus === 'leave' ? 'active-leave' : '' %>" onclick="selectAttendance('<%= s.student_id %>', 'leave', this)" title="Leave">Leave</button>
                        </div>
                        <input type="hidden" id="status-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabaq_status]" value="<%= s.sabaq_status || 'recited' %>">
                        <input type="hidden" id="sabqi-status-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabqi_status]" value="<%= s.sabqi_status || 'recited' %>">
                        <input type="hidden" id="manzil-status-<%= s.student_id %>" name="entries[<%= s.student_id %>][manzil_status]" value="<%= s.manzil_status || 'recited' %>">
                        <input type="hidden" id="absent-<%= s.student_id %>" name="entries[<%= s.student_id %>][is_absent]" value="<%= s.is_absent ? 'on' : 'off' %>">
                    </div>

                    <!-- Recitation Components: Sabaq, Sabqi, Manzil -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; align-items: start;">
                        <!-- Sabaq Section -->
                        <div class="sabaq-section" style="background-color: #eff6ff; border: 1px solid #dbeafe; border-radius: 8px; padding: 0.75rem; <%= isWaqafActive ? 'opacity: 0.55; pointer-events: none;' : '' %>">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <span style="font-weight: 700; color: #1e3a8a; font-size: 0.85rem;"><i class="bi bi-book"></i> Sabaq (New Lesson)</span>
                                <% if (!isWaqafActive) { %>
                                    <div class="status-group" style="padding: 0.1rem;">
                                        <button type="button" class="btn-toggle-chip <%= sabaqStatus === 'recited' ? 'active-recited' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'sabaq', 'recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-check-lg"></i> Recited</button>
                                        <button type="button" class="btn-toggle-chip <%= sabaqStatus === 'not_recited' ? 'active-nagha' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'sabaq', 'not_recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-x-lg"></i> Nagha</button>
                                    </div>
                                <% } else { %>
                                    <span style="font-size: 0.75rem; font-weight: 600; color: #b45309;"><i class="bi bi-shield-fill-exclamation"></i> Revision Break</span>
                                <% } %>
                            </div>

                            <div class="sabaq-inputs <%= (sabaqStatus === 'not_recited' || isWaqafActive) ? 'sabaq-disabled' : '' %>" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span style="font-size: 0.8rem; font-weight: 600; color: #1e3a8a; background-color: #dbeafe; padding: 0.2rem 0.5rem; border-radius: 4px;">Para <%= s.current_para %></span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                    <span style="font-size: 0.8rem; font-weight: 600; width: 40px; color: #1e3a8a;">Start:</span>
                                    <span style="font-size: 0.8rem;">Page</span>
                                    <input type="number" id="from-page-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabaq_from_page]" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="<%= req.tenant.hifz_pages_per_para || 20 %>"
                                           value="<%= s.sabaq_from_page || (s.prefill ? s.prefill.sabaq_from_page : 1) %>" onchange="calcTotalLines('<%= s.student_id %>')">
                                    <span style="font-size: 0.8rem;">Line</span>
                                    <input type="number" id="from-line-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabaq_from_line]" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="<%= req.tenant.hifz_lines_per_page || 15 %>"
                                           value="<%= s.sabaq_from_line || (s.prefill ? s.prefill.sabaq_from_line : 1) %>" onchange="calcTotalLines('<%= s.student_id %>')">
                                </div>
                                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                    <span style="font-size: 0.8rem; font-weight: 600; width: 40px; color: #1e3a8a;">End:</span>
                                    <span style="font-size: 0.8rem;">Page</span>
                                    <input type="number" id="to-page-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabaq_to_page]" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="<%= req.tenant.hifz_pages_per_para || 20 %>"
                                           value="<%= s.sabaq_to_page || (s.prefill ? s.prefill.sabaq_to_page : 1) %>" onchange="calcTotalLines('<%= s.student_id %>')">
                                    <span style="font-size: 0.8rem;">Line</span>
                                    <input type="number" id="to-line-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabaq_to_line]" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="<%= req.tenant.hifz_lines_per_page || 15 %>"
                                           value="<%= s.sabaq_to_line || (s.prefill ? s.prefill.sabaq_to_line : (req.tenant.hifz_lines_per_page || 15)) %>" onchange="calcTotalLines('<%= s.student_id %>')">
                                </div>
                                <div style="font-size: 0.8rem; font-weight: 700; color: #0284c7; margin-top: 0.15rem;">
                                    Total lines: <span id="total-lines-<%= s.student_id %>">--</span>
                                </div>
                            </div>
                        </div>

                        <!-- Sabqi Section -->
                        <div class="sabqi-section" style="background-color: #f0fdf4; border: 1px solid #dcfce7; border-radius: 8px; padding: 0.75rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <span style="font-weight: 700; color: #166534; font-size: 0.85rem;"><i class="bi bi-journal-text"></i> Sabqi (Recent Para)</span>
                                <div class="status-group" style="padding: 0.1rem;">
                                    <button type="button" class="btn-toggle-chip <%= sabqiStatus === 'recited' ? 'active-recited' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'sabqi', 'recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-check-lg"></i> Recited</button>
                                    <button type="button" class="btn-toggle-chip <%= sabqiStatus === 'not_recited' ? 'active-nagha' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'sabqi', 'not_recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-x-lg"></i> Nagha</button>
                                </div>
                            </div>

                            <div class="sabqi-inputs <%= sabqiStatus === 'not_recited' ? 'sabqi-disabled' : '' %>" style="display: flex; gap: 0.4rem; padding-top: 0.5rem; flex-wrap: wrap; align-items: center;">
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <span style="font-size: 0.8rem; font-weight: 600;">Recent Paras:</span>
                                    <div class="status-group" style="padding: 0.05rem;">
                                        <button type="button" class="btn-toggle-chip" onclick="quickFillSabqi('<%= s.student_id %>', 1)" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">1 P</button>
                                        <button type="button" class="btn-toggle-chip" onclick="quickFillSabqi('<%= s.student_id %>', 2)" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">2 P</button>
                                    </div>
                                </div>
                                <input type="number" id="sabqi-p1-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabqi_para]" placeholder="Para 1" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 65px;" min="1" max="30"
                                       value="<%= s.sabqi_para || (s.prefill ? s.prefill.sabqi_para : '') %>">
                                <input type="number" id="sabqi-p2-<%= s.student_id %>" name="entries[<%= s.student_id %>][sabqi_para_2]" placeholder="Para 2" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 65px;" min="1" max="30"
                                       value="<%= s.sabqi_para_2 || (s.prefill ? s.prefill.sabqi_para_2 : '') %>">
                            </div>
                        </div>

                        <!-- Manzil Section -->
                        <div class="manzil-section" style="background-color: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; padding: 0.75rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <span style="font-weight: 700; color: #854d0e; font-size: 0.85rem;"><i class="bi bi-bookmark-star"></i> Manzil (Revision)</span>
                                <div class="status-group" style="padding: 0.1rem;">
                                    <button type="button" class="btn-toggle-chip <%= manzilStatus === 'recited' ? 'active-recited' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'manzil', 'recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-check-lg"></i> Recited</button>
                                    <button type="button" class="btn-toggle-chip <%= manzilStatus === 'not_recited' ? 'active-nagha' : '' %>" onclick="selectColStatus('<%= s.student_id %>', 'manzil', 'not_recited', this)" style="padding: 0.2rem 0.5rem; font-size: 0.7rem;"><i class="bi bi-x-lg"></i> Nagha</button>
                                </div>
                            </div>

                            <div class="manzil-inputs <%= manzilStatus === 'not_recited' ? 'manzil-disabled' : '' %>" style="display: flex; gap: 0.4rem; padding-top: 0.5rem; flex-wrap: wrap; align-items: center;">
                                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <span style="font-size: 0.8rem; font-weight: 600; color: #854d0e;">Revision Paras:</span>
                                    <div class="status-group" style="padding: 0.05rem;">
                                        <button type="button" class="btn-toggle-chip" onclick="quickFillManzil('<%= s.student_id %>', 1)" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">1 P</button>
                                        <button type="button" class="btn-toggle-chip" onclick="quickFillManzil('<%= s.student_id %>', 2)" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">2 P</button>
                                        <button type="button" class="btn-toggle-chip" onclick="quickFillManzil('<%= s.student_id %>', 3)" style="padding: 0.15rem 0.35rem; font-size: 0.65rem;">3 P</button>
                                    </div>
                                </div>
                                <input type="number" id="manzil-p1-<%= s.student_id %>" name="entries[<%= s.student_id %>][manzil_para_1]" placeholder="P1" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="30"
                                       value="<%= s.manzil_para_1 || (s.prefill ? s.prefill.manzil_para_1 : '') %>">
                                <input type="number" id="manzil-p2-<%= s.student_id %>" name="entries[<%= s.student_id %>][manzil_para_2]" placeholder="P2" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="30"
                                       value="<%= s.manzil_para_2 || (s.prefill ? s.prefill.manzil_para_2 : '') %>">
                                <input type="number" id="manzil-p3-<%= s.student_id %>" name="entries[<%= s.student_id %>][manzil_para_3]" placeholder="P3" class="form-control" style="padding: 0.2rem; font-size: 0.8rem; width: 55px;" min="1" max="30"
                                       value="<%= s.manzil_para_3 || (s.prefill ? s.prefill.manzil_para_3 : '') %>">
                            </div>
                        </div>
                    </div>

                    <!-- Remarks Line -->
                    <div style="margin-top: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-weight: 600; font-size: 0.8rem; color: #475569; width: 60px;">Remarks:</span>
                        <input type="text" id="remarks-<%= s.student_id %>" name="entries[<%= s.student_id %>][teacher_remarks]" class="form-control" style="padding: 0.3rem 0.5rem; font-size: 0.85rem; flex: 1;" placeholder="Enter assessment notes or corrections..." value="<%= s.teacher_remarks || '' %>">
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="card" style="text-align: center; color: #64748b; padding: 2rem;">
                No active Hifz students enrolled.
            </div>
        <% } %>
    </div>

    <% if (students.length > 0) { %>
        <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end; gap: 1rem;">
            <a href="/hifz" class="btn-secondary" style="height: 42px; display: inline-flex; align-items: center;">Cancel</a>
            <button type="submit" class="btn-primary" style="height: 42px; font-weight: 600; padding: 0 2rem;"><i class="bi bi-save"></i> Save All Entries</button>
        </div>
    <% } %>
</form>
<% } %>

<script>
    function calcTotalLines(studentId) {
        const fromPage = parseInt(document.getElementById('from-page-' + studentId).value) || 0;
        const toPage = parseInt(document.getElementById('to-page-' + studentId).value) || 0;
        const fromLine = parseInt(document.getElementById('from-line-' + studentId).value) || 0;
        const toLine = parseInt(document.getElementById('to-line-' + studentId).value) || 0;
        const display = document.getElementById('total-lines-' + studentId);

        if (fromPage > 0 && toPage >= fromPage) {
            const linesPerPage = parseInt("<%= req.tenant.hifz_lines_per_page || 15 %>", 10);
            let total = 0;
            if (toPage === fromPage) {
                total = Math.max(0, toLine - fromLine + 1);
            } else {
                total = Math.max(0, (linesPerPage - fromLine + 1) + (toPage - fromPage - 1) * linesPerPage + toLine);
            }
            display.textContent = total;
        } else {
            display.textContent = '--';
        }
    }

    function selectColStatus(studentId, colType, status, btn) {
        const row = document.getElementById('row-' + studentId);
        
        // Reset toggles in this group
        const group = btn.parentElement;
        group.querySelectorAll('.btn-toggle-chip').forEach(b => {
            b.className = 'btn-toggle-chip';
        });

        // Set status hidden input
        const statusInput = document.getElementById(colType + '-status-' + studentId) || document.getElementById('status-' + studentId);
        statusInput.value = status;

        const targetDiv = row.querySelector('.' + colType + '-inputs');

        if (status === 'recited') {
            btn.classList.add('active-recited');
            if (targetDiv) targetDiv.classList.remove(colType + '-disabled');
        } else {
            btn.classList.add('active-nagha');
            if (targetDiv) targetDiv.classList.add(colType + '-disabled');
        }
    }

    function selectAttendance(studentId, status, btn) {
        const row = document.getElementById('row-' + studentId);
        
        // Remove old row classes
        row.classList.remove('row-absent', 'row-leave');

        // Reset toggles in this group
        const group = btn.parentElement;
        group.querySelectorAll('.btn-toggle-chip').forEach(b => {
            b.className = 'btn-toggle-chip';
        });

        const absentInput = document.getElementById('absent-' + studentId);
        const sabaqStatusInput = document.getElementById('status-' + studentId);
        const sabqiStatusInput = document.getElementById('sabqi-status-' + studentId);
        const manzilStatusInput = document.getElementById('manzil-status-' + studentId);

        if (status === 'present') {
            btn.classList.add('active-recited');
            absentInput.value = 'off';
            
            // Restore hidden values to inputs
            sabaqStatusInput.value = sabaqStatusInput.getAttribute('data-prev') || 'recited';
            sabqiStatusInput.value = sabqiStatusInput.getAttribute('data-prev') || 'recited';
            manzilStatusInput.value = manzilStatusInput.getAttribute('data-prev') || 'recited';

            // Re-apply sub-column disabled states
            const sabaqDiv = row.querySelector('.sabaq-inputs');
            if (sabaqStatusInput.value === 'not_recited') {
                sabaqDiv.classList.add('sabaq-disabled');
            } else {
                sabaqDiv.classList.remove('sabaq-disabled');
            }

            const sabqiDiv = row.querySelector('.sabqi-inputs');
            if (sabqiStatusInput.value === 'not_recited') {
                sabqiDiv.classList.add('sabqi-disabled');
            } else {
                sabqiDiv.classList.remove('sabqi-disabled');
            }

            const manzilDiv = row.querySelector('.manzil-inputs');
            if (manzilStatusInput.value === 'not_recited') {
                manzilDiv.classList.add('manzil-disabled');
            } else {
                manzilDiv.classList.remove('manzil-disabled');
            }
        } else if (status === 'absent') {
            btn.classList.add('active-absent');
            row.classList.add('row-absent');
            absentInput.value = 'on';
        } else if (status === 'leave') {
            btn.classList.add('active-leave');
            row.classList.add('row-leave');
            absentInput.value = 'off';
            
            // Backup previous statuses before setting them to leave
            sabaqStatusInput.setAttribute('data-prev', sabaqStatusInput.value);
            sabqiStatusInput.setAttribute('data-prev', sabqiStatusInput.value);
            manzilStatusInput.setAttribute('data-prev', manzilStatusInput.value);

            sabaqStatusInput.value = 'leave';
            sabqiStatusInput.value = 'leave';
            manzilStatusInput.value = 'leave';
        }
    }

    function quickFillManzil(studentId, count) {
        const p1Input = document.getElementById(`manzil-p1-${studentId}`);
        const p2Input = document.getElementById(`manzil-p2-${studentId}`);
        const p3Input = document.getElementById(`manzil-p3-${studentId}`);

        let startP = parseInt(p1Input.value) || 1;
        p1Input.value = startP;
        p2Input.value = count >= 2 ? ((startP % 30) + 1) : '';
        p3Input.value = count >= 3 ? (((startP + 1) % 30) + 1) : '';
    }

    function quickFillSabqi(studentId, count) {
        const p1Input = document.getElementById(`sabqi-p1-${studentId}`);
        const p2Input = document.getElementById(`sabqi-p2-${studentId}`);

        let startP = parseInt(p1Input.value) || 1;
        p1Input.value = startP;
        p2Input.value = count >= 2 ? ((startP % 30) + 1) : '';
    }

    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('tr[id^="row-"]');
        rows.forEach(row => {
            const studentId = row.id.split('-')[1];
            calcTotalLines(studentId);
        });
    });

    function openDownloadModal() {
        document.getElementById('downloadModal').style.display = 'block';
        document.getElementById('downloadModalOverlay').style.display = 'block';
    }
    function closeDownloadModal() {
        document.getElementById('downloadModal').style.display = 'none';
        document.getElementById('downloadModalOverlay').style.display = 'none';
    }
    function submitDownload() {
        const d = document.getElementById('download_date').value;
        if (!d) { alert('Please choose a date.'); return; }
        const teacher = document.getElementById('download_teacher').value.trim();
        let url = '/hifz/mark-all/download?date=' + encodeURIComponent(d);
        if (teacher) url += '&teacher=' + encodeURIComponent(teacher);
        window.location.href = url;
        closeDownloadModal();
    }

    function openScanModal() {
        document.getElementById('scanModal').style.display = 'block';
        document.getElementById('scanModalOverlay').style.display = 'block';
    }
    function closeScanModal() {
        document.getElementById('scanModal').style.display = 'none';
        document.getElementById('scanModalOverlay').style.display = 'none';
        document.getElementById('scan_image_input').value = '';
        document.getElementById('scanSelectedText').innerText = 'No file selected';
    }

    function applyScannedRow(row) {
        const id = row.student_id;
        const rowEl = document.getElementById('row-' + id);
        if (!rowEl) return false;

        const setVal = (elemId, val) => {
            if (val === undefined || val === null || val === '') return;
            const el = document.getElementById(elemId);
            if (el) el.value = val;
        };
        const clickNagha = (sectionClass) => {
            const btn = rowEl.querySelector('.' + sectionClass + ' .status-group button[title="Nagha"]');
            if (btn) btn.click();
        };

        setVal('remarks-' + id, row.remarks);

        if (row.attendance === 'A') {
            const absentBtn = rowEl.querySelector('.status-group button[title="Absent"]');
            if (absentBtn) absentBtn.click();
            return true;
        }

        if (row.sabaq_nagha) {
            clickNagha('sabaq-section');
        } else {
            setVal('from-page-' + id, row.sabaq_from_page);
            setVal('from-line-' + id, row.sabaq_from_line);
            setVal('to-page-' + id, row.sabaq_to_page);
            setVal('to-line-' + id, row.sabaq_to_line);
            calcTotalLines(id);
        }

        if (row.sabqi_nagha) {
            clickNagha('sabqi-section');
        } else {
            setVal('sabqi-p1-' + id, row.sabqi_para);
            setVal('sabqi-p2-' + id, row.sabqi_para_2);
        }

        if (row.manzil_nagha) {
            clickNagha('manzil-section');
        } else {
            setVal('manzil-p1-' + id, row.manzil_para_1);
            setVal('manzil-p2-' + id, row.manzil_para_2);
            setVal('manzil-p3-' + id, row.manzil_para_3);
        }

        return true;
    }

    function scanMarkAllSheet(sourceInput) {
        let file = null;
        if (sourceInput && sourceInput.files && sourceInput.files[0]) {
            file = sourceInput.files[0];
        } else {
            const fileInput = document.getElementById('scan_image_input');
            file = fileInput && fileInput.files && fileInput.files[0];
        }
        if (!file) {
            alert('Please select or capture a photo first.');
            return;
        }

        const status = document.getElementById('scan_status');
        status.style.display = 'block';

        const reader = new FileReader();
        reader.onload = function(e) {
            const base64 = e.target.result.split(',')[1];
            fetch('/hifz/mark-all/scan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ image_b64: base64, mime_type: file.type })
            })
            .then(res => {
                const ct = res.headers.get('content-type') || '';
                if (!ct.includes('application/json')) {
                    throw new Error('Session expired or server error. Please log in again and retry.');
                }
                return res.json();
            })
            .then(data => {
                status.style.display = 'none';
                if (data.error) { alert('Error: ' + data.error); return; }

                const rows = data.data || [];
                let appliedCount = 0;
                rows.forEach(row => { if (applyScannedRow(row)) appliedCount++; });

                closeScanModal();

                const unmatchedCount = (data.unmatched || []).length;
                let msg = `Applied ${appliedCount} row(s) from the scanned sheet. Please review the values below before saving.`;
                if (unmatchedCount > 0) {
                    msg += `\n\n${unmatchedCount} row(s) could not be matched to a student (unclear or unrecognized Reg No) and were skipped.`;
                }
                alert(msg);
            })
            .catch(err => {
                status.style.display = 'none';
                alert('An error occurred during scanning: ' + err.message);
                console.error(err);
            });
        };
        reader.readAsDataURL(file);
    }
</script>

<%- include('partials/footer') %>
