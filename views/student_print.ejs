<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Admission Form - <%= student.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: <%= tenant.primary_color || '#1e3a8a' %>;
        }
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            color: #1e293b;
            background: #fff;
            font-size: 14px;
        }
        .page {
            width: 210mm;
            min-height: 297mm;
            padding: 20mm;
            margin: 0 auto;
            box-sizing: border-box;
            position: relative;
        }
        .header {
            display: flex;
            align-items: center;
            border-bottom: 3px solid var(--primary);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-right: 20px;
        }
        .school-info {
            flex: 1;
        }
        .school-info h1 {
            margin: 0;
            color: var(--primary);
            font-size: 24px;
            font-weight: 700;
        }
        .school-info p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 12px;
        }
        .title {
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 30px;
            color: #334155;
            background: #f1f5f9;
            padding: 10px;
            border-radius: 4px;
        }
        .photo-box {
            position: absolute;
            top: 20mm;
            right: 20mm;
            width: 35mm;
            height: 45mm;
            border: 2px dashed #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            font-size: 12px;
            text-align: center;
            border-radius: 4px;
        }
        .section {
            margin-bottom: 25px;
        }
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary);
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 5px;
            margin-bottom: 15px;
        }
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .field {
            margin-bottom: 5px;
        }
        .label {
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 2px;
        }
        .value {
            font-size: 14px;
            font-weight: 500;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
            min-height: 20px;
        }
        .full-width {
            grid-column: span 2;
        }
        .signatures {
            margin-top: 60px;
            display: flex;
            justify-content: space-between;
        }
        .sig-line {
            width: 200px;
            border-top: 1px solid #334155;
            text-align: center;
            padding-top: 5px;
            font-weight: 600;
            font-size: 12px;
        }
        @media print {
            body { background: none; }
            .page { padding: 0; box-shadow: none; margin: 0; }
            .title { background: #f1f5f9 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .photo-box { top: 0; right: 0; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="page">
        <!-- Photo Placeholder -->
        <div class="photo-box">
            Paste<br>Passport Size<br>Photograph Here
        </div>

        <!-- Header -->
        <div class="header">
            <% if (tenant.logo_url) { %>
                <img src="<%= tenant.logo_url %>" alt="Logo" class="logo">
            <% } %>
            <div class="school-info">
                <h1><%= tenant.name %></h1>
                <p>Admission & Student Profile Record</p>
            </div>
        </div>

        <div class="title">Student Admission Form</div>

        <!-- Section 1: Academic Details -->
        <div class="section">
            <div class="section-title">1. Academic & Enrollment Details</div>
            <div class="grid">
                <div class="field">
                    <div class="label">Registration / Roll No</div>
                    <div class="value"><%= student.reg_no %></div>
                </div>
                <div class="field">
                    <div class="label">Admission Date</div>
                    <div class="value"><%= student.date_of_admission ? new Date(student.date_of_admission).toLocaleDateString('en-GB') : '-' %></div>
                </div>
                <div class="field">
                    <div class="label">Admitted Class</div>
                    <div class="value"><%= student.class_name || 'Unassigned' %></div>
                </div>
                <div class="field">
                    <div class="label">Status</div>
                    <div class="value" style="text-transform: capitalize;"><%= student.status %></div>
                </div>
            </div>
        </div>

        <!-- Section 2: Personal Details -->
        <div class="section">
            <div class="section-title">2. Personal Information</div>
            <div class="grid">
                <div class="field">
                    <div class="label">Student Full Name</div>
                    <div class="value"><%= student.name %></div>
                </div>
                <div class="field">
                    <div class="label">Gender</div>
                    <div class="value" style="text-transform: capitalize;"><%= student.gender %></div>
                </div>
                <div class="field">
                    <div class="label">Date of Birth</div>
                    <div class="value"><%= student.date_of_birth ? new Date(student.date_of_birth).toLocaleDateString('en-GB') : '-' %></div>
                </div>
                <div class="field">
                    <div class="label">Blood Group</div>
                    <div class="value"><%= student.blood_group || '-' %></div>
                </div>
            </div>
        </div>

        <!-- Section 3: Family Details -->
        <div class="section">
            <div class="section-title">3. Family & Contact Information</div>
            <div class="grid">
                <div class="field">
                    <div class="label">Father / Guardian Name</div>
                    <div class="value"><%= student.father_name || '-' %></div>
                </div>
                <div class="field">
                    <div class="label">Father / Guardian Phone</div>
                    <div class="value"><%= student.father_phone || '-' %></div>
                </div>
                <div class="field">
                    <div class="label">Emergency Contact No</div>
                    <div class="value"><%= student.emergency_contact || '-' %></div>
                </div>
                <div class="field full-width">
                    <div class="label">Residential Address</div>
                    <div class="value"><%= student.address || '-' %></div>
                </div>
            </div>
        </div>

        <!-- Section 4: Previous School -->
        <div class="section">
            <div class="section-title">4. Previous Academic Background</div>
            <div class="field">
                <div class="label">Previous School Details (If any)</div>
                <div class="value"><%= student.previous_school_info || '-' %></div>
            </div>
        </div>

        <!-- Section 5: Financials -->
        <div class="section">
            <div class="section-title">5. Financial & Concession Details</div>
            <div class="grid">
                <div class="field">
                    <div class="label">Admission Fee Status</div>
                    <div class="value" style="text-transform: capitalize;">
                        <%= student.admission_fee_status %> - PKR <%= parseFloat(student.admission_fee || 0).toLocaleString() %>
                    </div>
                </div>
                <div class="field">
                    <div class="label">Monthly Tuition Fee Due</div>
                    <div class="value">
                        <% if (student.has_concession) { %>
                            PKR <%= (parseFloat(student.default_monthly_fee || 0) - parseFloat(student.custom_monthly_fee || 0)).toLocaleString() %>
                            (Discounted from PKR <%= parseFloat(student.default_monthly_fee || 0).toLocaleString() %>)
                        <% } else { %>
                            PKR <%= parseFloat(student.default_monthly_fee || 0).toLocaleString() %>
                        <% } %>
                    </div>
                </div>
                <% if (student.has_concession && student.concession_notes) { %>
                    <div class="field full-width">
                        <div class="label">Concession Notes</div>
                        <div class="value"><%= student.concession_notes %></div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Signatures -->
        <div class="signatures">
            <div class="sig-line">Parent / Guardian Signature</div>
            <div class="sig-line">Principal / Administrator</div>
        </div>
    </div>
</body>
</html>
