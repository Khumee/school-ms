<%- include('partials/header') %>
<div class='section-header'>
    <h1 class='section-title'><i class='bi bi-person-lines-fill'></i> Hifz Enrollment Management</h1>
</div>

<div class='form-grid' style='grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1rem;'>
    <!-- ENROLL SECTION -->
    <div class='card' style='padding: 1.5rem;'>
        <h3 style='margin-bottom: 1rem; color: #16a34a;'><i class='bi bi-person-plus-fill'></i> Enroll in Hifz</h3>
        <p style='color: var(--muted); margin-bottom: 1.5rem; font-size: 0.9rem;'>
            Move an existing school student into the Hifz program.
        </p>
        <form action="/hifz/enroll" method="POST">
            <div class="form-group">
                <label for="filter_class_id">Filter by Current Class</label>
                <select id="filter_class_id" class="form-control" onchange="filterStudents('enroll')">
                    <option value="">-- All Classes --</option>
                    <% regularClasses.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="student_id">Select Student</label>
                <select name="student_id" id="student_id" class="form-control enroll-student-dropdown" required>
                    <option value="">-- Select Student --</option>
                    <% unenrolled.forEach(s => { %>
                        <option value="<%= s.id %>" data-class-id="<%= s.class_id || '' %>"><%= s.name %> (Reg: <%= s.reg_no %>) - <%= s.class_name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class='form-group'>
                <label for='class_id'>Hifz Class</label>
                <select name='class_id' id='class_id' class='form-control' required>
                    <option value=''>-- Select Hifz Class --</option>
                    <% hifzClasses.forEach(c => { %>
                        <option value='<%= c.id %>'><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class='form-group'>
                    <label for='enrolled_date'>Enrollment Date</label>
                    <input type='date' id='enrolled_date' name='enrolled_date' class='form-control' required value='<%= new Date().toISOString().split("T")[0] %>'>
                </div>
                <div class='form-group'>
                    <label for='initial_avg_lines'>Prev. Average Lines/Day</label>
                    <input type='number' step='0.1' min='0' id='initial_avg_lines' name='initial_avg_lines' class='form-control' placeholder='e.g., 5.5' required>
                </div>
            </div>
            
            <div class="form-grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                <div class='form-group'>
                    <label for='start_para'>Starting Para</label>
                    <select id='start_para' name='start_para' class='form-control' required>
                        <% for(let p=1; p<=30; p++) { %>
                            <option value="<%= p %>">Para <%= p %></option>
                        <% } %>
                    </select>
                </div>
                <div class='form-group'>
                    <label for='start_page'>Starting Page</label>
                    <input type='number' min='1' id='start_page' name='start_page' class='form-control' value='1' required>
                </div>
                <div class='form-group'>
                    <label for='start_line'>Starting Line</label>
                    <input type='number' min='1' id='start_line' name='start_line' class='form-control' value='1' required>
                </div>
            </div>
            
            <div class='form-group'>
                <label for='notes'>Notes (Optional)</label>
                <textarea id='notes' name='notes' class='form-control' rows='2'></textarea>
            </div>
            
            <button type='submit' class='btn-primary' style='width: 100%; margin-top: 0.5rem;'><i class='bi bi-check-circle'></i> Enroll Student</button>
        </form>
    </div>

    <!-- DEROLL SECTION -->
    <div class='card' style='padding: 1.5rem; border-top: 4px solid #dc2626;'>
        <h3 style='margin-bottom: 1rem; color: #dc2626;'><i class='bi bi-person-dash-fill'></i> Deroll / Transfer to School</h3>
        <p style='color: var(--muted); margin-bottom: 1.5rem; font-size: 0.9rem;'>
            Remove a student from the Hifz program and move them back to a standard class.
        </p>
        <form action="/hifz/deroll" method="POST" onsubmit="return confirm('Are you sure you want to deroll this student from Hifz?');">
            <div class="form-group">
                <label for="deroll_filter_class_id">Filter by Current Hifz Class</label>
                <select id="deroll_filter_class_id" class="form-control" onchange="filterStudents('deroll')">
                    <option value="">-- All Hifz Classes --</option>
                    <% hifzClasses.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="deroll_student_id">Select Enrolled Student</label>
                <select name="student_id" id="deroll_student_id" class="form-control deroll-student-dropdown" required>
                    <option value="">-- Select Student --</option>
                    <% enrolledStudents.forEach(s => { %>
                        <option value="<%= s.id %>" data-class-id="<%= s.class_id || '' %>"><%= s.name %> (Reg: <%= s.reg_no %>) - <%= s.class_name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class='form-group'>
                <label for='regular_class_id'>New Regular Class</label>
                <select name='class_id' id='regular_class_id' class='form-control' required>
                    <option value=''>-- Select Regular Class --</option>
                    <% regularClasses.forEach(c => { %>
                        <option value='<%= c.id %>'><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class='form-group'>
                <label for='deroll_notes'>Reason / Notes</label>
                <textarea id='deroll_notes' name='notes' class='form-control' rows='2' placeholder='e.g., Completed Hifz, or transferring back to school'></textarea>
            </div>
            
            <button type="submit" class="btn-danger" style="width: 100%; margin-top: 0.5rem;"><i class="bi bi-arrow-left-circle"></i> Deroll Student</button>
        </form>
    </div>
</div>
<script>
function filterStudents(type) {
    const classId = type === 'enroll' ? document.getElementById('filter_class_id').value : document.getElementById('deroll_filter_class_id').value;
    const selectEl = type === 'enroll' ? document.getElementById('student_id') : document.getElementById('deroll_student_id');
    const options = selectEl.querySelectorAll('option');
    
    selectEl.value = ''; // Reset selection
    
    options.forEach(opt => {
        if (!opt.value) return; // Skip placeholder
        if (!classId || opt.getAttribute('data-class-id') === classId) {
            opt.style.display = '';
        } else {
            opt.style.display = 'none';
        }
    });
}
</script>
<%- include('partials/footer') %>