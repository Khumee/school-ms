<%- include('partials/header') %>

<%
    let totalCount = students.length;
    let concessionCount = students.filter(s => s.has_concession).length;
    let standardCount = students.filter(s => !s.has_concession && s.status === 'active').length;
    let fullWaiverCount = students.filter(s => {
        const concessionAmt = s.has_concession ? parseFloat(s.custom_monthly_fee || 0) : 0;
        const expectedFee = parseFloat(s.default_monthly_fee || 0) - concessionAmt;
        return expectedFee <= 0 && parseFloat(s.default_monthly_fee || 0) > 0 && s.status === 'active';
    }).length;
    let hifzCount = students.filter(s => s.is_hifz_class && s.status === 'active').length;
%>

<div class="section-header">
    <h1 class="section-title">
        <i class="bi bi-mortarboard-fill"></i> 
        <%= (typeof filter !== 'undefined' && filter === 'left') ? 'Historical Student Directory (Left)' : 'Student Directory' %>
    </h1>
    <div style="display: flex; gap: 0.75rem;">
        <% if (typeof filter !== 'undefined' && filter === 'left') { %>
            <a href="/students" class="btn-secondary"><i class="bi bi-arrow-left"></i> Back to Active Students</a>
        <% } else { %>
            <a href="/students?filter=left" class="btn-secondary"><i class="bi bi-clock-history"></i> Historical View (Left)</a>
        <% } %>
        <a href="/students/add" class="btn-primary"><i class="bi bi-person-plus-fill"></i> Add New Student</a>
    </div>
</div>

<!-- KPI Cards -->
<% if (typeof filter === 'undefined' || filter !== 'left') { %>
<div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 1.5rem;">
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="filterStudents('all')" id="kpi-all">
        <span class="kpi-icon blue"><i class="bi bi-people-fill"></i></span>
        <span class="kpi-label">Total Students</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= totalCount %></span>
        <span class="kpi-subtitle">Click to view all</span>
    </div>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="filterStudents('standard')" id="kpi-standard">
        <span class="kpi-icon green"><i class="bi bi-dash-circle"></i></span>
        <span class="kpi-label">Regular Fee</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= standardCount %></span>
        <span class="kpi-subtitle">Click to view regular fee only</span>
    </div>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="filterStudents('concession')" id="kpi-concession">
        <span class="kpi-icon red"><i class="bi bi-tags-fill"></i></span>
        <span class="kpi-label">Concessions</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= concessionCount %></span>
        <span class="kpi-subtitle">Click to view concessions only</span>
    </div>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="filterStudents('full_waiver')" id="kpi-waiver">
        <span class="kpi-icon orange" style="background-color: #fff7ed; color: #f97316;"><i class="bi bi-gift-fill"></i></span>
        <span class="kpi-label">Full Fee Waiver</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= fullWaiverCount %></span>
        <span class="kpi-subtitle">Click to view 100% concession only</span>
    </div>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="filterStudents('hifz')" id="kpi-hifz">
        <span class="kpi-icon pink"><i class="bi bi-book-fill"></i></span>
        <span class="kpi-label">Hifz Students</span>
        <span class="kpi-value" style="font-size: 1.4rem;"><%= hifzCount %></span>
        <span class="kpi-subtitle">Click to view Hifz only</span>
    </div>
</div>
<% } %>

<!-- Filters Collapsible Panel -->
<details class="filter-panel" <%= (classId || search) ? 'open' : '' %>>
    <summary>
        <span><i class="bi bi-funnel-fill"></i> Filter & Search Students <%= (classId || search) ? '(Active)' : '' %></span>
        <i class="bi bi-chevron-down toggle-icon"></i>
    </summary>
    <form action="/students" method="GET" class="filter-content">
        <div class="form-group">
            <label for="classId">Class</label>
            <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Classes --</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>" <%= classId == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="form-group">
            <label for="search">Search</label>
            <input type="text" name="search" id="search" class="form-control" value="<%= search || '' %>" placeholder="Search by name or Reg No...">
        </div>
        
        <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
            <button type="submit" class="btn-secondary" style="height: 38px;">Search</button>
            <a href="/students" class="btn-secondary" style="height: 38px; display: inline-flex; align-items: center;">Reset</a>
        </div>
    </form>
</details>

<!-- Table -->
<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Reg/Roll No</th>
                <th>Name</th>
                <th>Class</th>
                <th>Status</th>
                <th>Concession Amount</th>
                <th>Monthly Tuition Fee</th>
                <th>Admission Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (students.length > 0) { %>
                <% students.forEach(s => { %>
                    <tr class="student-row" data-has-concession="<%= s.has_concession ? 'true' : 'false' %>" data-is-hifz="<%= s.is_hifz_class ? 'true' : 'false' %>" data-status="<%= s.status %>" data-custom-fee="<%= s.custom_monthly_fee || 0 %>" data-default-fee="<%= s.default_monthly_fee || 0 %>">
                        <td style="font-weight: 600;"><%= s.reg_no %></td>
                        <td><a href="/students/view/<%= s.id %>" style="color: var(--primary-color); text-decoration: underline; font-weight: 600;"><%= s.name %></a></td>
                        <td><%= s.class_name || 'Unassigned' %></td>
                        <td>
                            <span class="status-cell <%= s.status === 'active' ? 'status-paid' : 'status-unpaid' %>">
                                <%= s.status.toUpperCase() %>
                            </span>
                        </td>
                        <td>
                            <% if (s.has_concession) { %>
                                <span style="color: #b91c1c; font-weight: 600;">PKR <%= parseFloat(s.custom_monthly_fee || 0).toLocaleString() %></span>
                            <% } else { %>
                                <span>-</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (s.has_concession) { %>
                                <span style="font-weight: 600;">
                                    PKR <%= (parseFloat(s.default_monthly_fee || 0) - parseFloat(s.custom_monthly_fee || 0)).toLocaleString() %>
                                </span>
                            <% } else { %>
                                <span>PKR <%= parseFloat(s.default_monthly_fee || 0).toLocaleString() %></span>
                            <% } %>
                        </td>
                        <td><%= s.date_of_admission ? new Date(s.date_of_admission).toLocaleDateString() : '-' %></td>
                        <td>
                            <div style="display: flex; gap: 0.5rem;">
                                <a href="/students/edit/<%= s.id %>" class="btn-secondary nav-btn"><i class="bi bi-pencil-square"></i> Edit</a>
                                <a href="/students/print/<%= s.id %>" target="_blank" class="btn-secondary nav-btn"><i class="bi bi-printer"></i> Print</a>
                                <form action="/students/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this student?')">
                                    <button type="submit" class="btn-danger nav-btn"><i class="bi bi-trash3-fill"></i> Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="8" style="text-align: center; color: #64748b;">No students found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    function filterStudents(type) {
        const rows = document.querySelectorAll('.student-row');
        rows.forEach(row => {
            const hasConcession = row.getAttribute('data-has-concession') === 'true';
            if (type === 'all') {
                row.style.display = '';
            } else if (type === 'standard') {
                const status = row.getAttribute('data-status');
                const isStandard = !hasConcession && status === 'active';
                row.style.display = isStandard ? '' : 'none';
            } else if (type === 'concession') {
                row.style.display = hasConcession ? '' : 'none';
            } else if (type === 'full_waiver') {
                const hasConcession = row.getAttribute('data-has-concession') === 'true';
                const customFee = hasConcession ? parseFloat(row.getAttribute('data-custom-fee') || 0) : 0;
                const defaultFee = parseFloat(row.getAttribute('data-default-fee') || 0);
                const status = row.getAttribute('data-status');
                const expectedFee = defaultFee - customFee;
                row.style.display = (expectedFee <= 0 && defaultFee > 0 && status === 'active') ? '' : 'none';
            } else if (type === 'hifz') {
                const isHifz = row.getAttribute('data-is-hifz') === 'true';
                const status = row.getAttribute('data-status');
                row.style.display = (isHifz && status === 'active') ? '' : 'none';
            }
        });
        
        // Add visual active state to cards
        document.getElementById('kpi-all').style.border = type === 'all' ? '2px solid var(--primary-color)' : '';
        document.getElementById('kpi-standard').style.border = type === 'standard' ? '2px solid var(--primary-color)' : '';
        document.getElementById('kpi-concession').style.border = type === 'concession' ? '2px solid var(--primary-color)' : '';
        document.getElementById('kpi-waiver').style.border = type === 'full_waiver' ? '2px solid var(--primary-color)' : '';
        document.getElementById('kpi-hifz').style.border = type === 'hifz' ? '2px solid var(--primary-color)' : '';
    }
</script>

<%- include('partials/footer') %>
