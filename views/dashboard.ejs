<%- include('partials/header') %>

<%
    // Resolve current month dynamically (Default to June/Month 6 as per local context)
    const currentMonthNum = typeof activeMonth !== 'undefined' ? activeMonth : (new Date().getMonth() + 1);
    const currentMonthData = monthsData[currentMonthNum - 1] || monthsData[5] || monthsData[0];
    const currentMonthName = currentMonthData ? currentMonthData.name : 'This Month';
    const hasPerm = (p) => session.roleName === 'Admin' || (session.permissions && session.permissions.includes(p));
%>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-grid-1x2-fill"></i> Dashboard</h1>
    <span style="font-size: 0.95rem; font-weight: 600; color: #64748b; display: inline-flex; align-items: center; gap: 0.4rem;"><i class="bi bi-calendar-event-fill"></i> Academic Year: 2026</span>
</div>

<!-- KPI Cards Grid -->
<div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
    <!-- Total Students -->
    <% if (hasPerm('Students')) { %>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/students'">
        <span class="kpi-icon blue"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Total Students</span>
        <span class="kpi-value"><%= total_students %></span>
        <span class="kpi-subtitle" style="min-height: 40px;"><%= paying_students %> Paying / <%= support_students %> Supported</span>
    </div>
    <% } %>

    <% if (hasPerm('Fees') || hasPerm('Ledgers')) { %>
    <!-- Regular Fee Students -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/students?filter=standard'">
        <span class="kpi-icon green"><i class="bi bi-cash-coin"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Regular Fee</span>
        <span class="kpi-value"><%= paying_students %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Students paying full fee</span>
    </div>

    <!-- Full Fee Waiver Students -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/students?filter=full_waiver'">
        <span class="kpi-icon red"><i class="bi bi-award-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Full Fee Waiver</span>
        <span class="kpi-value"><%= full_waiver_students %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Students with 100% concession</span>
    </div>

    <!-- Partial Concessions -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/students'">
        <span class="kpi-icon red"><i class="bi bi-tags-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Partial Concessions</span>
        <span class="kpi-value"><%= support_students %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Students with partial discount</span>
    </div>
    <% } %>

    <!-- Hifz Students -->
    <% if (req.tenant && req.tenant.enable_hifz_module && hasPerm('Hifz')) { %>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/hifz'">
        <span class="kpi-icon pink"><i class="bi bi-book-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Hifz Students</span>
        <span class="kpi-value"><%= hifz_students %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Enrolled in Hifz class</span>
    </div>
    <% } %>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin: 1.5rem 0 1rem 0; flex-wrap: wrap; gap: 1rem;">
    <h2 style="font-size: 1rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin: 0;">
        <i class="bi bi-bank2"></i> Monthly Financials
    </h2>
    <div style="display: flex; align-items: center; gap: 0.5rem;">
        <label for="monthSelector" style="font-size: 0.85rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Select Month:</label>
        <select id="monthSelector" class="form-control" style="width: auto; padding: 0.35rem 2rem 0.35rem 0.75rem; font-size: 0.9rem; font-weight: 600; color: #334155; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);" onchange="window.location.href='/?month=' + this.value">
            <% const mNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']; %>
            <% for(let i=1; i<=12; i++) { %>
                <option value="<%= i %>" <%= currentMonthNum === i ? 'selected' : '' %>><%= mNames[i-1] %></option>
            <% } %>
        </select>
    </div>
</div>

<div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
    <!-- Net Monthly Balance -->
    <% if (hasPerm('Ledgers') || hasPerm('Fees')) { %>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=net'">
        <span class="kpi-icon purple"><i class="bi bi-safe2-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Net Balance</span>
        <span class="kpi-value" style="color: <%= currentMonthData.balance >= 0 ? '#16a34a' : '#dc2626' %>;">
            <%= currentMonthData.balance >= 0 ? '+' : '' %>PKR <%= currentMonthData.balance.toLocaleString() %>
        </span>
        <span class="kpi-subtitle" style="min-height: 40px;">Income − Expense this month</span>
    </div>

    <!-- Monthly Income -->
    <% if (req.tenant && req.tenant.enable_donations_module) { %>
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=income'">
        <span class="kpi-icon green"><i class="bi bi-graph-up-arrow"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Total Income</span>
        <span class="kpi-value">PKR <%= currentMonthData.income.toLocaleString() %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Fees + Donations (Received)</span>
    </div>
    <% } %>

    <!-- Monthly Expense -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=expense'">
        <span class="kpi-icon red"><i class="bi bi-graph-down-arrow"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Total Expense</span>
        <span class="kpi-value">PKR <%= currentMonthData.expense.toLocaleString() %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Salaries, Rent & Bills</span>
    </div>
    <% } %>

    <% if (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) { %>
    <!-- Monthly Donations -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=donations'">
        <span class="kpi-icon indigo"><i class="bi bi-heart-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Donations</span>
        <span class="kpi-value">PKR <%= currentMonthData.donations.toLocaleString() %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">General & Trust funds</span>
    </div>
    <% } %>

    <% if (hasPerm('Fees') || hasPerm('Ledgers')) { %>
    <!-- Collection Progress for Current Month -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=accrual'">
        <span class="kpi-icon blue"><i class="bi bi-bar-chart-fill"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Collection Progress</span>
        <span class="kpi-value" style="font-size: 1.15rem;">PKR <%= currentMonthData.fees_accrual.toLocaleString() %> / <%= expected_fee_current_month.toLocaleString() %></span>
        <div style="min-height: 40px; display: flex; flex-direction: column; justify-content: center; gap: 4px; margin-top: 5px;">
            <% const progressPct = expected_fee_current_month > 0 ? Math.round((currentMonthData.fees_accrual / expected_fee_current_month) * 100) : 0; %>
            <div style="width: 100%; background-color: #e2e8f0; height: 6px; border-radius: 3px;">
                <div style="width: <%= Math.min(progressPct, 100) %>%; background-color: <%= progressPct >= 100 ? '#16a34a' : '#3b82f6' %>; height: 100%; border-radius: 3px;"></div>
            </div>
            <span class="kpi-subtitle" style="min-height: auto; margin-top: 0;"><%= progressPct %>% collected for <%= currentMonthName %></span>
        </div>
    </div>

    <!-- Monthly Fees Received (Cash Basis) -->
    <div class="card kpi-card" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='none';" onclick="window.location.href='/transactions?month=<%= currentMonthNum %>&kpi=cash_inflow'">
        <span class="kpi-icon amber"><i class="bi bi-cash-coin"></i></span>
        <span class="kpi-label" style="min-height: 40px; display: flex; align-items: flex-end;">Total Cash Inflow</span>
        <span class="kpi-value">PKR <%= currentMonthData.fees.toLocaleString() %></span>
        <span class="kpi-subtitle" style="min-height: 40px;">Cash collected this month (incl. arrears/advance)</span>
    </div>
    <% } %>
</div>

<!-- YTD Summary KPI Cards (MIS Tenant) -->
<% if (req.tenant && req.tenant.subdomain === 'mis' && (hasPerm('Ledgers') || hasPerm('Fees'))) { %>
<div style="margin-top: 1.5rem; margin-bottom: 0.5rem;">
    <h2 style="font-size: 1rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 1rem 0;">
        <i class="bi bi-bar-chart-steps"></i> Year-to-Date Summary (2026)
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">

        <!-- YTD Income -->
        <div class="card kpi-card" style="border-left: 4px solid #16a34a; cursor: default;">
            <span class="kpi-icon green"><i class="bi bi-arrow-down-circle-fill"></i></span>
            <span class="kpi-label">Total Income (YTD)</span>
            <span class="kpi-value" style="color: #16a34a;">PKR <%= totalIncomeAllTime.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
            <span class="kpi-subtitle">Fees + Donations (All Months)</span>
        </div>

        <!-- YTD Expense -->
        <div class="card kpi-card" style="border-left: 4px solid #dc2626; cursor: default;">
            <span class="kpi-icon red"><i class="bi bi-arrow-up-circle-fill"></i></span>
            <span class="kpi-label">Total Expense (YTD)</span>
            <span class="kpi-value" style="color: #dc2626;">PKR <%= totalExpenseAllTime.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
            <span class="kpi-subtitle">Salaries, Rent & Bills (All Months)</span>
        </div>

        <!-- Carry Forward -->
        <div class="card kpi-card" style="border-left: 4px solid #7c3aed; cursor: default;">
            <span class="kpi-icon purple"><i class="bi bi-clock-history"></i></span>
            <span class="kpi-label">Prev. Year Carry Forward</span>
            <span class="kpi-value" style="color: #7c3aed;">PKR <%= carryForward.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
            <span class="kpi-subtitle">Opening balance from 2025</span>
        </div>

        <!-- Closing Balance -->
        <div class="card kpi-card" style="border-left: 4px solid #b91c1c; cursor: default;">
            <span class="kpi-icon" style="background-color: #fee2e2; color: #b91c1c;"><i class="bi bi-safe2-fill"></i></span>
            <span class="kpi-label">Closing Balance (YTD)</span>
            <span class="kpi-value" style="color: #b91c1c; font-size: 1.4rem;">PKR <%= currentBalance.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></span>
            <span class="kpi-subtitle">Income + Carry Fwd − Expense</span>
        </div>

    </div>
</div>
<% } %>

<!-- Financial Graphs Grids -->
<% if (hasPerm('Ledgers') || hasPerm('Fees')) { %>
<div class="dashboard-grid" style="display: grid; grid-template-columns: <%= (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) ? '1fr 1fr' : '1fr' %>; gap: 1.5rem; margin-top: 2rem; margin-bottom: 1.5rem;">
    <!-- Chart 1: Financial Performance Trend -->
    <div class="card chart-card" style="margin-bottom: 0;">
        <h3 class="chart-title"><i class="bi bi-bar-chart-line-fill"></i> Financial Performance Trend (2026)</h3>
        <div class="chart-container" style="height: 300px; position: relative;">
            <canvas id="financialChart"></canvas>
        </div>
    </div>
    
    <% if (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) { %>
    <!-- Chart 2: Fee vs Donation Revenue Mix -->
    <div class="card chart-card" style="margin-bottom: 0;">
        <h3 class="chart-title"><i class="bi bi-graph-up"></i> Fees vs Donations Trend (2026)</h3>
        <div class="chart-container" style="height: 300px; position: relative;">
            <canvas id="feesDonationsChart"></canvas>
        </div>
    </div>
    <% } %>
</div>
<% } %>

<div class="dashboard-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
    <!-- Chart 3: YTD Expense Distribution -->
    <% if (hasPerm('Ledgers')) { %>
    <div class="card chart-card" style="margin-bottom: 0;">
        <h3 class="chart-title"><i class="bi bi-bar-chart-fill"></i> YTD Expense Breakdown</h3>
        <div class="chart-container" style="height: 300px; position: relative;">
            <canvas id="expenseBreakdownChart"></canvas>
        </div>
    </div>
    <% } %>
    
    <!-- Chart 4: Student Concession Mix -->
    <% if (hasPerm('Students') || hasPerm('Fees')) { %>
    <div class="card chart-card" style="margin-bottom: 0;">
        <h3 class="chart-title"><i class="bi bi-pie-chart"></i> Student Sponsorship Distribution</h3>
        <div class="chart-container" style="height: 300px; position: relative;">
            <canvas id="studentSponsorshipChart"></canvas>
        </div>
    </div>
    <% } %>
</div>

<!-- KPI Details Modal -->
<div id="kpiDetailModal" class="modal" style="display: none; position: fixed; z-index: 1001; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
    <div class="modal-content" style="background-color: #ffffff; margin: 12% auto; padding: 2rem; border-radius: 12px; width: 90%; max-width: 450px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); border: 1px solid #e2e8f0; position: relative; animation: slideIn 0.25s ease-out; box-sizing: border-box;">
        <span class="close-kpi-btn" onclick="closeKpiModal()" style="position: absolute; right: 1.5rem; top: 1.5rem; font-size: 1.5rem; font-weight: bold; color: #94a3b8; cursor: pointer; transition: color 0.2s;">&times;</span>
        <h2 id="kpiModalTitle" style="margin-top: 0; font-size: 1.3rem; color: #0f172a; margin-bottom: 1rem; font-weight: 700;">KPI Detail</h2>
        <div id="kpiModalBody" style="color: #334155; line-height: 1.5; font-size: 0.95rem;">
            <!-- Content will be injected here -->
        </div>
        <button onclick="closeKpiModal()" class="btn-primary" style="margin-top: 1.5rem; width: 100%;">Close Details</button>
    </div>
</div>

<style>
.close-kpi-btn:hover {
    color: #0f172a !important;
}
</style>

<!-- Collapsible Ledger Section -->
<% if (hasPerm('Ledgers') || hasPerm('Fees')) { %>
<details class="ledger-details">
    <summary class="ledger-summary">
        <span><i class="bi bi-table"></i> View 2026 Monthly Income & Expense Ledger Table</span>
        <i class="bi bi-chevron-down toggle-icon"></i>
    </summary>
    <div class="table-container" style="margin-top: 1rem;">


        <table>
            <thead>
                <tr>
                    <th>Month</th>
                    <th style="text-align: right;">Fees (PKR)</th>
                    <% if (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) { %>
                    <th style="text-align: right;">Donations (PKR)</th>
                    <% } %>
                    <th style="text-align: right; background-color: #f1f5f9; font-weight: 700;">Total Income</th>
                    <th style="text-align: right;">Rent</th>
                    <th style="text-align: right;">Salaries</th>
                    <th style="text-align: right;">Utilities</th>
                    <th style="text-align: right;">Office Exp</th>
                    <th style="text-align: right;">Other Exp</th>
                    <th style="text-align: right; background-color: #fef2f2; font-weight: 700;">Total Expense</th>
                    <th style="text-align: right; font-weight: 700;">Net Monthly</th>
                    <th style="text-align: right; background-color: #ecfdf5; font-weight: 700;">Closing Balance</th>
                </tr>
            </thead>
            <tbody>
                <% 
                    let cumulativeBalance = carryForward;
                    let sumFees = 0;
                    let sumDonations = 0;
                    let sumIncome = 0;
                    let sumRent = 0;
                    let sumSalaries = 0;
                    let sumUtilities = 0;
                    let sumOffice = 0;
                    let sumOther = 0;
                    let sumExpense = 0;
                %>
                <% monthsData.forEach(month => { %>
                    <% 
                        cumulativeBalance += month.balance;
                        sumFees += month.fees;
                        sumDonations += month.donations;
                        sumIncome += month.income;
                        sumRent += month.rent;
                        sumSalaries += month.salaries;
                        sumUtilities += month.utilities;
                        sumOffice += month.office;
                        sumOther += month.other;
                        sumExpense += month.expense;
                    %>
                    <tr>
                        <td style="font-weight: 600;"><%= month.name %></td>
                        <td style="text-align: right;"><%= month.fees > 0 ? month.fees.toLocaleString() : '-' %></td>
                        <% if (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) { %>
                        <td style="text-align: right;"><%= month.donations > 0 ? month.donations.toLocaleString() : '-' %></td>
                        <% } %>
                        <td style="text-align: right; background-color: #f8fafc; font-weight: 700;"><%= month.income > 0 ? month.income.toLocaleString() : '-' %></td>
                        <td style="text-align: right;"><%= month.rent > 0 ? month.rent.toLocaleString() : '-' %></td>
                        <td style="text-align: right;"><%= month.salaries > 0 ? month.salaries.toLocaleString() : '-' %></td>
                        <td style="text-align: right;"><%= month.utilities > 0 ? month.utilities.toLocaleString() : '-' %></td>
                        <td style="text-align: right;"><%= month.office > 0 ? month.office.toLocaleString() : '-' %></td>
                        <td style="text-align: right;"><%= month.other > 0 ? month.other.toLocaleString() : '-' %></td>
                        <td style="text-align: right; background-color: #fdf2f2; font-weight: 700;"><%= month.expense > 0 ? month.expense.toLocaleString() : '-' %></td>
                        <td style="text-align: right; font-weight: 700; color: <%= month.balance >= 0 ? '#16a34a' : '#dc2626' %>">
                            <%= month.balance !== 0 ? (month.balance > 0 ? '+' : '') + month.balance.toLocaleString() : '-' %>
                        </td>
                        <td style="text-align: right; background-color: #f0fdf4; font-weight: 700;"><%= cumulativeBalance.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></td>
                    </tr>
                <% }) %>
                
                <!-- Aggregated Totals Row -->
                <tr style="background-color: #f1f5f9; font-weight: 700; border-top: 2px solid #cbd5e1;">
                    <td>Total</td>
                    <td style="text-align: right;"><%= sumFees.toLocaleString() %></td>
                    <% if (req.tenant && req.tenant.enable_donations_module && hasPerm('Donations')) { %>
                    <td style="text-align: right;"><%= sumDonations.toLocaleString() %></td>
                    <% } %>
                    <td style="text-align: right;"><%= sumIncome.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumRent.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumSalaries.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumUtilities.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumOffice.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumOther.toLocaleString() %></td>
                    <td style="text-align: right;"><%= sumExpense.toLocaleString() %></td>
                    <td style="text-align: right; color: <%= (sumIncome - sumExpense) >= 0 ? '#16a34a' : '#dc2626' %>">
                        <%= (sumIncome - sumExpense).toLocaleString() %>
                    </td>
                    <td style="text-align: right; background-color: #dcfce7;"><%= currentBalance.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 0}) %></td>
                </tr>
            </tbody>
        </table>
    </div>
</details>
<% } %>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script>
    function openKpiModal(title, content) {
        document.getElementById('kpiModalTitle').innerText = title;
        document.getElementById('kpiModalBody').innerHTML = content;
        document.getElementById('kpiDetailModal').style.display = 'block';
    }

    function closeKpiModal() {
        document.getElementById('kpiDetailModal').style.display = 'none';
    }

    // Close modal if clicked outside
    window.addEventListener('click', function(event) {
        const modal = document.getElementById('kpiDetailModal');
        if (event.target == modal) {
            closeKpiModal();
        }
    });

    document.addEventListener("DOMContentLoaded", function() {
        const monthsData = <%- JSON.stringify(monthsData) %>;
        
        const labels = monthsData.map(m => m.name);
        const incomeData = monthsData.map(m => m.income);
        const expenseData = monthsData.map(m => m.expense);
        const feesData = monthsData.map(m => m.fees);
        const donationsData = monthsData.map(m => m.donations);
        
        // Calculate YTD expenses breakdown
        let totalRent = 0;
        let totalSalaries = 0;
        let totalUtilities = 0;
        let totalOffice = 0;
        let totalOther = 0;
        
        monthsData.forEach(m => {
            totalRent += m.rent;
            totalSalaries += m.salaries;
            totalUtilities += m.utilities;
            totalOffice += m.office;
            totalOther += m.other;
        });

        // CSS variable primary color lookup or fallback
        const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--primary-color').trim() || '#3b82f6';
        
        // Chart 1: Financial Performance Trend
        const ctx1 = document.getElementById('financialChart').getContext('2d');
        new Chart(ctx1, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Total Income (PKR)',
                        data: incomeData,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 3,
                        pointRadius: 4
                    },
                    {
                        label: 'Total Expense (PKR)',
                        data: expenseData,
                        borderColor: '#ef4444',
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 3,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { font: { family: "'Inter', sans-serif", weight: '600' }, color: '#475569' } },
                    datalabels: { display: false },
                    tooltip: {
                        padding: 12,
                        backgroundColor: '#0f172a',
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': PKR ' + context.parsed.y.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748b' } },
                    y: { border: { dash: [4, 4] }, grid: { color: '#e2e8f0' }, ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748b', callback: v => v >= 1000 ? (v / 1000) + 'k' : v } }
                }
            }
        });

        // Chart 2: Fees vs Donations Trend
        <% if (req.tenant && req.tenant.enable_donations_module) { %>
        const ctx2 = document.getElementById('feesDonationsChart').getContext('2d');
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Fees Collected (PKR)',
                        data: feesData,
                        backgroundColor: 'rgba(245, 158, 11, 0.85)',
                        borderColor: '#f59e0b',
                        borderWidth: 1.5,
                        borderRadius: 6
                    },
                    {
                        label: 'Donations Received (PKR)',
                        data: donationsData,
                        backgroundColor: 'rgba(99, 102, 241, 0.85)',
                        borderColor: '#6366f1',
                        borderWidth: 1.5,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { font: { family: "'Inter', sans-serif", weight: '600' }, color: '#475569' } },
                    datalabels: { display: false },
                    tooltip: {
                        padding: 12,
                        backgroundColor: '#0f172a',
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': PKR ' + context.parsed.y.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748b' } },
                    y: { border: { dash: [4, 4] }, grid: { color: '#e2e8f0' }, ticks: { font: { family: "'Inter', sans-serif" }, color: '#64748b', callback: v => v >= 1000 ? (v / 1000) + 'k' : v } }
                }
            }
        });
        <% } %>

        // Chart 3: YTD Expense Breakdown
        const ctx3 = document.getElementById('expenseBreakdownChart').getContext('2d');
        new Chart(ctx3, {
            type: 'doughnut',
            plugins: [ChartDataLabels],
            data: {
                labels: ['Salaries', 'Rent', 'Utilities', 'Office', 'Other'],
                datasets: [{
                    data: [totalSalaries, totalRent, totalUtilities, totalOffice, totalOther],
                    backgroundColor: [
                        '#3b82f6', // blue
                        '#ef4444', // red
                        '#f59e0b', // amber
                        '#10b981', // green
                        '#6366f1'  // indigo
                    ],
                    borderWidth: 2,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: "'Inter', sans-serif", weight: '600' }, color: '#475569' } },
                    datalabels: {
                        color: '#ffffff',
                        font: { family: "'Inter', sans-serif", weight: 'bold', size: 11 },
                        formatter: (value, ctx) => {
                            let sum = ctx.dataset.data.reduce((a, b) => a + b, 0);
                            if (sum === 0 || value === 0) return '';
                            let percentage = ((value / sum) * 100).toFixed(0);
                            return percentage > 4 ? percentage + '%' : '';
                        }
                    },
                    tooltip: {
                        padding: 12,
                        backgroundColor: '#0f172a',
                        callbacks: {
                            label: function(context) {
                                let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                let value = context.parsed;
                                let percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': PKR ' + value.toLocaleString() + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });

        // Chart 4: Student Concession Distribution
        const ctx4 = document.getElementById('studentSponsorshipChart').getContext('2d');
        new Chart(ctx4, {
            type: 'pie',
            plugins: [ChartDataLabels],
            data: {
                labels: ['Paying Students', 'Supported (Concession)'],
                datasets: [{
                    data: [<%= paying_students %>, <%= support_students %>],
                    backgroundColor: ['#3b82f6', '#ec4899'],
                    borderWidth: 2,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: "'Inter', sans-serif", weight: '600' }, color: '#475569' } },
                    datalabels: {
                        color: '#ffffff',
                        font: { family: "'Inter', sans-serif", weight: 'bold', size: 12 },
                        formatter: (value, ctx) => {
                            let sum = ctx.dataset.data.reduce((a, b) => a + b, 0);
                            if (sum === 0 || value === 0) return '';
                            let percentage = ((value / sum) * 100).toFixed(0);
                            return percentage > 4 ? percentage + '%' : '';
                        }
                    },
                    tooltip: {
                        padding: 12,
                        backgroundColor: '#0f172a',
                        callbacks: {
                            label: function(context) {
                                let total = context.dataset.data.reduce((a, b) => a + b, 0);
                                let value = context.parsed;
                                let percentage = ((value / total) * 100).toFixed(1);
                                return context.label + ': ' + value + ' students (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
</script>

<%- include('partials/footer') %>
