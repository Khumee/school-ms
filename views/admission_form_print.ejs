<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admission Form - <%= tenant.school_name %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
        }
        .header img {
            max-height: 80px;
        }
        .header h1 {
            margin: 10px 0 5px 0;
            font-size: 24px;
            text-transform: uppercase;
        }
        .header h2 {
            margin: 0;
            font-size: 18px;
            color: #555;
        }
        .section-title {
            background-color: #f0f0f0;
            padding: 8px 12px;
            font-size: 16px;
            font-weight: bold;
            margin: 25px 0 15px 0;
            border-left: 4px solid #333;
        }
        .form-row {
            display: flex;
            margin-bottom: 15px;
            align-items: flex-end;
        }
        .field {
            flex: 1;
            margin-right: 20px;
        }
        .field:last-child {
            margin-right: 0;
        }
        .field label {
            display: block;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .field .line {
            border-bottom: 1px solid #999;
            height: 25px;
            width: 100%;
        }
        .photo-box {
            width: 120px;
            height: 150px;
            border: 2px dashed #999;
            float: right;
            margin-top: -120px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
        }
        .footer {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }
        .signature-box {
            width: 250px;
            text-align: center;
        }
        .signature-box .line {
            border-bottom: 1px solid #333;
            height: 40px;
            margin-bottom: 5px;
        }
        @media print {
            @page {
                margin: 0; /* Hides default browser header and footer */
            }
            body {
                padding: 20px; /* Restores padding inside the printable area */
            }
        }
    </style>
</head>
<body onload="window.print()">

    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; border-bottom: 2px solid #333; padding-bottom: 15px;">
        <div class="header" style="text-align: left; margin: 0; padding: 0; border: none;">
            <% if (tenant.logo_url) { %>
                <img src="<%= tenant.logo_url %>" alt="School Logo" style="max-height: 80px;">
            <% } else { %>
                <svg width="80" height="80" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="max-height: 80px;">
                    <path d="M50 5 L10 20 V45 C10 75 35 90 50 95 C65 90 90 75 90 45 V20 L50 5 Z" fill="#f8fafc" stroke="#1e293b" stroke-width="4" stroke-linejoin="round"/>
                    <path d="M50 70 V45" stroke="#1e293b" stroke-width="4" stroke-linecap="round"/>
                    <path d="M50 45 C45 40 30 40 25 45 V70 C30 65 45 65 50 70 Z" fill="#e2e8f0" stroke="#1e293b" stroke-width="3" stroke-linejoin="round"/>
                    <path d="M50 45 C55 40 70 40 75 45 V70 C70 65 55 65 50 70 Z" fill="#e2e8f0" stroke="#1e293b" stroke-width="3" stroke-linejoin="round"/>
                    <path d="M50 15 L20 28 L50 41 L80 28 Z" fill="#1e293b"/>
                    <path d="M30 32 V45 C30 50 50 55 50 55 C50 55 70 50 70 45 V32" stroke="#1e293b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M80 28 V45" stroke="#1e293b" stroke-width="3" stroke-linecap="round"/>
                </svg>
            <% } %>
            <h1 style="margin: 10px 0 5px 0; font-size: 24px; text-transform: uppercase;"><%= tenant.school_name %></h1>
            <h2 style="margin: 0; font-size: 18px; color: #555;">Admission Application Form</h2>
        </div>
        <div class="photo-box" style="float: none; margin-top: 0;">
            Attach<br>Recent Photo<br>(Passport Size)
        </div>
    </div>

    <div class="section-title">Student Details</div>
    
    <div class="form-row">
        <div class="field" style="flex: 2;">
            <label>Full Name</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Gender (Male / Female / Other)</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Date of Birth (DD-MM-YYYY)</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Blood Group</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Previous School Information (if any)</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="section-title">Parent / Guardian Details</div>
    
    <div class="form-row">
        <div class="field">
            <label>Father's Name</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Father's Phone Number</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="form-row">
        <div class="field">
            <label>Emergency Contact Person & Number</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Residential Address</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="section-title">For Office Use Only</div>
    
    <div class="form-row">
        <div class="field">
            <label>Registration Number</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Class Admitted To</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Date of Admission</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="footer">
        <div class="signature-box">
            <div class="line"></div>
            Parent/Guardian Signature
        </div>
        <div class="signature-box">
            <div class="line"></div>
            Principal / Authorized Signature
        </div>
    </div>

</body>
</html>
