<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admission Form - <%= tenant.school_name %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
        }
        .header img {
            max-height: 80px;
        }
        .header h1 {
            margin: 10px 0 5px 0;
            font-size: 24px;
            text-transform: uppercase;
        }
        .header h2 {
            margin: 0;
            font-size: 18px;
            color: #555;
        }
        .section-title {
            background-color: #f0f0f0;
            padding: 8px 12px;
            font-size: 16px;
            font-weight: bold;
            margin: 25px 0 15px 0;
            border-left: 4px solid #333;
        }
        .form-row {
            display: flex;
            margin-bottom: 15px;
            align-items: flex-end;
        }
        .field {
            flex: 1;
            margin-right: 20px;
        }
        .field:last-child {
            margin-right: 0;
        }
        .field label {
            display: block;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .field .line {
            border-bottom: 1px solid #999;
            height: 25px;
            width: 100%;
        }
        .photo-box {
            width: 120px;
            height: 150px;
            border: 2px dashed #999;
            float: right;
            margin-top: -120px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #999;
        }
        .footer {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }
        .signature-box {
            width: 250px;
            text-align: center;
        }
        .signature-box .line {
            border-bottom: 1px solid #333;
            height: 40px;
            margin-bottom: 5px;
        }
        @media print {
            body {
                padding: 0;
            }
            .print-btn {
                display: none;
            }
        }
        .print-btn {
            background: #3b82f6;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 4px;
            display: block;
            margin: 0 auto 30px auto;
        }
    </style>
</head>
<body>

    <button class="print-btn" onclick="window.print()">🖨️ Print Admission Form</button>

    <div class="header">
        <% if (tenant.logo_url) { %>
            <img src="<%= tenant.logo_url %>" alt="School Logo">
        <% } %>
        <h1><%= tenant.school_name %></h1>
        <h2>Admission Application Form</h2>
    </div>

    <div class="photo-box">
        Attach<br>Recent Photo<br>(Passport Size)
    </div>

    <div class="section-title">Student Details</div>
    
    <div class="form-row">
        <div class="field" style="flex: 2;">
            <label>Full Name</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Gender (Male / Female / Other)</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Date of Birth (DD-MM-YYYY)</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Blood Group</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Previous School Information (if any)</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="section-title">Parent / Guardian Details</div>
    
    <div class="form-row">
        <div class="field">
            <label>Father's Name</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Father's Phone Number</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="form-row">
        <div class="field">
            <label>Emergency Contact Person & Number</label>
            <div class="line"></div>
        </div>
    </div>
    
    <div class="form-row">
        <div class="field">
            <label>Residential Address</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="section-title">For Office Use Only</div>
    
    <div class="form-row">
        <div class="field">
            <label>Registration Number</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Class Admitted To</label>
            <div class="line"></div>
        </div>
        <div class="field">
            <label>Date of Admission</label>
            <div class="line"></div>
        </div>
    </div>

    <div class="footer">
        <div class="signature-box">
            <div class="line"></div>
            Parent/Guardian Signature
        </div>
        <div class="signature-box">
            <div class="line"></div>
            Principal / Authorized Signature
        </div>
    </div>

</body>
</html>
