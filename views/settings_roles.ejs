<%- include('partials/header') %>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-shield-lock-fill"></i> Roles & Permissions</h1>
    <button class="btn-primary" onclick="document.getElementById('addRoleModal').style.display='block'; document.getElementById('modalOverlay').style.display='block';"><i class="bi bi-plus-lg"></i> Add Role</button>
</div>

<% if (error) { %>
    <div style="background-color: #fee2e2; color: #b91c1c; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
<% } %>
<% if (success) { %>
    <div style="background-color: #dcfce7; color: #15803d; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
<% } %>

<div class="card">
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Role Name</th>
                    <th>Permissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (roles && roles.length > 0) { %>
                    <% roles.forEach(role => { %>
                        <tr>
                            <td style="font-weight: 600;"><%= role.name %></td>
                            <td>
                                <!-- Will be loaded on edit for brevity, or we can fetch them per role in route. Since they are fetched dynamically, let's just show an Edit button for now -->
                                <span style="color: #64748b; font-size: 0.9rem;">(Click Edit to view)</span>
                            </td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button class="btn-secondary nav-btn" onclick="openEditModal(<%= role.id %>, '<%= role.name %>')"><i class="bi bi-pencil"></i> Edit</button>
                                    <% if (role.name !== 'Admin') { %>
                                        <form action="/settings/roles/delete/<%= role.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this role? Users assigned to this role will lose all access.');">
                                            <button type="submit" class="btn-secondary nav-btn" style="color: #dc2626; border-color: #fca5a5;"><i class="bi bi-trash"></i> Delete</button>
                                        </form>
                                    <% } else { %>
                                        <span style="font-size: 0.8rem; color: #94a3b8; font-style: italic;">Protected</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="text-align: center; color: #64748b;">No roles found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add Role Modal -->
<div id="addRoleModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 10%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 80vh; overflow-y: auto;">
    <h3 style="margin-bottom: 1rem;">Add New Role</h3>
    <form action="/settings/roles/add" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="roleName">Role Name</label>
            <input type="text" name="name" id="roleName" class="form-control" required placeholder="e.g. Teacher, Accountant">
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Permissions</label>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                <% const availablePerms = ['Dashboard', 'Students', 'Employees', 'Fees', 'Donations', 'Attendance', 'Ledgers', 'Hifz', 'Settings']; %>
                <% availablePerms.forEach(p => { %>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 500;">
                        <input type="checkbox" name="permissions[]" value="<%= p %>"> <%= p %>
                    </label>
                <% }) %>
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="document.getElementById('addRoleModal').style.display='none'; document.getElementById('modalOverlay').style.display='none';">Cancel</button>
            <button type="submit" class="btn-primary">Create Role</button>
        </div>
    </form>
</div>

<!-- Edit Role Modal -->
<div id="editRoleModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 10%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%; max-height: 80vh; overflow-y: auto;">
    <h3 style="margin-bottom: 1rem;">Edit Role</h3>
    <form id="editRoleForm" action="" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="editRoleName">Role Name</label>
            <input type="text" name="name" id="editRoleName" class="form-control" required>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label>Permissions</label>
            <div id="editPermissionsContainer" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                <!-- Filled via JS -->
            </div>
        </div>

        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="document.getElementById('editRoleModal').style.display='none'; document.getElementById('modalOverlay').style.display='none';">Cancel</button>
            <button type="submit" class="btn-primary">Update Role</button>
        </div>
    </form>
</div>

<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="document.getElementById('addRoleModal').style.display='none'; document.getElementById('editRoleModal').style.display='none'; this.style.display='none';"></div>

<script>
    const availablePerms = ['Dashboard', 'Students', 'Employees', 'Fees', 'Donations', 'Attendance', 'Ledgers', 'Hifz', 'Settings'];
    
    async function openEditModal(roleId, roleName) {
        document.getElementById('editRoleForm').action = '/settings/roles/edit/' + roleId;
        document.getElementById('editRoleName').value = roleName;
        
        // Fetch permissions
        const res = await fetch('/api/roles/' + roleId + '/permissions');
        const data = await res.json();
        
        const container = document.getElementById('editPermissionsContainer');
        container.innerHTML = '';
        
        if(data.success) {
            availablePerms.forEach(p => {
                const checked = data.permissions.includes(p) ? 'checked' : '';
                container.innerHTML += `
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 500;">
                        <input type="checkbox" name="permissions[]" value="${p}" ${checked}> ${p}
                    </label>
                `;
            });
        }
        
        document.getElementById('editRoleModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }
</script>

<%- include('partials/footer') %>
