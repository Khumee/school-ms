<%- include('../partials/header') %>

<div class="section-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h1 class="section-title"><i class="bi bi-journal-text"></i> Manage Subjects</h1>
</div>

<% if (locals.success) { %>
    <div style="background-color: #dcfce7; color: #166534; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #bbf7d0;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #fecaca;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
    </div>
<% } %>

<!-- Compact Add Subject Bar -->
<div class="card" style="margin-bottom: 1.25rem; padding: 0.85rem 1.25rem; background: #ffffff; border: 1px solid var(--border);">
    <form action="/subjects/add" method="POST" style="display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 180px;">
            <label for="class_id" style="font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.25rem; display: block;">Class</label>
            <select class="form-control" id="class_id" name="class_id" required style="height: 38px; padding: 0.35rem 0.65rem; font-size: 0.9rem;">
                <option value="">Select a Class</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
            </select>
        </div>
        <div style="flex: 2; min-width: 220px;">
            <label for="name" style="font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.25rem; display: block;">Subject Name</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Mathematics, English, Urdu..." required style="height: 38px; padding: 0.35rem 0.65rem; font-size: 0.9rem;">
        </div>
        <div>
            <button type="submit" class="btn-primary" style="height: 38px; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0 1.25rem; font-size: 0.9rem; font-weight: 600;">
                <i class="bi bi-plus-circle"></i> Add Subject
            </button>
        </div>
    </form>
</div>

<!-- Standard Filter Panel -->
<details class="filter-panel" open style="margin-bottom: 1.5rem;">
    <summary>
        <span><i class="bi bi-funnel-fill"></i> Filter & Search Subjects <%= (classId || search) ? '(Active)' : '' %></span>
        <i class="bi bi-chevron-down toggle-icon"></i>
    </summary>
    <form action="/subjects" method="GET" class="filter-content">
        <div class="form-group">
            <label for="classId">Filter by Class</label>
            <select name="classId" id="classId" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Classes --</option>
                <% classes.forEach(c => { %>
                    <option value="<%= c.id %>" <%= classId == c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="form-group">
            <label for="search">Search Subject Name</label>
            <input type="text" name="search" id="search" class="form-control" value="<%= search || '' %>" placeholder="e.g. Math, Urdu...">
        </div>
        
        <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
            <button type="submit" class="btn-secondary" style="height: 38px;">Search</button>
            <a href="/subjects" class="btn-secondary" style="height: 38px; display: inline-flex; align-items: center;">Reset</a>
        </div>
    </form>
</details>

<!-- Existing Subjects Table -->
<div class="card" style="padding: 0; overflow: hidden;">
    <h3 style="margin: 0; padding: 1rem 1.5rem; color: var(--primary-color); border-bottom: 1px solid var(--border); background: #f8fafc;">
        <i class="bi bi-card-list"></i> Existing Subjects
    </h3>
    <div style="overflow-x: auto;">
        <table class="table" style="width: 100%; margin: 0; border-collapse: collapse;">
            <thead style="background: #f1f5f9;">
                <tr>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Subject Name</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600;">Class</th>
                    <th style="padding: 0.75rem; border-bottom: 1px solid var(--border); text-align: left; color: var(--muted); font-weight: 600; width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (subjects.length > 0) { %>
                    <% subjects.forEach(s => { %>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 0.75rem; font-weight: 600;"><%= s.name %></td>
                            <td style="padding: 0.75rem;"><%= s.class_name %></td>
                            <td style="padding: 0.75rem;">
                                <form action="/subjects/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this subject?');" style="margin: 0;">
                                    <button type="submit" class="btn-secondary" style="color: #ef4444; border-color: #fca5a5; background: #fef2f2; padding: 0.35rem 0.75rem;">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="padding: 2rem; text-align: center; color: var(--muted);">No subjects found matching the filter criteria.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
