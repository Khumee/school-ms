<%- include('partials/header') %>

<div class="section-header">
    <h1 class="section-title"><i class="bi bi-people-fill"></i> User Accounts</h1>
    <button class="btn-primary" onclick="document.getElementById('addUserModal').style.display='block'; document.getElementById('modalOverlay').style.display='block';"><i class="bi bi-person-plus-fill"></i> Add User</button>
</div>

<% if (error) { %>
    <div style="background-color: #fee2e2; color: #b91c1c; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;"><i class="bi bi-exclamation-triangle-fill"></i> <%= error %></div>
<% } %>
<% if (success) { %>
    <div style="background-color: #dcfce7; color: #15803d; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
<% } %>

<div class="card">
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (users && users.length > 0) { %>
                    <% users.forEach(u => { %>
                        <tr>
                            <td style="font-weight: 600;"><%= u.username %></td>
                            <td><span class="status-cell" style="background-color: #f1f5f9; color: #334155; font-weight: 600;"><%= u.role_name || 'No Role' %></span></td>
                            <td><%= new Date(u.created_at).toLocaleDateString('en-GB') %></td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button class="btn-secondary nav-btn" onclick="openEditModal(<%= u.id %>, '<%= u.username %>', <%= u.role_id || 'null' %>)"><i class="bi bi-pencil"></i> Edit</button>
                                    <% if (session.userId !== u.id) { %>
                                        <form action="/settings/users/delete/<%= u.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this user? This cannot be undone.');">
                                            <button type="submit" class="btn-secondary nav-btn" style="color: #dc2626; border-color: #fca5a5;"><i class="bi bi-trash"></i> Delete</button>
                                        </form>
                                    <% } else { %>
                                        <span style="font-size: 0.8rem; color: #94a3b8; font-style: italic;">(Current Session)</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align: center; color: #64748b;">No users found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div id="addUserModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 10%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-bottom: 1rem;">Add New User</h3>
    <form action="/settings/users/add" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="username">Username</label>
            <input type="text" name="username" id="username" class="form-control" required>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" class="form-control" required>
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="role">Assign Role</label>
            <select name="role_id" id="role" class="form-control" required>
                <option value="">-- Select Role --</option>
                <% roles.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="employee">Link to Employee (Optional)</label>
            <select name="employee_id" id="employee" class="form-control">
                <option value="">-- None --</option>
                <% employees.forEach(e => { %>
                    <option value="<%= e.id %>"><%= e.name %> (<%= e.designation %>)</option>
                <% }) %>
            </select>
            <small style="color: #64748b; font-size: 0.8rem; display: block; margin-top: 0.25rem;">Linking to an employee allows the system to tie activities to them.</small>
        </div>

        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="document.getElementById('addUserModal').style.display='none'; document.getElementById('modalOverlay').style.display='none';">Cancel</button>
            <button type="submit" class="btn-primary">Create User</button>
        </div>
    </form>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" class="card" style="display: none; max-width: 500px; margin: 1rem auto; position: fixed; top: 10%; left: 50%; transform: translate(-50%, 0); z-index: 1000; box-shadow: 0 10px 25px rgba(0,0,0,0.2); box-sizing: border-box; width: 90%;">
    <h3 style="margin-bottom: 1rem;">Edit User</h3>
    <form id="editUserForm" action="" method="POST">
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="editUsername">Username</label>
            <input type="text" name="username" id="editUsername" class="form-control" required>
        </div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="editPassword">New Password (Leave blank to keep current)</label>
            <input type="password" name="password" id="editPassword" class="form-control">
        </div>

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label for="editRole">Assign Role</label>
            <select name="role_id" id="editRole" class="form-control" required>
                <option value="">-- Select Role --</option>
                <% roles.forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.name %></option>
                <% }) %>
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button type="button" class="btn-secondary" onclick="document.getElementById('editUserModal').style.display='none'; document.getElementById('modalOverlay').style.display='none';">Cancel</button>
            <button type="submit" class="btn-primary">Update User</button>
        </div>
    </form>
</div>

<div id="modalOverlay" style="display: none; position: fixed; top: 0; left: 0; width:100%; height:100%; background: rgba(0,0,0,0.4); z-index: 999;" onclick="document.getElementById('addUserModal').style.display='none'; document.getElementById('editUserModal').style.display='none'; this.style.display='none';"></div>

<script>
    function openEditModal(userId, username, roleId) {
        document.getElementById('editUserForm').action = '/settings/users/edit/' + userId;
        document.getElementById('editUsername').value = username;
        if (roleId) {
            document.getElementById('editRole').value = roleId;
        } else {
            document.getElementById('editRole').value = '';
        }
        
        document.getElementById('editUserModal').style.display = 'block';
        document.getElementById('modalOverlay').style.display = 'block';
    }
</script>

<%- include('partials/footer') %>
